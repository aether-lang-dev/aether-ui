// ui/svg.ae — an SVG FILE as a widget, drawn not decoded.
//
// The gap this closes: image(path) hands a file to the platform's image
// decoder, and none of the three decodes SVG. GTK4 might, through whatever
// pixbuf loaders happen to be installed; AppKit and Win32 will not. So an
// SVG asset was unusable, or usable only on one machine, which is worse.
//
// aether-ui already ships a complete SVG stack in vg (parser, path
// rasteriser, gradients), used by apps/svg_render_png to match rsvg-convert.
// This routes that stack into a canvas widget, so an SVG renders IDENTICALLY
// on all three backends with no platform decoder and no asset conversion
// step.
//
// This is ui/icons.ae's shape for a different input: icons draws built-in
// path DATA, this draws a file. Kept a separate module for the same reason
// icons is one, an opt-in import: an app that only wants a close glyph
// should not link the SVG parser, and an app showing SVG assets should not
// carry the icon vocabulary.
//
//   import ui.svg (svg_image)
//   hstack(8) {
//       svg_image("assets/logo.svg", 64)
//       text("drawn by vg, same pixels everywhere")
//   }
//
// Returns the canvas WIDGET handle (0 if the file cannot be read or holds no
// usable SVG), so it composes with width()/height() like any other widget.
// NB the result is a drawing, not a bitmap: image_fill and image_tint apply
// to image() widgets and have nothing to act on here. Size it at the call.

exports (svg_image, svg_image_sized)

import ui (canvas_create, canvas_widget, width, height)
import vg.svg.loader
import vg.backend.gtk
import std.fs (read)
import std.string
import std.os

// svg_image(path, size): the longer side becomes `size`, the other follows
// the SVG's own aspect ratio. Square-fitting a 2:1 drawing leaves background
// showing around it, which reads as a rendering bug rather than a framing
// choice (the same trap apps/svg_render_png documents).
svg_image(_ctx: ptr, path: string, size: int) -> int {
    svg, err = read(path)
    if string.length(err) > 0 { return 0 }
    if string.length(svg) == 0 { return 0 }

    cw = size
    ch = size
    ar = loader.svg_aspect_ratio(svg)
    if ar > 0.0 {
        if ar > 1.0 {
            ch = _f_to_i(_i_to_f(size) / ar)
        } else {
            cw = _f_to_i(_i_to_f(size) * ar)
        }
        if cw < 1 { cw = 1 }
        if ch < 1 { ch = 1 }
    }
    return svg_image_sized(_ctx, path, cw, ch)
}

// svg_image_sized(path, w, h): draw into an exactly w x h canvas, aspect
// ignored. For when the box is fixed and the caller has already decided.
svg_image_sized(_ctx: ptr, path: string, w: int, h: int) -> int {
    svg, err = read(path)
    if string.length(err) > 0 { return 0 }
    if string.length(svg) == 0 { return 0 }
    if w < 1 { return 0 }
    if h < 1 { return 0 }

    cid = canvas_create(_ctx, w, h)
    backend = gtk.gtk_backend_new(cid)
    _scene = loader.load_svg(backend, svg, _i_to_f(w), _i_to_f(h))

    wh = canvas_widget(cid)
    if wh == 0 { return 0 }
    // CRITICAL: canvases are created hexpand/vexpand TRUE, because a
    // full-window canvas should fill. A drawing with a size is the opposite
    // case: without pinning, a 120x60 badge is stretched across the whole
    // row and its aspect ratio, computed carefully just above, is thrown
    // away. ui/icons.ae hit exactly this and documents the same fix.
    _pw = width(wh, w)
    _ph = height(wh, h)
    return wh
}

_i_to_f(i: int) -> float { return i / 1.0 }
_f_to_i(f: float) -> int { return (f + 0.5) as int }
