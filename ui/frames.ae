// ui.frames — draggable/resizable internal frames drawn inside one AeVG scene.
//
// This is the Stage-0 harness for the retained compositor track: a retained
// z-ordered model that lives inside one canvas and can later become the first
// compositor workload. It intentionally uses only VG drawing and canvas pointer
// events; no native child windows are involved.

exports (
    frames, frame,
    frames_new, frame_add, frame_set_content,
    frame_invalidate, frame_surface_valid,
    frame_set_opacity, frame_opacity, frame_is_opaque,
    frame_move, frame_resize, frame_raise, frame_close,
    frame_bounds, frame_z, frame_count, frames_hit,
    frames_rerender_count, frames_blit_count,
    frames_total_rerender_count, frames_total_blit_count, frames_reset_totals,
    frames_occluded_count, frames_total_occluded_count,
    frames_dirty_area, frames_dirty_nrects, frames_dirty_rect, frames_clear_dirty,
    frames_draw, frames_on_click, frames_on_move, frames_on_release
)

import std.list
import std.string
import vg.geom.region (
    rgn_new, rgn_add_rect, rgn_sub_rect, rgn_nrects, rgn_rect, rgn_area
)
import vg (rect, path, text_sized, fill, stroke, opacity,
           scene_canvas, scene_ctx, scene_backend, scene_new, scene_set_deferred,
           vg_root, vg_flush, scene_free_recording,
           scene_add_live_region, scene_remove_live_region)
// The live-region module. Note vg.geom.region above is a DIFFERENT module
// (rectangle set algebra) imported selectively, so the bare `region.` name
// is free for this one -- the same form vg/live.ae and vg/module.ae use.
import vg.region
import ui (canvas_cmd_count, canvas_render_range_rgba)
import std.bytes

extern malloc(size: int) -> ptr
extern string_retain(s: string)

struct FrameHost {
    scene: ptr
    frames: ptr
    next_z: int
    active: ptr
    gesture: int       // 0 none, 1 drag, 2 resize
    gesture_frame: ptr
    dirty: ptr
    x: float
    y: float
    w: float
    h: float
    down_x: float
    down_y: float
    start_x: float
    start_y: float
    start_w: float
    start_h: float
    last_rerender_count: int
    last_blit_count: int
    last_occluded_count: int
    total_occluded_count: int
    total_rerender_count: int
    total_blit_count: int
}

struct Frame {
    host: ptr
    title: string
    x: float
    y: float
    w: float
    h: float
    z: int
    closed: int
    surface_valid: int
    // Stage 3: this frame's cached pixels, held in a source-less
    // LIVE_RASTER region. A region with no source "just blits its
    // once-pushed frame" every paint without re-running any content
    // callback -- which is the whole Stage 3 claim, already implemented by
    // the live path. rgn == null means not cached (or unavailable here).
    rgn: ptr
    rgn_pw: int
    rgn_ph: int
    // Body alpha. 1.0 = fully opaque, which is what makes a frame able to
    // OCCLUDE the frames beneath it -- Stage 4 cannot save anything on a
    // translucent frame, because you can see through it.
    body_alpha: float
    content: ptr       // boxed |rn, t, x, y, w, h|
}

// Declarative composition layer:
//
//   host = frames(scene, x, y, w, h) {
//       first = frame("First", fx, fy, fw, fh) callback |rn, t, x, y, w, h| {
//           // draw content into rn
//       }
//   }
//
// Returning the host makes it the context for frame() calls in the trailing
// block. The scene is explicit because frames{} may be nested in mixed UI/VG
// builder scopes where the ambient context is not necessarily a VgNode.
frames(_ctx: ptr, scene: ptr, x: float, y: float, w: float, h: float) -> ptr {
    _ = _ctx
    return frames_new(scene, x, y, w, h)
}

// A declarative child of frames{}. The callback is retained and invoked for
// each paint with the frame-local content bounds.
frame(_ctx: ptr, title: string, x: float, y: float, w: float, h: float,
      content: fn) -> ptr {
    f = frame_add(_ctx, title, x, y, w, h)
    frame_set_content(f, content)
    return f
}

frames_new(scene: ptr, x: float, y: float, w: float, h: float) -> ptr {
    hst = malloc(160) as *FrameHost
    hst.scene = scene
    hst.frames = list.new()
    hst.next_z = 0
    hst.active = null
    hst.gesture = 0
    hst.gesture_frame = null
    hst.dirty = rgn_new()
    hst.x = x
    hst.y = y
    hst.w = w
    hst.h = h
    hst.down_x = 0.0
    hst.down_y = 0.0
    hst.start_x = 0.0
    hst.start_y = 0.0
    hst.start_w = 0.0
    hst.start_h = 0.0
    hst.last_rerender_count = 0
    hst.last_blit_count = 0
    hst.last_occluded_count = 0
    hst.total_occluded_count = 0
    hst.total_rerender_count = 0
    hst.total_blit_count = 0
    return hst as ptr
}

frame_add(host: ptr, title: string, x: float, y: float, w: float, h: float) -> ptr {
    hst = host as *FrameHost
    f = malloc(128) as *Frame
    f.host = host
    f.title = title
    string_retain(f.title)
    f.x = x
    f.y = y
    f.w = _maxf(w, _min_w())
    f.h = _maxf(h, _min_h())
    f.z = hst.next_z
    hst.next_z = hst.next_z + 1
    f.closed = 0
    f.surface_valid = 0
    f.rgn = null
    f.rgn_pw = 0
    f.rgn_ph = 0
    f.body_alpha = 0.42
    f.content = null
    _ = list.add(hst.frames, f as ptr)
    hst.active = f as ptr
    _mark_frame_dirty(f)
    return f as ptr
}

frame_set_content(frame: ptr, cb: fn) {
    f = frame as *Frame
    f.content = box_closure(cb)
    frame_invalidate(frame)
}

// frame_set_opacity(frame, a) — body alpha, 0..1. A frame at 1.0 is opaque
// and can occlude what is behind it; anything less and the frames beneath
// it remain visible, so they must still be drawn.
frame_set_opacity(frame: ptr, a: float) {
    if frame == null { return }
    f = frame as *Frame
    f.body_alpha = a
    frame_invalidate(frame)
}

frame_opacity(frame: ptr) -> float {
    if frame == null { return 0.0 }
    f = frame as *Frame
    return f.body_alpha
}

// Opaque enough to hide what is behind it. Deliberately strict: anything
// below 1.0 lets some of the lower frame through, and "nearly opaque" is
// exactly the kind of almost-right that produces a visibly wrong screen
// while the counters look excellent.
frame_is_opaque(frame: ptr) -> int {
    if frame == null { return 0 }
    f = frame as *Frame
    if f.body_alpha >= 1.0 { return 1 }
    return 0
}

frame_invalidate(frame: ptr) {
    if frame == null { return }
    f = frame as *Frame
    f.surface_valid = 0
}

frame_surface_valid(frame: ptr) -> int {
    if frame == null { return 0 }
    f = frame as *Frame
    return f.surface_valid
}

frame_move(frame: ptr, x: float, y: float) {
    f = frame as *Frame
    _mark_frame_dirty(f)
    f.x = x
    f.y = y
    _mark_frame_dirty(f)
}

frame_resize(frame: ptr, w: float, h: float) {
    f = frame as *Frame
    _mark_frame_dirty(f)
    f.w = _maxf(w, _min_w())
    f.h = _maxf(h, _min_h())
    frame_invalidate(frame)
    _mark_frame_dirty(f)
}

frame_raise(frame: ptr) {
    if frame == null { return }
    f = frame as *Frame
    hst = f.host as *FrameHost
    _mark_frame_dirty(f)
    f.z = hst.next_z
    hst.next_z = hst.next_z + 1
    hst.active = frame
    _mark_frame_dirty(f)
}

frame_close(frame: ptr) {
    if frame == null { return }
    f = frame as *Frame
    _mark_frame_dirty(f)
    f.closed = 1
    hst = f.host as *FrameHost
    if hst.active == frame { hst.active = null }
}

frame_bounds(frame: ptr) -> (float, float, float, float) {
    f = frame as *Frame
    return f.x, f.y, f.w, f.h
}

frame_z(frame: ptr) -> int {
    f = frame as *Frame
    if f.closed == 1 { return 0 - 1 }
    hst = f.host as *FrameHost
    rank = 0
    n = list.size(hst.frames)
    i = 0
    while i < n {
        item, _e = list.get(hst.frames, i)
        other = item as *Frame
        if other.closed == 0 {
            if other.z < f.z { rank = rank + 1 }
        }
        i = i + 1
    }
    return rank
}

frame_count(host: ptr) -> int {
    hst = host as *FrameHost
    n = list.size(hst.frames)
    count = 0
    i = 0
    while i < n {
        item, _e = list.get(hst.frames, i)
        f = item as *Frame
        if f.closed == 0 { count = count + 1 }
        i = i + 1
    }
    return count
}

frames_rerender_count(host: ptr) -> int {
    hst = host as *FrameHost
    return hst.last_rerender_count
}

// Cumulative since start. The acceptance test sums over many paints: a
// per-paint reading cannot tell "re-renders every time" from "re-rendered
// once", which is exactly the distinction Stage 3 has to make.
// How many frames the last paint SKIPPED ENTIRELY -- neither re-rendered
// nor blitted -- because an opaque frame above covers them completely.
frames_occluded_count(host: ptr) -> int {
    hst = host as *FrameHost
    return hst.last_occluded_count
}

frames_total_occluded_count(host: ptr) -> int {
    hst = host as *FrameHost
    return hst.total_occluded_count
}

frames_total_rerender_count(host: ptr) -> int {
    hst = host as *FrameHost
    return hst.total_rerender_count
}

frames_total_blit_count(host: ptr) -> int {
    hst = host as *FrameHost
    return hst.total_blit_count
}

frames_reset_totals(host: ptr) {
    hst = host as *FrameHost
    hst.total_rerender_count = 0
    hst.total_blit_count = 0
}

frames_blit_count(host: ptr) -> int {
    hst = host as *FrameHost
    return hst.last_blit_count
}

frames_hit(host: ptr, x: float, y: float) -> ptr {
    hst = host as *FrameHost
    best = null
    best_z = 0 - 2147483647
    n = list.size(hst.frames)
    i = 0
    while i < n {
        item, _e = list.get(hst.frames, i)
        f = item as *Frame
        if f.closed == 0 {
            if _inside(f, x, y) == 1 {
                if f.z > best_z {
                    best_z = f.z
                    best = f as ptr
                }
            }
        }
        i = i + 1
    }
    return best
}

frames_dirty_area(host: ptr) -> float {
    hst = host as *FrameHost
    return rgn_area(hst.dirty)
}

frames_dirty_nrects(host: ptr) -> int {
    hst = host as *FrameHost
    return rgn_nrects(hst.dirty)
}

frames_dirty_rect(host: ptr, i: int, out4: ptr) -> int {
    hst = host as *FrameHost
    return rgn_rect(hst.dirty, i, out4)
}

frames_clear_dirty(host: ptr) {
    hst = host as *FrameHost
    rgn_sub_rect(hst.dirty, hst.x, hst.y, hst.w, hst.h)
}

extern lrint(x: float) -> long
_ceil_i(v: float) -> int {
    i = lrint(v) as int
    if i < 0 { return 0 }
    if v > (i as float) { i = i + 1 }
    return i
}

// _composite_frame — draw a frame, or let its cached region blit it.
//
// A frame whose surface is still valid is NOT drawn here at all: its
// source-less raster region blits the pixels itself, from the live path's
// own region walk, after each canvas_clear. That is the mechanism two
// earlier attempts were missing -- a blit queued as a command is freed by
// the next clear, but a region is RE-ISSUED every paint, so its pixels
// survive. See docs/design/stage3-per-frame-surfaces.md.
//
// Every failure path falls back to drawing inline, which is exactly today's
// correct behaviour. Nothing here can leave a frame unpainted.
// _is_occluded — is `bf` completely covered by a higher OPAQUE frame?
//
// Deliberately conservative. Only a single frame that covers bf entirely
// counts: two opaque frames that jointly cover it are NOT detected, because
// proving that needs real region subtraction and a wrong answer here means
// a frame silently vanishes from the screen. A missed occlusion costs a
// redraw; a false one costs correctness.
_is_occluded(hst: *FrameHost, bf: *Frame) -> int {
    n = list.size(hst.frames)
    i = 0
    while i < n {
        item, _e = list.get(hst.frames, i)
        o = item as *Frame
        if o != bf {
            if o.closed == 0 {
                if o.z > bf.z {
                    if frame_is_opaque(o as ptr) == 1 {
                        // Covers bf entirely?
                        if o.x <= bf.x {
                            if o.y <= bf.y {
                                if o.x + o.w >= bf.x + bf.w {
                                    if o.y + o.h >= bf.y + bf.h {
                                        return 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

_composite_frame(hst: *FrameHost, bf: *Frame, rn: ptr, t: float) {
    // Stage 4: a fully-covered frame is skipped outright -- no render, no
    // blit. Its cached surface (if any) is kept, so re-exposing it costs a
    // blit rather than a re-render.
    if _is_occluded(hst, bf) == 1 {
        hst.last_occluded_count = hst.last_occluded_count + 1
        hst.total_occluded_count = hst.total_occluded_count + 1
        return
    }
    if bf.surface_valid == 1 {
        if bf.rgn != null {
            // Keep the region tracking the frame: a drag moves the rect
            // WITHOUT re-rendering, since the blit scales source to dest.
            region.region_set_rect(bf.rgn, bf.x, bf.y, bf.w, bf.h)
            region.region_set_z(bf.rgn, bf.z)
            hst.last_blit_count = hst.last_blit_count + 1
            hst.total_blit_count = hst.total_blit_count + 1
            return
        }
    }

    hst.last_rerender_count = hst.last_rerender_count + 1
    hst.total_rerender_count = hst.total_rerender_count + 1

    // Mark valid BEFORE drawing so an animating content callback can
    // invalidate the next paint from inside its own draw.
    bf.surface_valid = 1

    cid = 0
    if hst.scene != null { cid = scene_canvas(hst.scene) }
    if cid == 0 { _draw_frame(bf, rn, t); return }
    iw = _ceil_i(bf.w)
    ih = _ceil_i(bf.h)
    if iw <= 0 { _draw_frame(bf, rn, t); return }
    if ih <= 0 { _draw_frame(bf, rn, t); return }
    start = canvas_cmd_count(cid)
    if start < 0 { _draw_frame(bf, rn, t); return }

    // Render this frame alone into its own sub-scene. The live path is
    // DEFERRED -- shapes are recorded and only dispatched by the flush -- so
    // a sub-scene is what gives this frame a clean, contiguous command range
    // to capture.
    sub = scene_new(scene_ctx(hst.scene), scene_backend(hst.scene))
    scene_set_deferred(sub, 1)
    _draw_frame(bf, vg_root(sub), t)
    vg_flush(sub)
    fin = canvas_cmd_count(cid)
    scene_free_recording(sub)
    if fin <= start { return }

    // Capture what it emitted into a bytes buffer -- bytes.data() hands the
    // backend a writable region, and bytes.finish turns it into the binary
    // string region_push stores.
    need = iw * ih * 4
    buf = bytes.new(need)
    got = canvas_render_range_rgba(cid, start, fin, bf.x, bf.y,
                                   iw, ih, bytes.data(buf), need)
    if got != need {
        // Capture unavailable (win32/macOS today) -- stay uncached. The
        // frame was already drawn into the canvas above, so it IS painted.
        bf.surface_valid = 0
        return
    }
    _ = bytes.set_length(buf, need)
    px = bytes.finish(buf, need)

    if bf.rgn == null {
        bf.rgn = region.live_raster_new(bf.x, bf.y, bf.w, bf.h, iw, ih)
        region.region_set_animated(bf.rgn, 0)
        scene_add_live_region(hst.scene, bf.rgn)
    }
    if bf.rgn_pw != iw {
        region.region_set_pixel_size(bf.rgn, iw, ih)
        bf.rgn_pw = iw
        bf.rgn_ph = ih
    }
    region.region_set_rect(bf.rgn, bf.x, bf.y, bf.w, bf.h)
    region.region_set_z(bf.rgn, bf.z)
    region.region_push(bf.rgn, px, need)
}

frames_draw(host: ptr, rn: ptr, t: float) {
    hst = host as *FrameHost
    hst.last_rerender_count = 0
    hst.last_blit_count = 0
    hst.last_occluded_count = 0
    n = list.size(hst.frames)
    drawn = 0
    last_z = 0 - 2147483647
    while drawn < n {
        best = null
        best_z = 2147483647
        i = 0
        while i < n {
            item, _e = list.get(hst.frames, i)
            f = item as *Frame
            if f.closed == 0 {
                if f.z > last_z {
                    if f.z < best_z {
                        best_z = f.z
                        best = f as ptr
                    }
                }
            }
            i = i + 1
        }
        if best == null { return }
        bf = best as *Frame
        _composite_frame(hst, bf, rn, t)
        last_z = best_z
        drawn = drawn + 1
    }
}

frames_on_click(host: ptr, x: float, y: float) {
    hst = host as *FrameHost
    fptr = frames_hit(host, x, y)
    hst.gesture = 0
    hst.gesture_frame = null
    if fptr == null { return }
    frame_raise(fptr)
    f = fptr as *Frame
    if _in_close(f, x, y) == 1 {
        frame_close(fptr)
        return
    }
    hst.gesture_frame = fptr
    hst.down_x = x
    hst.down_y = y
    hst.start_x = f.x
    hst.start_y = f.y
    hst.start_w = f.w
    hst.start_h = f.h
    if _in_grip(f, x, y) == 1 {
        hst.gesture = 2
        return
    }
    if y <= f.y + _title_h() {
        hst.gesture = 1
    }
}

frames_on_move(host: ptr, x: float, y: float) {
    hst = host as *FrameHost
    if hst.gesture == 0 { return }
    if hst.gesture_frame == null { return }
    f = hst.gesture_frame as *Frame
    dx = x - hst.down_x
    dy = y - hst.down_y
    if hst.gesture == 1 {
        _mark_frame_dirty(f)
        f.x = hst.start_x + dx
        f.y = hst.start_y + dy
        _mark_frame_dirty(f)
    }
    if hst.gesture == 2 {
        _mark_frame_dirty(f)
        f.w = _maxf(hst.start_w + dx, _min_w())
        f.h = _maxf(hst.start_h + dy, _min_h())
        frame_invalidate(f as ptr)
        _mark_frame_dirty(f)
    }
}

frames_on_release(host: ptr, x: float, y: float) {
    _ = x; _ = y
    hst = host as *FrameHost
    hst.gesture = 0
    hst.gesture_frame = null
}

_draw_content(cb: fn, rn: ptr, t: float, x: float, y: float, w: float, h: float) {
    cb(rn, t, x, y, w, h)
}

_draw_frame(f: *Frame, rn: ptr, t: float) {
    active = 0
    hst = f.host as *FrameHost
    if hst.active == f as ptr { active = 1 }

    shadow = rect(rn, f.x + 4.0, f.y + 5.0, f.w, f.h)
    fill(shadow, "#000000")
    // Per-element alpha keeps the shadow soft without dimming frame contents.
    opacity(shadow, 0.18)
    body = rect(rn, f.x, f.y, f.w, f.h)
    fill(body, "#f7f8fb")
    opacity(body, f.body_alpha)
    stroke(body, "#27313d", 1.0)

    title_col = "#526070"
    if active == 1 { title_col = "#2864b4" }
    bar = rect(rn, f.x, f.y, f.w, _title_h())
    fill(bar, title_col)
    opacity(bar, 0.88)
    stroke(bar, "#27313d", 1.0)
    lbl = text_sized(rn, f.x + 10.0, f.y + 18.0, 13.0, f.title)
    fill(lbl, "#ffffff")

    cbg = rect(rn, f.x + f.w - 22.0, f.y + 6.0, 14.0, 14.0)
    fill(cbg, "#eef2f7")
    opacity(cbg, 0.92)
    stroke(cbg, "#1f2937", 1.0)
    // The close glyph and gripper are simple stroked paths.
    p1 = path(rn, _line_path(f.x + f.w - 18.5, f.y + 9.5, f.x + f.w - 11.5, f.y + 16.5))
    stroke(p1, "#1f2937", 1.4)
    p2 = path(rn, _line_path(f.x + f.w - 11.5, f.y + 9.5, f.x + f.w - 18.5, f.y + 16.5))
    stroke(p2, "#1f2937", 1.4)
    g1 = path(rn, _line_path(f.x + f.w - 15.0, f.y + f.h - 5.0, f.x + f.w - 5.0, f.y + f.h - 15.0))
    stroke(g1, "#8a94a3", 1.0)
    g2 = path(rn, _line_path(f.x + f.w - 10.0, f.y + f.h - 5.0, f.x + f.w - 5.0, f.y + f.h - 10.0))
    stroke(g2, "#8a94a3", 1.0)

    if f.content != null {
        cb = unbox_closure(f.content)
        _draw_content(cb, rn, t, f.x + 8.0, f.y + _title_h() + 8.0,
                      f.w - 16.0, f.h - _title_h() - 16.0)
    }
}

_inside(f: *Frame, x: float, y: float) -> int {
    if x < f.x { return 0 }
    if y < f.y { return 0 }
    if x > f.x + f.w { return 0 }
    if y > f.y + f.h { return 0 }
    return 1
}

_in_close(f: *Frame, x: float, y: float) -> int {
    if x < f.x + f.w - 24.0 { return 0 }
    if x > f.x + f.w - 5.0 { return 0 }
    if y < f.y + 4.0 { return 0 }
    if y > f.y + 23.0 { return 0 }
    return 1
}

_in_grip(f: *Frame, x: float, y: float) -> int {
    if x < f.x + f.w - _grip() { return 0 }
    if y < f.y + f.h - _grip() { return 0 }
    return _inside(f, x, y)
}

_maxf(a: float, b: float) -> float {
    if a > b { return a }
    return b
}

_title_h() -> float { return 26.0 }
_grip() -> float { return 16.0 }
_min_w() -> float { return 80.0 }
_min_h() -> float { return 60.0 }

_mark_frame_dirty(f: *Frame) {
    if f == null { return }
    hst = f.host as *FrameHost
    // Include the antialiased border and the shadow at (+4,+5). Without
    // this overdraw margin a clipped move leaves a one-pixel trace at the
    // old edge — visible as a ghost outline while dragging.
    rgn_add_rect(hst.dirty, f.x - 1.0, f.y - 1.0, f.w + 6.0, f.h + 7.0)
}

_line_path(x0: float, y0: float, x1: float, y1: float) -> string {
    s = "M "
    s = string.concat(s, string.from_float(x0))
    s = string.concat(s, " ")
    s = string.concat(s, string.from_float(y0))
    s = string.concat(s, " L ")
    s = string.concat(s, string.from_float(x1))
    s = string.concat(s, " ")
    s = string.concat(s, string.from_float(y1))
    return s
}
