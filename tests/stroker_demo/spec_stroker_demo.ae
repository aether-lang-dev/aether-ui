// spec_stroker_demo.ae — the geometric stroker, driven over AetherUIDriver.
//
// Three claims, in rising order of strength:
//   1. structure — the four demo canvases and their chrome exist;
//   2. PIXELS — the app samples its native-stroked canvas and its
//      pp_stroke-outline canvas on a grid (ui.canvas_read_pixel replays the
//      command buffers headlessly) and the two renderings AGREE. The spec
//      drives the comparison and asserts the agreement percentage — a
//      real pixel-equivalence gate between backend stroking and stroke-as-
//      geometry, run on every platform the matrix reaches;
//   3. capability — the stroke OUTLINE is a hit region: clicking ON the
//      fat line fires its handler, clicking beside it does not. Native
//      strokes cannot express this at all.
//
// Run via tests/spec_matrix.sh stroker, or by hand:
//   AETHER_UI_TEST_PORT=9222 \
//     ./target/build/examples/stroker_demo/bin/stroker_demo &
//   UI_SPEC=stroker_demo/spec_stroker_demo tests/run_spec.sh
import aeocha
import uidriver
import std.string

extern string_substring(s: string, start: int, end: int) -> string

main() {
    fw = aeocha.init()
    uidriver.wait_server()

    aeocha.describe(fw, "stroker_demo over AetherUIDriver") {
        aeocha.it("shows four canvases and the comparison chrome") callback {
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "\"canvas\"", "canvases present")
            aeocha.assert_contains(body, "pixels: not compared yet",
                "comparison label starts idle")
            aeocha.assert_contains(body, "hits: 0", "hit counter starts at 0")
        }

        aeocha.it("geometric outline rasterises like the native stroke") callback {
            b = uidriver.widget_id_of("button", "Compare pixels")
            aeocha.assert_gt(b, 0, "compare button")
            uidriver.click_widget(b)
            ok = uidriver.wait_body_contains("/widgets", "agree (", 30)
            aeocha.assert_true(ok, "comparison ran")
            body = uidriver.get_body("/widgets")
            pct = parse_after(body, "agree (")
            // The two renderers should disagree only in the sub-pixel AA
            // band along edges; on a 4px sample grid that is a few percent
            // at most. Well under this gate = the stroker's geometry is
            // wrong; at it = pixel-equivalent where both can express the
            // stroke.
            aeocha.assert_true(pct >= 95, "agreement >= 95% (got ${pct}%)")
            ia = parse_after(body, "inkA=")
            ib = parse_after(body, "inkB=")
            aeocha.assert_true(ia > 100, "native stroke drew real ink (${ia})")
            aeocha.assert_true(ib > 100, "outline fill drew real ink (${ib})")
            diff = ia - ib
            if diff < 0 { diff = 0 - diff }
            aeocha.assert_true(diff * 5 <= ia,
                "ink coverage within 20% (native ${ia} vs outline ${ib})")
        }

        aeocha.it("clicking ON the fat stroke fires its handler") callback {
            // Canvas 3 is the hit-test canvas; (120,70) is the midpoint of
            // the stroked line (30,30)->(210,110) — inside the outline.
            uidriver.post_ok("/canvas/3/click?x=120&y=70", "click on stroke")
            aeocha.assert_true(
                uidriver.wait_body_contains("/widgets", "hits: 1", 20),
                "outline hit-test fired")
        }

        aeocha.it("clicking BESIDE the stroke does not fire") callback {
            // (120,20) is ~46px from the centreline — far outside the 12px
            // half-width plus round caps.
            uidriver.post_ok("/canvas/3/click?x=120&y=20", "click beside stroke")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "hits: 1", "counter unchanged")
            aeocha.assert_false(string.contains(body, "hits: 2"),
                "no phantom hit")
        }
    }
    aeocha.run_summary(fw)
}

// First integer right after `key` in body; -1 if absent.
parse_after(body: string, key: string) -> int {
    at = string.string_index_of_from(body, key, 0)
    if at < 0 { return 0 - 1 }
    at = at + string.length(key)
    n = 0
    seen = 0
    len = string.length(body)
    while at < len {
        c = string_char_at(body, at)
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
            seen = 1
        } else {
            if seen == 1 { return n }
            return 0 - 1
        }
        at = at + 1
    }
    return n
}
extern string_char_at(s: string, index: int) -> int
