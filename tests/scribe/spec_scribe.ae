// spec_scribe.ae — the word-as-widget markdown editor, driven end-to-end
// over AetherUIDriver.
//
// Claims, in rising order of strength:
//   1. structure — the editor's chrome exists and an empty doc holds one
//      empty paragraph (the caret's home);
//   2. editing — typed keys build the live word, space commits it, Enter
//      splits blocks, BackSpace LIFTS the previous word back into the
//      buffer (word-grained editing round-trips through the keyboard);
//   3. pointing — clicking a canvas coordinate selects the WORD there
//      (its box is its hit region), and restyling acts on that word;
//   4. markdown — the model serializes the edits back out (**bold**
//      markers included), read straight off the driver;
//   5. PIXELS — the probe counts PAGE-DARK samples (immune to white-
//      ground replay leaks), and making the title bold REMOVES dark
//      ground: the stroker's thickened outlines are real pixels, not
//      flags (floor + anti-flood bounds per the vg3d lesson).
//
// Run via tests/spec_matrix.sh scribe, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/apps/scribe/bin/scribe &
//   UI_SPEC=scribe/spec_scribe tests/run_spec.sh
import aeocha
import uidriver
import std.string

extern string_char_at(s: string, index: int) -> int

main() {
    fw = aeocha.init()
    uidriver.wait_server()

    aeocha.describe(fw, "scribe over AetherUIDriver") {
        aeocha.it("opens on an empty document with the caret at home") callback {
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "blocks: 1 words: 0",
                "one empty paragraph")
            aeocha.assert_contains(body, "caret: 0/0", "caret at 0/0")
            aeocha.assert_contains(body, "\"canvas\"", "the page canvas exists")
        }

        aeocha.it("typing builds the live word; space commits it") callback {
            uidriver.key("h")
            uidriver.key("i")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "buf: [hi]", "live word grows")
            aeocha.assert_contains(body, "words: 0", "not yet committed")
            uidriver.key("space")
            body2 = uidriver.get_body("/widgets")
            aeocha.assert_contains(body2, "words: 1", "space commits")
            aeocha.assert_contains(body2, "buf: []", "buffer empty again")
            aeocha.assert_contains(body2, "caret: 0/1", "caret after the word")
        }

        aeocha.it("Enter splits the block; BackSpace merges it back") callback {
            uidriver.key("Return")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "blocks: 2", "split made a block")
            aeocha.assert_contains(body, "caret: 1/0", "caret in the new block")
            uidriver.key("BackSpace")
            body2 = uidriver.get_body("/widgets")
            aeocha.assert_contains(body2, "blocks: 1", "merge rejoined")
            aeocha.assert_contains(body2, "caret: 0/1", "caret at the junction")
        }

        aeocha.it("BackSpace lifts the previous word into the buffer") callback {
            uidriver.key("BackSpace")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "buf: [hi]", "word lifted, editable")
            aeocha.assert_contains(body, "words: 0", "and out of the model")
            // Re-type the tail and commit a DIFFERENT word: hi → hip.
            uidriver.key("p")
            uidriver.key("space")
            body2 = uidriver.get_body("/widgets")
            aeocha.assert_contains(body2, "words: 1", "recommitted")
            aeocha.assert_contains(body2, "buf: []", "buffer clear")
        }

        aeocha.it("clicking a word selects it; Bold restyles that word") callback {
            b = uidriver.widget_id_of("button", "Sample")
            aeocha.assert_gt(b, 0, "sample button")
            uidriver.click_widget(b)
            ok = uidriver.wait_body_contains("/widgets", "blocks: 6", 20)
            aeocha.assert_true(ok, "sample document loaded")
            // (30, 30) is inside the H1 word "Scribe" (first word, first
            // line) at every backend — the layout is pure Aether and
            // byte-identical, so the coordinate is a contract.
            uidriver.post_ok("/canvas/1/click?x=30&y=30", "click on the title")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "sel: 0/0", "title word selected")
            bb = uidriver.widget_id_of("button", "B")
            uidriver.click_widget(bb)
            srcb = uidriver.widget_id_of("button", "Source")
            uidriver.click_widget(srcb)
            ok2 = uidriver.wait_body_contains("/widgets", "# **Scribe**", 20)
            aeocha.assert_true(ok2, "markdown records the bold word")
        }

        aeocha.it("bold is real ink: it eats the dark page") callback {
            // The title is now bold (previous it). The probe counts PAGE-
            // DARK samples (immune to any white-ground replay leak, which
            // near-white glyph ink is not). Bold thickens glyphs, so the
            // bold page holds FEWER dark samples than the plain page.
            // Driver actions are queued to the main loop (g_idle_add): the
            // POST returns before the click RUNS, so every read below
            // waits for an observable state change instead of trusting
            // immediacy. And the probe must compare LIKE WITH LIKE: the
            // selection highlight plate is itself non-dark and swallows
            // ~200 samples — the first cut probed bold-selected against
            // plain-selected and measured the PLATE, not the bold.
            // Escape deselects before each probe so the lever is bold
            // alone.
            pb = uidriver.widget_id_of("button", "Probe")
            aeocha.assert_gt(pb, 0, "probe button")
            uidriver.key("Escape")
            ok0 = uidriver.wait_body_contains("/widgets", "sel: none", 20)
            aeocha.assert_true(ok0, "deselected before the bold probe")
            uidriver.click_widget(pb)
            okp1 = uidriver.wait_body_contains("/widgets", "dark: 1", 20)
            aeocha.assert_true(okp1, "first probe published")
            body = uidriver.get_body("/widgets")
            bold_dark = parse_after(body, "dark: ")
            aeocha.assert_true(bold_dark > 4000,
                "the page reads as mostly dark ground (${bold_dark})")
            aeocha.assert_true(bold_dark < 14900,
                "but not ALL dark — words exist (${bold_dark} of ~15k)")
            uidriver.post_ok("/canvas/1/click?x=30&y=30", "reselect the title")
            bb = uidriver.widget_id_of("button", "B")
            uidriver.click_widget(bb)
            srcb = uidriver.widget_id_of("button", "Source")
            uidriver.click_widget(srcb)
            // "# Scribe" (no **) only appears once the un-bold has RUN.
            okp2 = uidriver.wait_body_contains("/widgets", "# Scribe", 20)
            aeocha.assert_true(okp2, "title back to plain in the markdown")
            uidriver.key("Escape")
            ok1 = uidriver.wait_body_contains("/widgets", "sel: none", 20)
            aeocha.assert_true(ok1, "deselected before the plain probe")
            uidriver.click_widget(pb)
            // Poll until the dark count MOVES off the bold reading.
            plain_dark = bold_dark
            tries = 0
            while plain_dark == bold_dark && tries < 40 {
                body2 = uidriver.get_body("/widgets")
                plain_dark = parse_after(body2, "dark: ")
                tries = tries + 1
            }
            aeocha.assert_true(plain_dark > 4000, "plain page still dark ground")
            aeocha.assert_true(plain_dark > bold_dark,
                "bold glyphs eat dark ground (plain ${plain_dark} vs bold ${bold_dark})")
        }

        aeocha.it("block commands retype the caret's block") callback {
            // Selection still on the title; H3 retypes block 0.
            uidriver.post_ok("/canvas/1/click?x=30&y=30", "reselect the title")
            h3 = uidriver.widget_id_of("button", "H3")
            uidriver.click_widget(h3)
            srcb = uidriver.widget_id_of("button", "Source")
            uidriver.click_widget(srcb)
            ok = uidriver.wait_body_contains("/widgets", "### Scribe", 20)
            aeocha.assert_true(ok, "H1 became H3 in the markdown")
        }
    }
    aeocha.run_summary(fw)
}

// First integer right after `key` in body; -1 if absent.
parse_after(body: string, key: string) -> int {
    at = string.string_index_of_from(body, key, 0)
    if at < 0 { return 0 - 1 }
    at = at + string.length(key)
    n = 0
    seen = 0
    len = string.length(body)
    while at < len {
        c = string_char_at(body, at)
        if c >= 48 && c <= 57 {
            n = n * 10 + (c - 48)
            seen = 1
        } else {
            if seen == 1 { return n }
            return 0 - 1
        }
        at = at + 1
    }
    return n
}
