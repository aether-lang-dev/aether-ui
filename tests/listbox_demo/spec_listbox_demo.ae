// spec_listbox_demo.ae — drives the listbox example over the AetherUIDriver.
// Proves item 4 D1: rows render as REAL widgets, clicking a ROW (a plain
// container — the driver's click action falls back to gesture handlers)
// selects it (.aui-row-selected appears in that row's "classes"), on_select
// fires, programmatic listbox_select takes the same path, selection resets on
// update, and a 200-row update stays driver-visible (the /widgets buffer
// scales with widget count).
//
// Run via ci.sh Phase 5f, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/listbox_demo/bin/listbox_demo &
//   UI_SPEC=listbox_demo/spec_listbox_demo tests/run_spec.sh
import std.spec
import uidriver
import std.string
import std.json

// The row hstack that CONTAINS the label `txt` — found by locating the label,
// then reading its parent (rows themselves have no text of their own).
row_of(txt: string) -> int {
    lbl = uidriver.widget_id_by_text(txt)
    if lbl == 0 { return 0 }
    return uidriver.widget_int_field_by_id(lbl, "parent")
}

// The row handle currently carrying the selection class, or 0. Label-free on
// purpose: by the time the keyboard cases run, earlier cases have replaced the
// list contents, so asserting against a fixed row label would be asserting
// which fixture happens to be loaded rather than what the keys did.
selected_row() -> int {
    b = uidriver.get_body("/widgets")
    v, _jerr = json.parse(b)
    if v == null { return 0 }
    n = json.json_array_size(v)
    i = 0
    found = 0
    while i < n {
        w = json.json_array_get_raw(v, i)
        if w != null {
            c = uidriver.field_str(w, "classes")
            if string.contains(c, "aui-row-selected") == 1 {
                found = uidriver.field_int(w, "id")
                i = n
            }
        }
        i = i + 1
    }
    json.json_free(v)
    return found
}

row_classes(txt: string) -> string {
    r = row_of(txt)
    if r == 0 { return "" }
    body = uidriver.get_body("/widget/${r}")
    v, _jerr = json.parse(body)
    if v == null { return "" }
    c = uidriver.field_str(v, "classes")
    json.json_free(v)
    return c
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "listbox over AetherUIDriver") {
        spec.it("Add x3 renders three rows") callback {
            a = uidriver.widget_id_by_text("Add")
            spec.assert_gt(a, 0, "Add button found")
            uidriver.post_ok("/widget/${a}/click", "add 1")
            uidriver.post_ok("/widget/${a}/click", "add 2")
            uidriver.post_ok("/widget/${a}/click", "add 3")
            ok = uidriver.wait_body_contains("/widgets", "person 3", 20)
            spec.assert_true(ok, "person 3 rendered")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "rows: 3", "counter reads 3")
            spec.assert_contains(b, "21 KB", "template renders the second cell")
        }

        spec.it("clicking a ROW selects it (classes + on_select)") callback {
            r = row_of("person 2")
            spec.assert_gt(r, 0, "row container of person 2 found")
            uidriver.post_ok("/widget/${r}/click", "click row 2")
            ok = uidriver.wait_body_contains("/widgets", "selected index 1", 20)
            spec.assert_true(ok, "on_select fired with index 1")
            c = row_classes("person 2")
            spec.assert_contains(c, "aui-row-selected", "row 2 carries the selection class")
        }

        spec.it("selecting another row moves the class") callback {
            r3 = row_of("person 3")
            uidriver.post_ok("/widget/${r3}/click", "click row 3")
            ok = uidriver.wait_body_contains("/widgets", "selected index 2", 20)
            spec.assert_true(ok, "on_select fired with index 2")
            c2 = row_classes("person 2")
            c3 = row_classes("person 3")
            spec.assert_contains(c3, "aui-row-selected", "row 3 now selected")
            found = string.contains(c2, "aui-row-selected")
            spec.assert_eq(found, 0, "row 2 deselected")
        }

        spec.it("programmatic listbox_select takes the same path") callback {
            s2 = uidriver.widget_id_by_text("Select #2")
            uidriver.post_ok("/widget/${s2}/click", "programmatic select")
            ok = uidriver.wait_body_contains("/widgets", "selected index 1", 20)
            spec.assert_true(ok, "on_select fired with index 1")
            c = row_classes("person 2")
            spec.assert_contains(c, "aui-row-selected", "class follows programmatic select")
        }

        spec.it("update resets selection (clear+rebuild, no identity)") callback {
            rm = uidriver.widget_id_by_text("Remove last")
            uidriver.post_ok("/widget/${rm}/click", "remove")
            ok = uidriver.wait_body_contains("/widgets", "rows: 2", 20)
            spec.assert_true(ok, "two rows remain")
            b = uidriver.get_body("/widgets")
            found = string.contains(b, "aui-row-selected")
            spec.assert_eq(found, 0, "no row carries the selection class after update")
        }

        spec.it("200-row update stays driver-visible") callback {
            big = uidriver.widget_id_by_text("Add 200")
            uidriver.post_ok("/widget/${big}/click", "add 200")
            ok = uidriver.wait_body_contains("/widgets", "rows: 202", 30)
            spec.assert_true(ok, "counter reads 202")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "person 203", "last person present in /widgets")
        }

        // Keyboard navigation. A listbox carried the `listitem` a11y role but
        // had no key handling and no focusable rows, so assistive tech was told
        // "this is a list" about something unreachable without a mouse. Rows
        // are focusable now and the listbox owns one key handler.
        //
        // Selection moves through the SAME path a click takes, so these read
        // the very .aui-row-selected class the click cases above assert -- one
        // selection path, not two that can disagree.
        spec.it("Down moves the selection to the next row") callback {
            r1 = row_of("person 1")
            uidriver.post_ok("/widget/${r1}/click", "click row 1")
            spec.assert_contains(row_classes("person 1"), "aui-row-selected",
                                 "row 1 selected to start from")
            uidriver.window_key("Down")
            spec.assert_contains(row_classes("person 2"), "aui-row-selected",
                                 "Down selected row 2")
            spec.assert_true(string.contains(row_classes("person 1"),
                                             "aui-row-selected") == 0,
                             "and row 1 released it")
        }

        spec.it("Up moves it back") callback {
            uidriver.window_key("Up")
            spec.assert_contains(row_classes("person 1"), "aui-row-selected",
                                 "Up returned to row 1")
        }

        // Clamped, not wrapped: a list that jumps from the last row back to the
        // first on Down is what every platform list deliberately avoids.
        spec.it("Home/End jump to the ends, and do not wrap past them") callback {
            uidriver.window_key("End")
            last = selected_row()
            spec.assert_gt(last, 0, "End selected a row")
            uidriver.window_key("Down")
            spec.assert_eq(selected_row(), last,
                           "Down at the end stays put rather than wrapping")

            uidriver.window_key("Home")
            first = selected_row()
            spec.assert_gt(first, 0, "Home selected a row")
            spec.assert_true(first != last, "Home and End are different rows")
            uidriver.window_key("Up")
            spec.assert_eq(selected_row(), first, "Up at the start stays put")
        }
    }
    spec.run_summary(fw)
}
