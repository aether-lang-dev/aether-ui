// tree_selection — headless UI-logic test, built as its own cached aeb node.
import bldr
import aether
import aether (source, output, no_closure_regen)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("tree_selection.ae")
            output("tree_selection")
            no_closure_regen()
            ui_backend(root)
        }
        return 0
    }
}
