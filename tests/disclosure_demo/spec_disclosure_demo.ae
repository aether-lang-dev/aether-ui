// spec_disclosure_demo.ae — collapsible sections really reclaim their space.
//
// The claim worth testing is not "a flag flipped" but "the layout changed":
// a collapsed body reports visible=false AND h=0, so the rows beneath it
// rise. Both are readable from /widgets, which makes this assertable
// without pixel-diffing.
//
// Run via ci.sh Phase 5 / tests/spec_matrix.sh, or by hand:
//   AETHER_UI_TEST_PORT=9222 \
//     ./target/build/examples/disclosure_demo/bin/disclosure_demo &
//   UI_SPEC=disclosure_demo/spec_disclosure_demo tests/run_spec.sh
import std.spec
import uidriver
import std.string

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "disclosure_demo over AetherUIDriver") {
        spec.it("headers show their state") callback {
            // "v" open, ">" collapsed — the affordance is in the label, so
            // it reads identically on every backend.
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "v Filters", "Filters starts open")
            spec.assert_contains(body, "> Metrics", "Metrics starts collapsed")
            spec.assert_contains(body, "> Sort", "Sort starts collapsed")
        }

        spec.it("a collapsed body is hidden AND takes no space") callback {
            // The whole point: not just a flag, but reclaimed layout.
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "\"visible\":false", "a body is hidden")
            spec.assert_true(hidden_has_zero_height(body),
                "hidden bodies report h=0")
        }

        spec.it("clicking a header expands its section") callback {
            m = uidriver.widget_id_of("button", "> Metrics")
            spec.assert_gt(m, 0, "collapsed Metrics header")
            uidriver.click_widget(m)
            spec.assert_true(
                uidriver.wait_body_contains("/widgets", "v Metrics", 20),
                "header flipped to open")
        }

        spec.it("clicking again collapses it") callback {
            m = uidriver.widget_id_of("button", "v Metrics")
            spec.assert_gt(m, 0, "open Metrics header")
            uidriver.click_widget(m)
            spec.assert_true(
                uidriver.wait_body_contains("/widgets", "> Metrics", 20),
                "header flipped back to collapsed")
        }

        spec.it("Expand all / Collapse all drive every section") callback {
            uidriver.click_widget(uidriver.widget_id_of("button", "Expand all"))
            spec.assert_true(
                uidriver.wait_body_contains("/widgets", "v Sort", 20),
                "Sort expanded with the rest")
            b1 = uidriver.get_body("/widgets")
            spec.assert_false(string.contains(b1, "> Filters"),
                "nothing left collapsed")

            uidriver.click_widget(uidriver.widget_id_of("button", "Collapse all"))
            spec.assert_true(
                uidriver.wait_body_contains("/widgets", "> Filters", 20),
                "everything collapsed again")
            b2 = uidriver.get_body("/widgets")
            spec.assert_false(string.contains(b2, "v Metrics"),
                "no section still open")
        }
    }
    return spec.run_summary(fw)
}

// Does at least one widget report BOTH visible:false and h:0? Scans each
// widget record (records are comma-brace separated in the array).
hidden_has_zero_height(body: string) -> int {
    at = 0
    while at >= 0 {
        at = string.string_index_of_from(body, "\"visible\":false", at)
        if at < 0 { return 0 }
        // the record continues to the next '}' — look for "h":0 within it
        en = string.string_index_of_from(body, "}", at)
        if en < 0 { return 0 }
        rec = string.string_substring(body, at, en)
        if string.contains(rec, "\"h\":0") == 1 { return 1 }
        at = en
    }
    return 0
}
