// spec_golden_gallery.ae — golden-image regression, driven over the
// AetherUIDriver.
//
// The gallery renders four deterministic vg scenes (primitives, the
// geometric stroker, type-as-paths, a fixed-pose vg3d cube), reduces each
// canvas to a per-cell signature through the SAME replay path the
// platform paints with, and compares against the checked-in golden at
// tests/goldens/<backend>/. This spec drives the check and asserts the
// verdict — so every matrix run on every platform re-proves the pixels
// against a blessed reference, and a rendering regression fails with the
// canvas name and its failing cell count in the message.
//
// Blessing a NEW reference (after an intentional visual change, or on a
// backend's first run): GOLDEN_UPDATE=1 <the app>, click Check, commit
// the tests/goldens/<backend>/*.sig diff. The negative case is covered
// by construction: corrupting a golden turns the verdict to
// "<name> FAIL(n cells) … DIVERGED" (verified when the gate was built).
//
// Run via tests/spec_matrix.sh golden, or by hand:
//   AETHER_UI_TEST_PORT=9222 \
//     ./target/build/examples/golden_gallery/bin/golden_gallery &
//   UI_SPEC=golden_gallery/spec_golden_gallery tests/run_spec.sh
import std.spec
import uidriver
import std.string

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "golden gallery over AetherUIDriver") {
        spec.it("shows the gallery unchecked") callback {
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "golden: unchecked", "starts unchecked")
            spec.assert_contains(body, "\"canvas\"", "canvases present")
        }

        // GEOMETRY, before pixels. The gallery pins each canvas to
        // GG_W x GG_H (240x160) with ui.width/height, and a pin means "this
        // is exactly my size" — GTK4 documents that rule in
        // aether_ui_set_width and every backend owes it.
        //
        // WHY THIS EXISTS: win32 ignored the pin and stretched these
        // canvases to 275x187. The signature is sampled in CANVAS
        // coordinates, so the pixel check stayed green against references
        // blessed at the stretched size — a backend could disagree with the
        // others about layout indefinitely and this suite would not notice.
        // That is what let the divergence sit until an unrelated layout fix
        // surfaced it. Assert the size the app ASKED for, on every backend.
        spec.it("each canvas is laid out at the size it was pinned to") callback {
            body = uidriver.get_body("/widgets")
            n240 = uidriver.count_occurrences(body, "\"w\":240,\"h\":160")
            spec.assert_eq(n240, 4,
                "all four canvases are 240x160 — a pin is not a suggestion")
        }

        spec.it("every canvas matches its blessed golden") callback {
            b = uidriver.widget_id_of("button", "Check")
            spec.assert_gt(b, 0, "check button")
            uidriver.click_widget(b)
            ok = uidriver.wait_body_contains("/widgets", "golden: ", 30)
            spec.assert_true(ok, "check ran")
            body = uidriver.get_body("/widgets")
            spec.assert_false(string.contains(body, "NO-GOLDEN"),
                "goldens exist for this backend (bless with GOLDEN_UPDATE=1)")
            spec.assert_false(string.contains(body, "MALFORMED"),
                "goldens parse")
            spec.assert_false(string.contains(body, "FAIL("),
                "no canvas diverged from its golden")
            spec.assert_contains(body, "ALL-GREEN",
                "all four canvases match their goldens")
        }
    }
    spec.run_summary(fw)
}
