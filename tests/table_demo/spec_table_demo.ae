// spec_table_demo.ae — drives the table example over the AetherUIDriver.
// Proves item 4 D2: header buttons fire on_sort with the RIGHT column index
// (per-header closure over the loop counter), the app-side re-sort + update
// re-renders rows in the new order (asserted via text positions in /widgets,
// which lists widgets in creation order), cells render per column, and row
// selection delegates to the listbox layer.
//
// Data: carol 30 / alice 90 / bob 95 — name-asc (alice,bob,carol) differs
// from size-desc (bob,alice,carol), so the two sorts are distinguishable.
import std.spec
import uidriver
import std.json
import std.string

// 1 if a appears before b in the current /widgets body.
before(a: string, b: string) -> int {
    body = uidriver.get_body("/widgets")
    ia = string.index_of(body, a)
    ib = string.index_of(body, b)
    if ia < 0 { return 0 }
    if ib < 0 { return 0 }
    if ia < ib { return 1 }
    return 0
}

// The first widget carrying an a11y role, and the row currently holding the
// selection class. Both read /widgets rather than a label, so they keep
// working whatever the fixture contains.
first_role_widget(role: string) -> int {
    b = uidriver.get_body("/widgets")
    v, _je = json.parse(b)
    if v == null { return 0 }
    n = json.json_array_size(v)
    i = 0
    found = 0
    while i < n {
        w = json.json_array_get_raw(v, i)
        if w != null {
            if string.equals(uidriver.field_str(w, "role"), role) == 1 {
                found = uidriver.field_int(w, "id")
                i = n
            }
        }
        i = i + 1
    }
    json.json_free(v)
    return found
}

selected_row_id() -> int {
    b = uidriver.get_body("/widgets")
    v, _je2 = json.parse(b)
    if v == null { return 0 }
    n = json.json_array_size(v)
    i = 0
    found = 0
    while i < n {
        w = json.json_array_get_raw(v, i)
        if w != null {
            if string.contains(uidriver.field_str(w, "classes"), "aui-row-selected") == 1 {
                found = uidriver.field_int(w, "id")
                i = n
            }
        }
        i = i + 1
    }
    json.json_free(v)
    return found
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "table over AetherUIDriver") {
        spec.it("renders cells per column") callback {
            ok = uidriver.wait_body_contains("/widgets", "95 KB", 20)
            spec.assert_true(ok, "size cell rendered")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "carol", "name cell rendered")
            spec.assert_contains(b, "\"text\":\"Name\"", "header button Name")
            spec.assert_contains(b, "\"text\":\"Size\"", "header button Size")
        }

        spec.it("Name header sorts ascending (col 0)") callback {
            h = uidriver.widget_id_by_text("Name")
            uidriver.post_ok("/widget/${h}/click", "sort by name")
            ok = uidriver.wait_body_contains("/widgets", "sorted by col 0", 20)
            spec.assert_true(ok, "on_sort fired with col 0")
            spec.assert_true(before("alice", "bob"), "alice before bob")
            spec.assert_true(before("bob", "carol"), "bob before carol")
        }

        spec.it("Size header sorts descending (col 1)") callback {
            h = uidriver.widget_id_by_text("Size")
            uidriver.post_ok("/widget/${h}/click", "sort by size")
            ok = uidriver.wait_body_contains("/widgets", "sorted by col 1", 20)
            spec.assert_true(ok, "on_sort fired with col 1 (per-header closure index)")
            spec.assert_true(before("bob", "alice"), "bob (95) before alice (90)")
            spec.assert_true(before("alice", "carol"), "alice before carol (30)")
        }

        // ── the built-in sorter (TableRowSorter) ───────────────────────
        // The LOWER table owns its ordering. Its rows are zoe/yan/xu/wu --
        // deliberately distinct from the upper table's names, so `before`
        // reads unambiguously even though both tables share one /widgets
        // listing and re-rendering moves a table's cells to the end of it.
        spec.it("sorter: first click on a column sorts ascending") callback {
            h = uidriver.widget_id_by_text("SSize")
            uidriver.post_ok("/widget/${h}/click", "sort by size")
            ok = uidriver.wait_body_contains("/widgets", "sorted: col 1 asc", 20)
            spec.assert_true(ok, "sorter reports col 1 ascending")
            spec.assert_true(before("zoe", "yan"), "zoe (30) first")
            spec.assert_true(before("yan", "xu"), "yan (90) then xu (95)")
        }

        // THE POINT OF THE NUMERIC BRANCH: as strings "100" sorts BEFORE
        // "95", so a naive cell-text sort puts wu second. Numerically
        // 95 < 100 and wu is last. This is what fails if the sorter ever
        // loses its number detection.
        spec.it("sorter: numeric columns sort numerically, not as text") callback {
            spec.assert_true(before("xu", "wu"),
                "xu (95) before wu (100) -- a string sort would invert this")
            spec.assert_true(before("yan", "wu"), "yan (90) before wu (100)")
        }

        spec.it("sorter: clicking the same column toggles direction") callback {
            h = uidriver.widget_id_by_text("SSize")
            uidriver.post_ok("/widget/${h}/click", "toggle to descending")
            ok = uidriver.wait_body_contains("/widgets", "sorted: col 1 desc", 20)
            spec.assert_true(ok, "sorter reports col 1 descending")
            spec.assert_true(before("wu", "xu"), "wu (100) first now")
            spec.assert_true(before("yan", "zoe"), "zoe (30) last")
        }

        // Switching columns restarts ascending rather than inheriting the
        // previous direction -- Swing's behaviour, and what a user expects.
        spec.it("sorter: switching columns restarts ascending") callback {
            h = uidriver.widget_id_by_text("SName")
            uidriver.post_ok("/widget/${h}/click", "sort by name")
            ok = uidriver.wait_body_contains("/widgets", "sorted: col 0 asc", 20)
            spec.assert_true(ok, "col 0 ascending, not inheriting desc")
            spec.assert_true(before("wu", "xu"), "wu before xu alphabetically")
            spec.assert_true(before("yan", "zoe"), "yan before zoe")
        }

        spec.it("row selection delegates to the listbox layer") callback {
            lbl = uidriver.widget_id_by_text("alice")
            r = uidriver.widget_int_field_by_id(lbl, "parent")
            uidriver.post_ok("/widget/${r}/click", "click alice row")
            ok = uidriver.wait_body_contains("/widgets", "selected row 1", 20)
            spec.assert_true(ok, "on_select fired with row index 1")
        }

        // ── RowFilter (the other half of TableRowSorter) ───────────────
        // Model order at this point: the "switching columns" spec left the
        // lower table name-ascending — wu, xu, yan, zoe. The filter specs
        // depend on that (zoe is model row 3), which is exactly what makes
        // the view→model bridge assertable.
        spec.it("filter: typing narrows the view to matching rows") callback {
            tf = uidriver.widget_id_of("textfield", "")
            spec.assert_gt(tf, 0, "filter textfield found")
            uidriver.post_ok("/widget/${tf}/set_text?v=u", "type u")
            ok = uidriver.wait_body_contains("/widgets", "showing 2 of 4", 20)
            spec.assert_true(ok, "count reports the VIEW (2), not the model (4)")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "wu", "wu matches")
            spec.assert_contains(b, "xu", "xu matches")
            nz = string.contains(b, "zoe")
            spec.assert_eq(nz, 0, "zoe filtered out of the rendered rows")
            ny = string.contains(b, "yan")
            spec.assert_eq(ny, 0, "yan filtered out too")
        }

        spec.it("filter: matching is case-insensitive") callback {
            tf = uidriver.widget_id_of("textfield", "")
            uidriver.post_ok("/widget/${tf}/set_text?v=ZO", "type ZO uppercase")
            ok = uidriver.wait_body_contains("/widgets", "showing 1 of 4", 20)
            spec.assert_true(ok, "one row survives")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "zoe", "ZO matched zoe")
            nx = string.contains(b, "xu")
            spec.assert_eq(nx, 0, "xu gone")
        }

        // THE POINT OF table_item_at: visible row 0 is zoe, but zoe is MODEL
        // row 3 (name-asc put wu first). If selection indexed the model this
        // reports "picked wu"; only the view→model bridge says zoe.
        spec.it("filter: a visible row maps back to the MODEL item") callback {
            lbl = uidriver.widget_id_by_text("zoe")
            r = uidriver.widget_int_field_by_id(lbl, "parent")
            uidriver.post_ok("/widget/${r}/click", "click the only visible row")
            ok = uidriver.wait_body_contains("/widgets", "picked zoe", 20)
            spec.assert_true(ok,
                "table_item_at resolved view row 0 to model row 3 (zoe)")
        }

        // Headers sort the MODEL, the view re-derives — so a filtered table
        // sorts without un-hiding anything.
        spec.it("filter: sorting composes while filtered") callback {
            tf = uidriver.widget_id_of("textfield", "")
            uidriver.post_ok("/widget/${tf}/set_text?v=u", "filter to xu+wu")
            ok = uidriver.wait_body_contains("/widgets", "showing 2 of 4", 20)
            spec.assert_true(ok, "two rows visible")
            h = uidriver.widget_id_by_text("SSize")
            uidriver.post_ok("/widget/${h}/click", "sort by size while filtered")
            ok2 = uidriver.wait_body_contains("/widgets", "sorted: col 1 asc", 20)
            spec.assert_true(ok2, "sorter ran under the filter")
            spec.assert_true(before("xu", "wu"), "xu (95) before wu (100), numeric")
            b = uidriver.get_body("/widgets")
            nz = string.contains(b, "zoe")
            spec.assert_eq(nz, 0, "sorting did not un-hide zoe")
        }

        spec.it("filter: emptying the box shows every row again") callback {
            tf = uidriver.widget_id_of("textfield", "")
            uidriver.post_ok("/widget/${tf}/set_text?v=", "clear the filter")
            ok = uidriver.wait_body_contains("/widgets", "showing 4 of 4", 20)
            spec.assert_true(ok, "\"\" clears — no separate call needed")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "zoe", "zoe back")
            spec.assert_contains(b, "yan", "yan back")
        }

        // table composes a listbox for its body, so it inherits the keyboard
        // navigation and focusable rows listbox gained. Asserted here rather
        // than assumed: nothing else pins it, and a future refactor moving
        // table off listbox would silently take arrow-key navigation with it --
        // and with that the only way to reach these rows without a mouse --
        // while every other table assertion kept passing.
        spec.it("rows are keyboard-navigable (inherited from listbox)") callback {
            r = first_role_widget("listitem")
            spec.assert_gt(r, 0, "a row with the listitem role exists")
            uidriver.post_ok("/widget/${r}/click", "select the first row")
            first = selected_row_id()
            spec.assert_eq(first, r, "the clicked row is selected")

            uidriver.window_key("Down")
            second = selected_row_id()
            spec.assert_true(second != first, "Down moved to another row")

            uidriver.window_key("Up")
            spec.assert_eq(selected_row_id(), first, "Up came back")
        }
    }
    return spec.run_summary(fw)
}
