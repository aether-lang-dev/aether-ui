// spec_vlist_demo.ae, virtualized list.
//
// 1000 items, and only a bounded set of row widgets is ever realized; scrolling
// slides the window and recycles them rather than adding more. The driver
// counts "row N" widgets and checks which rows are shown.
//
// The BOUND depends on the backing, which is why the demo reports it. The
// composed window and NSTableView realize the window the app asked for, ten
// rows. GtkListView keeps a fixed pool of its own: measured at 205 items for a
// model of 1,000 and the same 205 for 20,000, unchanged by viewport height, so
// it virtualizes 20,000 rows into 205 widgets and will never go down to ten.
//
// Asserting a single number here asserts the backing rather than the
// behaviour, which is what made the GTK4 attempt in #91 look broken while it
// was working correctly.
import std.spec
import uidriver
import std.string

// How many "row N" text widgets currently exist.
row_count() -> int {
    b = uidriver.get_body("/widgets")
    n = 0
    rest = b
    while string.contains(rest, "\"text\":\"row ") == 1 {
        n = n + 1
        idx = string.string_index_of(rest, "\"text\":\"row ")
        rest = string.string_substring(rest, idx + 12, string.length(rest))
    }
    return n
}

// The upper bound on realized rows for the backing in use. What is being
// tested is that the count stays FAR below the model and stops growing, not
// that it equals any particular number.
row_bound() -> int {
    b = uidriver.get_body("/widgets")
    if string.contains(b, "backing-native") == 1 { return 250 }
    return 10
}

// The widget that owns native scroll, found by asking rather than by walking
// a fixed number of levels. A vlist backed by a native collection view wraps
// each row in its own cell container, so the owner is row 0's grandparent
// there and its parent when the list is composed by hand. A dy=0 step is a
// no-op that still reports whether a handler is attached, so this probes
// behaviour instead of tree shape.
scroll_owner(from_id: int) -> int {
    id = from_id
    hops = 0
    while hops < 4 {
        id = uidriver.widget_int_field_by_id(id, "parent")
        if id <= 0 { return 0 }
        body = uidriver.post_body("/widget/${id}/scroll?dy=0")
        if string.contains(body, "\"fired\":true") == 1 { return id }
        hops = hops + 1
    }
    return 0
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "virtualized list over AetherUIDriver") {
        spec.it("only a window of rows is realized, not all 1000") callback {
            n = row_count()
            spec.assert_true(n > 0, "some rows are realized (got ${n})")
            spec.assert_true(n <= row_bound(),
                "realized rows stay bounded at ${row_bound()}, far below the 1000 items (got ${n})")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "\"text\":\"row 0\"", "window starts at row 0")
            spec.assert_contains(b, "\"text\":\"row 9\"", "window ends at row 9")
            // Rows far outside the window are NOT realized.
            absent = string.contains(b, "\"text\":\"row 500\"")
            spec.assert_eq(absent, 0, "row 500 is not realized initially")
        }

        spec.it("scrolling slides the window and recycles widgets") callback {
            // The exact property, and the one that does not depend on the
            // backing: scrolling must not realize MORE widgets. Comparing the
            // count with itself across a scroll says that on any backend,
            // where a fixed number only says it on one.
            before = row_count()
            m = uidriver.widget_id_by_text("to 500")
            uidriver.post_ok("/widget/${m}/click", "scroll to 500")
            ok = uidriver.wait_body_contains("/widgets", "\"text\":\"row 500\"", 20)
            spec.assert_true(ok, "row 500 realized after scroll")
            // Still bounded — the old window's rows were recycled, not added to.
            n2 = row_count()
            // Recycling means the count does not grow WITH the scroll. It is
            // not always identical: GtkListView's pool settles one item wider
            // after the first scroll (205 then 206) and then stays there,
            // while the composed path and NSTableView hold exactly steady. A
            // small fixed slack distinguishes "recycled" from "one more widget
            // per row scrolled", which is the failure this is for.
            spec.assert_true(n2 <= before + 2,
                "the count did not grow with the scroll: ${before} then ${n2}")
            b = uidriver.get_body("/widgets")
            gone = string.contains(b, "\"text\":\"row 0\"")
            // Only a SLIDING window drops row 0 when it scrolls away. A
            // pooled backing keeps ~205 items realized, which spans row 0 at
            // this model size, so asserting its absence there asserts the
            // backing rather than the recycling.
            if row_bound() == 10 {
                spec.assert_eq(gone, 0, "row 0 recycled out of the sliding window")
            } else {
                spec.assert_true(n2 <= row_bound(),
                    "the pool stayed bounded rather than growing to cover both ends")
            }
        }

        spec.it("scrolling to the end clamps the window") callback {
            e = uidriver.widget_id_by_text("to end")
            uidriver.post_ok("/widget/${e}/click", "scroll to end")
            ok = uidriver.wait_body_contains("/widgets", "\"text\":\"row 999\"", 20)
            spec.assert_true(ok, "last item shown")
            // The window clamps to the end of the model, and stays bounded.
            n3 = row_count()
            spec.assert_true(n3 <= row_bound(),
                "the clamped window is still bounded (got ${n3})")
            spec.assert_true(n3 > 0, "and it still shows rows")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "\"text\":\"row 990\"", "window clamped to end")
        }

        spec.it("a native scroll step slides + recycles the window") callback {
            // Reset to the top, then drive a real scroll step through the
            // container's native-scroll path: POST /widget/{container}/scroll.
            // The container is the vstack parent of the row widgets.
            t = uidriver.widget_id_by_text("top")
            uidriver.post_ok("/widget/${t}/click", "reset to top")
            okt = uidriver.wait_body_contains("/widgets", "\"text\":\"row 0\"", 20)
            spec.assert_true(okt, "back at the top")

            r0 = uidriver.widget_id_by_text("row 0")
            container = scroll_owner(r0)
            spec.assert_gt(container, 0, "vlist container found")

            // dy=1 → window slides forward one row: 0..9 becomes 1..10.
            uidriver.post_ok("/widget/${container}/scroll?dy=1", "native scroll +1")
            ok = uidriver.wait_body_contains("/widgets", "\"text\":\"row 10\"", 20)
            spec.assert_true(ok, "row 10 realized after a native scroll step")
            n4 = row_count()
            spec.assert_true(n4 <= row_bound(),
                "still bounded after a native scroll step: recycled, not grown (got ${n4})")
            b = uidriver.get_body("/widgets")
            gone = string.contains(b, "\"text\":\"row 0\"")
            if row_bound() == 10 {
                spec.assert_eq(gone, 0, "row 0 scrolled out of the sliding window")
            } else {
                spec.assert_true(row_count() <= row_bound(),
                    "the pool stayed bounded after a native scroll step")
            }
        }
    }
    return spec.run_summary(fw)
}
