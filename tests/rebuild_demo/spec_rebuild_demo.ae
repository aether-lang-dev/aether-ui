// spec_rebuild_demo.ae: clear_children / remove_child really remove, on
// every backend (issue #1).
//
// Detaching a widget from its parent is the easy half. The half that was
// wrong is the REGISTRY: a container rebuilt behind the driver's back left
// its old children listed in /widgets as visible, and POST /widget/<id>/click
// still answered {"ok":true} and fired the callback of a cell that no longer
// exists on screen. Automation against a data view (a file grid, a search
// result set, a table on a new query) could then act on phantom rows.
//
// So each case asserts BOTH halves: the widget is gone from /widgets, AND
// its stale id is refused, AND no callback ran (the status line, which every
// cell's closure writes to, must not name the removed cell).
//
// Both container shapes are covered because the backends route them
// differently: a GRID is not a box (GtkGrid / NSView / plain HWND children),
// a STACK is (GtkBox / NSStackView).
//
// Run via ci.sh Phase 5m, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/rebuild_demo/bin/rebuild_demo &
//   UI_SPEC=rebuild_demo/spec_rebuild_demo tests/run_spec.sh
import std.spec
import uidriver
import std.string

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "clear_children / remove_child over AetherUIDriver") {
        spec.it("starts with three grid cells and two stack rows") callback {
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "grid g0 #0", "first grid cell rendered")
            spec.assert_contains(b, "grid g0 #2", "last grid cell rendered")
            spec.assert_contains(b, "stack row A", "first stack row rendered")
            spec.assert_contains(b, "stack row B", "second stack row rendered")
        }

        spec.it("clear_children drops every cell from /widgets") callback {
            stale = uidriver.widget_id_by_text("grid g0 #0")
            spec.assert_gt(stale, 0, "grid cell has a driver id before the rebuild")

            r = uidriver.widget_id_by_text("Rebuild grid")
            uidriver.post_ok("/widget/${r}/click", "rebuild")
            ok = uidriver.wait_body_contains("/widgets", "grid g1 #0", 20)
            spec.assert_true(ok, "the rebuilt generation rendered")

            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "grid g1 #2", "every rebuilt cell rendered")
            g0 = uidriver.widget_id_by_text("grid g0 #0")
            spec.assert_eq(g0, 0, "cleared cell gone from /widgets")

            // The reported defect: the stale id stayed clickable and its old
            // callback still ran.
            st = uidriver.post_status("/widget/${stale}/click")
            spec.assert_eq(st, 404, "clicking a cleared cell is refused")
            b2 = uidriver.get_body("/widgets")
            spec.assert_eq(string.contains(b2, "clicked grid g0 #0"), 0,
                "no callback fired for the cleared cell")
        }

        spec.it("remove_child drops one grid cell, and only that one") callback {
            stale = uidriver.widget_id_by_text("grid g1 #0")
            spec.assert_gt(stale, 0, "the cell to remove has a driver id")

            r = uidriver.widget_id_by_text("Remove first cell")
            uidriver.post_ok("/widget/${r}/click", "remove grid cell")
            ok = uidriver.wait_body_contains("/widgets", "removed grid cell", 20)
            spec.assert_true(ok, "the remove ran")

            gone = uidriver.widget_id_by_text("grid g1 #0")
            spec.assert_eq(gone, 0, "removed grid cell gone from /widgets")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "grid g1 #1", "its siblings are untouched")
            spec.assert_contains(b, "grid g1 #2", "its siblings are untouched")

            st = uidriver.post_status("/widget/${stale}/click")
            spec.assert_eq(st, 404, "clicking a removed cell is refused")
            b2 = uidriver.get_body("/widgets")
            spec.assert_eq(string.contains(b2, "clicked grid g1 #0"), 0,
                "no callback fired for the removed cell")
        }

        spec.it("remove_child drops a stack row too") callback {
            stale = uidriver.widget_id_by_text("stack row A")
            spec.assert_gt(stale, 0, "the row to remove has a driver id")

            r = uidriver.widget_id_by_text("Remove stack row")
            uidriver.post_ok("/widget/${r}/click", "remove stack row")
            ok = uidriver.wait_body_contains("/widgets", "removed stack row", 20)
            spec.assert_true(ok, "the remove ran")

            gone = uidriver.widget_id_by_text("stack row A")
            spec.assert_eq(gone, 0, "removed stack row gone from /widgets")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "stack row B", "its sibling is untouched")

            st = uidriver.post_status("/widget/${stale}/click")
            spec.assert_eq(st, 404, "clicking a removed row is refused")
        }

        // A rebuilt container must survive the next window resize with its
        // rows placed. win32's #150 held painting across a rebuild with
        // WM_SETREDRAW, which DefWindowProc implements by clearing
        // WS_VISIBLE; that backend reads the bit as the widget's own
        // visibility, so the parent's next layout treated the held column
        // as absent and every row lost its rect (#152). A rect with size is
        // the assertion: it is 0x0 the moment a parent lays a child out as
        // if it were not there.
        spec.it("a rebuilt stack keeps its rows placed across a window resize") callback {
            r = uidriver.widget_id_by_text("Rebuild stack")
            uidriver.post_ok("/widget/${r}/click", "rebuild stack")
            ok = uidriver.wait_body_contains("/widgets", "stack row D", 20)
            spec.assert_true(ok, "the rebuilt stack rendered")
            gone = uidriver.widget_id_by_text("stack row B")
            spec.assert_eq(gone, 0, "the cleared row is gone from /widgets")

            row = uidriver.widget_id_by_text("stack row D")
            spec.assert_gt(row, 0, "a rebuilt row has a driver id")
            w0 = uidriver.widget_int_field_by_id(row, "w")
            h0 = uidriver.widget_int_field_by_id(row, "h")
            spec.assert_gt(w0, 0, "the row has a width before the resize")
            spec.assert_gt(h0, 0, "the row has a height before the resize")

            uidriver.resize_window(700, 560)
            // The resize lands asynchronously on every backend; the row is
            // read once its container has been laid out against the new
            // client, which is when its width differs from before or, where
            // a row does not stretch, when the wait simply times out and the
            // size below is asserted as it stands.
            _ = uidriver.wait_int_field_change(row, "w", w0, 20)
            w1 = uidriver.widget_int_field_by_id(row, "w")
            h1 = uidriver.widget_int_field_by_id(row, "h")
            spec.assert_gt(w1, 0, "the row still has a width after the resize")
            spec.assert_gt(h1, 0, "the row still has a height after the resize")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "stack row D", "the row is still listed")
        }
    }
    return spec.run_summary(fw)
}
