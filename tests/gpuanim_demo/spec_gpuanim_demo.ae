// spec_gpuanim_demo.ae, #137: a GPU viewport redraws when the app asks it to.
//
// gpuview_demo asserts that one frame reached the GPU. This asserts the thing
// an app actually does with a viewport: ask for the next frame, and get it.
//
// The distinction matters because a request used to reach nothing with no
// window on screen, which is every CI run: the viewport drew its first frame
// and then stood still however many were asked for. The demo says which of the
// two happened in its own label rather than leaving a number to be read.
import std.spec
import uidriver
import std.string

// The text of the frame-count label out of the /widgets listing: the
// "text" field of the first entry that carries "frames", "animated" or
// "stalled". Kept short so an assertion message stays one line.
_label_of(body: string) -> string {
    at = string.index_of(body, "stalled")
    if at < 0 { at = string.index_of(body, "frames") }
    if at < 0 { return "(no frame-count label)" }
    from = at
    if from > 12 { from = from - 12 }
    return string.substring(body, from, at + 40)
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "a GPU viewport redraws on request (#137)") {
        spec.it("the app animated, or says it has no GPU surface") callback {
            // The demo asks for a frame every 16ms and stops at twelve, or
            // gives up after twelve seconds and says so. Its label changes
            // every tick, so wait_server above cannot settle until it has
            // finished, and most of that budget is usually spent before this
            // line; the wait here is what remains of the demo's, plus slack.
            // On the wrong side the label says which way it stopped, so the
            // failure names the number rather than leaving it to be read
            // off the runner.
            uidriver.wait_body_contains("/widgets", "animated", 100)
            body = uidriver.get_body("/widgets")
            animated = string.contains(body, "animated")
            no_gpu = string.contains(body, "no GPU surface on this backend")
            spec.assert_true(animated == 1 || no_gpu == 1,
                "twelve frames were asked for and drawn; the viewport label reads: ${_label_of(body)}")
        }
    }
    return spec.run_summary(fw)
}
