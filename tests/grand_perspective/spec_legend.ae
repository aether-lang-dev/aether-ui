// spec_legend.ae — grand_perspective: type-legend highlight toggle +
// colour-scheme radio group + scan-lifecycle button ghosting.
// Run via ci.sh Phase 6, or by hand:
//   GP_FIXTURE=/path ae run spec_legend.ae
import std.spec
import gp_driver
import uidriver
import std.string
import std.os

main() {
    fw = spec.init()
    gp_driver.wait_for_app()

    spec.describe(fw, "grand_perspective: legend + colour schemes") {
        spec.it("legend row click toggles a type highlight") callback {
            uidriver.click(820.0, 65.0)
            ok = gp_driver.wait_status_contains("Highlighting", 20)
            spec.assert_true(ok, "highlight on")
            uidriver.click(820.0, 65.0)
            ok2 = gp_driver.wait_status_contains("Highlight off", 20)
            spec.assert_true(ok2, "highlight off")
        }
        spec.it("colour-scheme toggles behave as a radio group") callback {
            spec.assert_eq(uidriver.widget_bool_by_text("by Type", "active"), 1,
                "by Type active initially (the default scheme)")
            bd = uidriver.widget_id_by_text("by Depth")
            uidriver.toggle_widget(bd)
            sleep(300)
            spec.assert_eq(uidriver.widget_bool_by_text("by Depth", "active"), 1,
                "by Depth active after toggle")
            spec.assert_eq(uidriver.widget_bool_by_text("by Type", "active"), 0,
                "by Type deactivated by the group")
            bt = uidriver.widget_id_by_text("by Type")
            uidriver.toggle_widget(bt)     // restore the default
            sleep(300)
            spec.assert_eq(uidriver.widget_bool_by_text("by Type", "active"), 1,
                "by Type active again")
        }
        spec.it("ghosts Stop when idle, Rescan stays live") callback {
            spec.assert_eq(uidriver.widget_bool_by_text("Stop", "enabled"), 0,
                "Stop ghosted when idle")
            spec.assert_eq(uidriver.widget_bool_by_text("Rescan", "enabled"), 1,
                "Rescan live when idle")
        }
    }
    spec.run_summary(fw)
}
