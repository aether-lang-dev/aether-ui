// spec_hover_and_resize.ae — grand_perspective: hover drives the status
// line; clicks still land after a window resize (px→viewBox unmapping
// through the live xMidYMid-meet mapping — the maximize/unmaximize
// regression pin). Run via ci.sh Phase 6, or by hand:
//   GP_FIXTURE=/path ae run spec_hover_and_resize.ae
import std.spec
import gp_driver
import uidriver
import std.string
import std.os

main() {
    fw = spec.init()
    gp_driver.wait_for_app()

    spec.describe(fw, "grand_perspective: hover + resize") {
        spec.it("hover names the tile under the pointer; off-map clears") callback {
            uidriver.move_to(120.0, 300.0)
            ok = gp_driver.wait_status_contains("big.bin", 20)
            spec.assert_true(ok, "hover over big.bin names it")
            uidriver.move_to(1020.0, 550.0)
            ok2 = gp_driver.wait_status_contains("—", 20)
            spec.assert_true(ok2, "hover off-map clears to em-dash")
        }
        spec.it("double-click still drills after a window resize") callback {
            // A toplevel cannot grow past the screen it is on (GTK clamps the
            // size to the monitor; no window manager is needed for that), so
            // on a 1280x1024 display -- xvfb-run's default, a laptop panel --
            // 1716 wide never happens and the canvas keeps its width while the
            // height still grows. ci.sh's own xvfb is 3200x2000, where the full
            // resize is reached. The mapping below is computed from the size
            // the canvas actually has, so either way the click lands through
            // the live xMidYMid-meet mapping; what is asserted is that the
            // window grew as far as the screen lets it.
            uidriver.resize_window(1716, 830)
            sleep(1000)
            win_w = uidriver.widget_int_field_by_id(1, "w")
            // Recompute sub's tile position through the same xMidYMid-meet
            // mapping the scene uses: px = vb*s + centered offset.
            cw = uidriver.canvas_w()
            ch = uidriver.canvas_h()
            if win_w >= 1716 {
                spec.assert_gt(cw, 1076, "canvas grew with the window")
            } else {
                // Clamped by the screen (window ${win_w} wide): the window
                // still grew taller, and the canvas must have followed it.
                spec.assert_gt(ch, 600, "canvas grew taller with the window (screen caps the width at ${win_w})")
            }
            sx = (cw / 1.0) / 1076.0
            sy = (ch / 1.0) / 600.0
            s = sx
            if sy < sx { s = sy }
            ox = ((cw / 1.0) - 1076.0 * s) / 2.0
            oy = ((ch / 1.0) - 600.0 * s) / 2.0
            px = 580.0 * s + ox
            py = 450.0 * s + oy
            uidriver.click(px, py)
            sleep(120)
            uidriver.click(px, py)
            ok = gp_driver.wait_crumbs_contains("sub", 20)
            spec.assert_true(ok, "double-click drills at the new scale")
        }
    }
    return spec.run_summary(fw)
}
