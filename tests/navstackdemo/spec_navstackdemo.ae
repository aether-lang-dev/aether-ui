// spec_navstackdemo.ae — drives the navstack example over the AetherUIDriver.
//
// The navstack ABI shipped as an UNEXERCISED stub: all three backends
// implemented push, nothing drove it, and nothing asserted it. This is the
// assertion. It is driver-based because it has to be -- a navigation stack is
// pure widget lifecycle, invisible to the SVG corpus and to golden images.
//
// What it pins:
//   * push ADDS the page's widgets to the tree (the driver sees them appear)
//   * push twice nests: both pages exist, the newest is on top
//   * pop REMOVES the top page's widgets (the count falls back)
//   * pop at the root is a no-op rather than an underflow
//   * the page TITLE renders as a real widget (the back chrome)
//   * nav_depth reports the BACKEND's page count, not the app's
//
// Run via ci.sh, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/navstackdemo/bin/navstackdemo &
//   UI_SPEC=navstackdemo/spec_navstackdemo tests/run_spec.sh
import std.spec
import uidriver
import std.string
import std.json

// Number of widgets the driver currently reports. A navigation stack has no
// depth readback of its own -- no backend exposes a page count -- so the
// widget census IS the observable: pushing a page adds its widgets, popping
// removes them.
widget_count() -> int {
    body = uidriver.get_body("/widgets")
    v, _jerr = json.parse(body)
    if v == null { return 0 }
    n = json.json_array_size(v)
    json.json_free(v)
    return n
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "navstack over AetherUIDriver") {
        spec.it("starts at the root with no pushed pages") callback {
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "depth: 1", "depth starts at 1")
            spec.assert_contains(b, "Home", "crumb reads Home")
        }

        spec.it("push adds the page's widgets to the tree") callback {
            before = widget_count()
            spec.assert_gt(before, 0, "tree is non-empty")
            p = uidriver.widget_id_by_text("Push page")
            spec.assert_gt(p, 0, "Push button found")
            uidriver.post_ok("/widget/${p}/click", "push page 2")
            ok = uidriver.wait_body_contains("/widgets", "depth: 2", 20)
            spec.assert_true(ok, "depth reached 2")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "Page 2", "page 2 title rendered")
            spec.assert_contains(b, "pushed onto the navigation stack",
                                   "page body rendered")
            after = widget_count()
            spec.assert_gt(after, before, "push GREW the widget tree")
        }

        spec.it("the page title renders as a real widget") callback {
            // The title argument was discarded by all three backends, so a
            // navstack had no back chrome. It is now a REGISTERED widget --
            // which is what makes it assertable here at all. "Page 2" appears
            // three times: the crumb, this title bar, and the page body's own
            // label.
            b = uidriver.get_body("/widgets")
            first = string.index_of(b, "Page 2")
            spec.assert_gt(first, -1, "a Page 2 label exists")
            rest = string.substring(b, first + 6, string.length(b))
            second = string.index_of(rest, "Page 2")
            spec.assert_gt(second, -1, "a SECOND Page 2 exists (the title bar)")
            rest2 = string.substring(rest, second + 6, string.length(rest))
            third = string.index_of(rest2, "Page 2")
            spec.assert_gt(third, -1, "and a THIRD (crumb + title + body)")
        }

        spec.it("a second push nests rather than replacing") callback {
            p = uidriver.widget_id_by_text("Push page")
            uidriver.post_ok("/widget/${p}/click", "push page 3")
            ok = uidriver.wait_body_contains("/widgets", "depth: 3", 20)
            spec.assert_true(ok, "depth reached 3")
            b = uidriver.get_body("/widgets")
            // BOTH pages are present: pushing does not discard what is under
            // it, which is what makes a later pop meaningful.
            spec.assert_contains(b, "Page 2", "page 2 still in the tree")
            spec.assert_contains(b, "Page 3", "page 3 pushed on top")
        }

        spec.it("nav_depth reports the backend's own page count") callback {
            // Before this readback existed an app had to track depth ITSELF
            // to know whether Back applied -- state the toolkit already held.
            // Two pages are pushed by the time this runs.
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "pages: 2",
                                   "backend reports 2 pages pushed")
        }

        spec.it("pop removes the top page") callback {
            before = widget_count()
            bk = uidriver.widget_id_by_text("Back")
            spec.assert_gt(bk, 0, "Back button found")
            uidriver.post_ok("/widget/${bk}/click", "pop to page 2")
            ok = uidriver.wait_body_contains("/widgets", "depth: 2", 20)
            spec.assert_true(ok, "depth fell to 2")
            after = widget_count()
            spec.assert_gt(before, after, "pop SHRANK the widget tree")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "Page 2", "page 2 restored as the top")
        }

        spec.it("pop at the root is a no-op, not an underflow") callback {
            bk = uidriver.widget_id_by_text("Back")
            uidriver.post_ok("/widget/${bk}/click", "pop to root")
            ok = uidriver.wait_body_contains("/widgets", "depth: 1", 20)
            spec.assert_true(ok, "depth back to 1")
            // Popping again at the root must change nothing and must not
            // crash the app -- the driver still answering IS the assertion.
            before = widget_count()
            uidriver.post_ok("/widget/${bk}/click", "pop at root")
            after = widget_count()
            spec.assert_eq(after, before, "root pop left the tree alone")
            b = uidriver.get_body("/widgets")
            spec.assert_contains(b, "depth: 1", "still at depth 1")
        }

        // The page is now built by the DECLARATIVE nav_page scope
        // (docs/design/declarative-consistency-audit.md): a builder whose
        // block populates the body and whose epilogue pushes it. This asserts
        // the scope RESOLVED -- the block's widgets landed inside the pushed
        // page rather than in the enclosing window, which is the one way this
        // shape can go wrong and still look plausible.
        spec.it("a declared page's widgets land INSIDE the page") callback {
            p = uidriver.widget_id_by_text("Push page")
            uidriver.post_ok("/widget/${p}/click", "push a page")
            ok = uidriver.wait_body_contains("/widgets", "pushed onto the navigation stack", 20)
            spec.assert_true(ok, "the block's text widget exists")

            // Its parent chain must reach the navstack, not the window root.
            t = uidriver.widget_id_by_text("pushed onto the navigation stack")
            body = uidriver.widget_int_field_by_id(t, "parent")
            spec.assert_gt(body, 0, "the text has a container parent")
            host = uidriver.widget_int_field_by_id(body, "parent")
            spec.assert_gt(host, 0, "that container is itself parented (into the stack)")
        }
    }

    return spec.run_summary(fw)
}
