// spec_calculator.ae — drives the calculator example over the
// AetherUIDriver: digit entry, the four operations, chaining, divide-by-
// zero safety, and the Under Remote Control banner. The display is
// reactive state #1; buttons are clicked by label.
// Run via ci.sh Phase 3, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/calculator/bin/calculator &
//   UI_SPEC=calculator/spec_calculator tests/run_spec.sh
import std.spec
import uidriver
import std.string
import std.os

// Click a calculator key by its button label. Type-scoped: the display is
// a text widget whose content can equal a digit ("0" after C), so a bare
// find-by-text would hit it.
press(label: string) {
    id = uidriver.widget_id_of("button", label)
    spec.assert_gt(id, 0, string.concat("key exists: ", label))
    uidriver.click_widget(id)
}

key_(label: string, f: string) -> int {
    return uidriver.widget_int_field_by_id(uidriver.widget_id_of("button", label), f)
}

// The keypad is grid(4, 4, 4) { equal_cells(); ... }: keys in a row share a
// y, keys in a column share an x, and every key is one size (within the
// point a fractional split can round away).
keypad_row_(keys: string, row: string) {
    y = key_(string.substring(keys, 0, 1), "y")
    i = 1
    while i < 4 {
        k = string.substring(keys, i, i + 1)
        spec.assert_eq(key_(k, "y"), y, "${k} on the ${row} row")
        spec.assert_gt(key_(k, "x"), key_(string.substring(keys, i - 1, i), "x"), "${k} right of its neighbour")
        i = i + 1
    }
}

near_(a: int, b: int) -> int {
    if a - b <= 1 && b - a <= 1 { return 1 }
    return 0
}

display_is(expected: int, msg: string) {
    sleep(120)
    spec.assert_eq(uidriver.state_value_int(1), expected, msg)
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "calculator over AetherUIDriver") {
        spec.it("enters multi-digit numbers and clears") callback {
            press("4")
            press("2")
            display_is(42, "4 then 2 = 42")
            press("C")
            display_is(0, "C resets to 0")
        }
        spec.it("adds") callback {
            press("7"); press("+"); press("3"); press("=")
            display_is(10, "7 + 3 = 10")
            press("C")
        }
        spec.it("subtracts") callback {
            press("9"); press("-"); press("4"); press("=")
            display_is(5, "9 - 4 = 5")
            press("C")
        }
        spec.it("multiplies") callback {
            press("6"); press("*"); press("8"); press("=")
            display_is(48, "6 * 8 = 48")
            press("C")
        }
        spec.it("divides") callback {
            press("9"); press("/"); press("3"); press("=")
            display_is(3, "9 / 3 = 3")
            press("C")
        }
        spec.it("handles multi-digit operands") callback {
            press("1"); press("2"); press("+"); press("3"); press("4"); press("=")
            display_is(46, "12 + 34 = 46")
            press("C")
        }
        spec.it("chains operations") callback {
            press("5"); press("*"); press("3"); press("=")
            display_is(15, "5 * 3 = 15")
            press("+"); press("5"); press("=")
            display_is(20, "15 + 5 = 20")
            press("C")
        }
        spec.it("survives division by zero") callback {
            press("7"); press("/"); press("0"); press("=")
            display_is(7, "7 / 0 = 7 (safe)")
            press("C")
        }
        spec.it("lays the keys out as a 4x4 grid of equal cells") callback {
            keypad_row_("789+", "first")
            keypad_row_("456-", "second")
            keypad_row_("123*", "third")
            keypad_row_("0C=/", "fourth")
            spec.assert_eq(key_("4", "x"), key_("7", "x"), "4 under 7")
            spec.assert_eq(key_("0", "x"), key_("7", "x"), "0 under 7")
            spec.assert_eq(key_("/", "x"), key_("+", "x"), "/ under +")
            spec.assert_gt(key_("4", "y"), key_("7", "y"), "second row below the first")
            w = key_("7", "w")
            h = key_("7", "h")
            spec.assert_gt(w, 30, "keys share the window's width")
            spec.assert_true(near_(key_("8", "w"), w) == 1 && near_(key_("+", "w"), w) == 1 && near_(key_("C", "w"), w) == 1, "one width")
            spec.assert_true(near_(key_("4", "h"), h) == 1 && near_(key_("/", "h"), h) == 1, "one height")
        }
        spec.it("shows the Under Remote Control banner") callback {
            spec.assert_contains(uidriver.get_body("/widgets"), "\"banner\":true",
                "banner present in the widget tree")
        }
    }
    return spec.run_summary(fw)
}
