// spec_datagrid_demo.ae — the virtualised grid: only the shown cells exist,
// the scrollbars scroll it, the header and the frozen column stay put (phase 1);
// clicks and keys move a cursor and a range, read back as the demo's
// "selection:" line and as the cells' colours (phase 2); header drags resize
// and move columns, read back as geometry and the demo's lines (phase 3);
// an editor opens over a cell, commits and cancels (phase 4); the grid, its
// rows and cells say where they are to a screen reader (phase 5).
//
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/datagrid_demo/bin/datagrid_demo &
//   UI_SPEC=datagrid_demo/spec_datagrid_demo tests/run_spec.sh
import std.spec
import uidriver
import std.string
import std.json
import std.os
import std.fs

// How many widgets of `type` /widgets lists.
count_of(type: string) -> int {
    body = uidriver.get_body("/widgets")
    v, _jerr = json.parse(body)
    if v == null { return 0 - 1 }
    n = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        // Not the driver's "Under Remote Control" banner, which some
        // backends list as a text.
        if string.equals(uidriver.field_str(w, "type"), type) == 1 {
            if string.equals(uidriver.field_str(w, "text"), "Under Remote Control") == 0 { n = n + 1 }
        }
        i = i + 1
    }
    json.json_free(v)
    return n
}

// The id of the first or last widget of a type (the grid's two scrollbars:
// the vertical one is made first).
// How many cells show their R<r>C<c> text now (a row out of the grid's
// height says nothing).
cell_texts() -> int {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return 0 - 1 }
    n = 0
    i = 0
    while i < json.json_array_size(v) {
        t = uidriver.field_str(json.json_array_get_raw(v, i), "text")
        if string.starts_with(t, "R") == 1 && string.contains(t, "C") == 1 && string.length(t) > 3 { n = n + 1 }
        i = i + 1
    }
    json.json_free(v)
    return n
}

nth_of(type: string, last: int) -> int {
    if last == 1 { return uidriver.widget_id_last_of(type, "") }
    return uidriver.widget_id_of(type, "")
}

field_of_text(t: string, f: string) -> int {
    return uidriver.widget_int_field_by_id(uidriver.widget_id_by_text(t), f)
}

// The string field f of the widget with text t.
fstr(t: string, f: string) -> string {
    body = uidriver.get_body("/widget/${uidriver.widget_id_by_text(t)}")
    v, _jerr = json.parse(body)
    if v == null { return "" }
    r = uidriver.field_str(v, f)
    json.json_free(v)
    return r
}

// The colour a cell was painted, "#rrggbb" ("" when never set).
bg_of(t: string) -> string {
    body = uidriver.get_body("/widget/${uidriver.widget_id_by_text(t)}")
    v, _jerr = json.parse(body)
    if v == null { return "" }
    r = uidriver.field_str(v, "bg")
    json.json_free(v)
    return r
}

key(combo: string) {
    uidriver.post_ok("/window/key?combo=${combo}", "press ${combo}")
}

// A field of the widget with text t once it reads `want`, or what it reads
// after ~3s: GTK lays out on its next frame, so geometry read straight after
// a change can still be the old one.
settled(t: string, f: string, want: int) -> int {
    v = field_of_text(t, f)
    i = 0
    while i < 20 && v != want {
        sleep(150)
        v = field_of_text(t, f)
        i = i + 1
    }
    return v
}

// A string field of the widget with text t.
str_of_text(t: string, f: string) -> string {
    body = uidriver.get_body("/widget/${uidriver.widget_id_by_text(t)}")
    v, _jerr = json.parse(body)
    if v == null { return "" }
    r = uidriver.field_str(v, f)
    json.json_free(v)
    return r
}

// The id of the first widget whose role is `role` (0 when none).
id_of_role(role: string) -> int {
    body = uidriver.get_body("/widgets")
    v, _jerr = json.parse(body)
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) && id == 0 {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "role"), role) == 1 { id = uidriver.field_int(w, "id") }
        i = i + 1
    }
    json.json_free(v)
    return id
}

// The open editor, 0 when none: the newest text field (the demo's Notes
// field, outside the grid, is the first).
editor() -> int {
    if count_of("textfield") < 2 { return 0 }
    return uidriver.widget_id_last_of("textfield", "")
}

// Wait for the editor to be open (with the caret placed) or gone.
editor_open(want: int) -> int {
    i = 0
    while i < 30 {
        e = editor()
        if want == 0 && e == 0 { return 1 }
        if want == 1 && e != 0 {
            // Placed means a caret, not the select-all a field can get
            // as it takes focus.
            s = uidriver.widget_int_field_by_id(e, "sel_start")
            if s > 0 && s == uidriver.widget_int_field_by_id(e, "sel_end") { return 1 }
        }
        sleep(100)
        i = i + 1
    }
    return 0
}

// The grip at the right edge of the header cell whose label is t: the
// widget with class aui-grid-grip that shares the label's parent.
grip_of(t: string) -> int {
    parent = uidriver.widget_int_field_by_id(uidriver.widget_id_by_text(t), "parent")
    body = uidriver.get_body("/widgets")
    v, _jerr = json.parse(body)
    if v == null { return 0 }
    id = 0
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if uidriver.field_int(w, "parent") == parent && string.contains(uidriver.field_str(w, "classes"), "aui-grid-grip") == 1 {
            id = uidriver.field_int(w, "id")
        }
        i = i + 1
    }
    json.json_free(v)
    return id
}

// Drag the grip of header t by dx (a resize).
drag_grip(t: string, dx: int) {
    uidriver.post_ok("/widget/${grip_of(t)}/drag?x=3&y=8&dx=${dx}&dy=0", "drag ${t}'s grip")
}

// A header cell's width (the label's parent, which holds it and its grip),
// once it reads `want` or after ~3s.
header_w(t: string, want: int) -> int {
    box = uidriver.widget_int_field_by_id(uidriver.widget_id_by_text(t), "parent")
    v = uidriver.widget_int_field_by_id(box, "w")
    i = 0
    while i < 20 && v != want {
        sleep(150)
        v = uidriver.widget_int_field_by_id(box, "w")
        i = i + 1
    }
    return v
}

// Drag widget-with-text t: pressed at (x, 8) inside it, moved by dx.
drag(t: string, x: int, dx: int) {
    uidriver.post_ok("/widget/${uidriver.widget_id_by_text(t)}/drag?x=${x}&y=8&dx=${dx}&dy=0", "drag ${t}")
}

shows(t: string) -> int {
    return uidriver.wait_body_contains("/widgets", "\"text\":\"${t}\"", 20)
}

// No widget shows text t (waiting ~3s for it to go).
gone(t: string) -> int {
    i = 0
    while i < 20 {
        if string.contains(uidriver.get_body("/widgets"), "\"text\":\"${t}\"") == 0 { return 1 }
        sleep(150)
        i = i + 1
    }
    return 0
}

y_of_row1() -> int {
    return field_of_text("R1C1", "y")
}

// The text of the cell the cursor's box is on (borderWidth 2), or "".
// How far widget w's top is below widget top's bottom edge.
below(w: int, top: int) -> int {
    return uidriver.widget_int_field_by_id(w, "y") - uidriver.widget_int_field_by_id(top, "y") - uidriver.widget_int_field_by_id(top, "h")
}

boxed() -> string {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return "" }
    t = ""
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.contains(uidriver.field_str(w, "classes"), "aui-grid-cell") == 1 && uidriver.field_int(w, "borderWidth") == 2 { t = uidriver.field_str(w, "text") }
        i = i + 1
    }
    json.json_free(v)
    return t
}

// 1 once the box is on the cell reading `text`.
boxed_on(text: string) -> int {
    i = 0
    while i < 40 {
        if string.equals(boxed(), text) == 1 { return 1 }
        sleep(50)
        i = i + 1
    }
    return 0
}

press(label: string) {
    uidriver.post_ok("/widget/${uidriver.widget_id_of("button", label)}/click", label)
}

// What is on the screen at a step: GET /screenshot saved as
// target/datagrid-snapshots/<name>.png (to be looked at), and its size from
// the PNG's header, "WxH" ("" where there is no screenshot, or no python3).
snapshot(name: string) -> string {
    dir = "target/datagrid-snapshots"
    _mk = fs.mkdir_p(dir)
    out, _ce = os.exec("curl -s -o ${dir}/${name}.png -w '%{http_code}' ${uidriver.url_of("/screenshot")}")
    if string.contains(out, "200") == 0 { return "" }
    dims, _de = os.exec("python3 -c \"import struct,sys; b=open(sys.argv[1],'rb').read(24); print('%dx%d' % struct.unpack('>II', b[16:24]))\" ${dir}/${name}.png")
    return string.trim(dims)
}

// The two scrollbars' values ("v,h"): the grid's scroll position.
scroll_at() -> string {
    v, _jerr = json.parse(uidriver.get_body("/widgets"))
    if v == null { return "" }
    out = ""
    i = 0
    while i < json.json_array_size(v) {
        w = json.json_array_get_raw(v, i)
        if string.equals(uidriver.field_str(w, "type"), "scrollbar") == 1 { out = "${out}${uidriver.get_body("/widget/${uidriver.field_int(w, "id")}")}" }
        i = i + 1
    }
    json.json_free(v)
    return out
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "a virtualised grid") {
        spec.it("shows the first window: header letters, row numbers, cells") callback {
            spec.assert_true(shows("A") == 1, "header A")
            spec.assert_true(shows("F") == 1, "header F (six scrolling columns)")
            spec.assert_true(shows("R0C1") == 1, "the top-left cell")
            spec.assert_true(shows("R19C6") == 1, "the bottom-right shown cell")
            spec.assert_true(shows("20") == 1, "row number 20 in the frozen column")
        }
        spec.it("a click on a fresh grid's cell, then typing, as a person does (real input where the platform makes it): the screen not moved, an editor with the focus, the key in it, Return stores it") callback {
            c = uidriver.widget_id_by_text("R5C4")
            spec.assert_gt(c, 0, "R5C4 shown")
            x0 = uidriver.widget_int_field_by_id(c, "x")
            y0 = uidriver.widget_int_field_by_id(c, "y")
            hdr = uidriver.widget_id_by_text("A")
            hx0 = uidriver.widget_int_field_by_id(hdr, "x")
            s0 = scroll_at()
            d0 = snapshot("1-before-click")
            // ?real=1: a real press and release, and real keys, through the
            // platform's event dispatch where the backend makes them (AppKit).
            uidriver.post_ok("/widget/${c}/click?real=1", "click R5C4")
            sleep(400)
            d1 = snapshot("2-after-click")
            spec.assert_eq(uidriver.widget_id_by_text("R5C4"), c, "the same cell shows R5C4")
            spec.assert_true(uidriver.widget_int_field_by_id(c, "x") == x0 && uidriver.widget_int_field_by_id(c, "y") == y0, "on the screen: the cell where it was (${x0},${y0})")
            spec.assert_eq(uidriver.widget_int_field_by_id(hdr, "x"), hx0, "on the screen: header A where it was")
            spec.assert_str_eq(scroll_at(), s0, "the scrollbars where they were")
            spec.assert_str_eq(d1, d0, "the window's snapshot the same size (${d0})")
            uidriver.post_ok("/window/key?combo=7&real=1", "type 7")
            spec.assert_true(editor_open(1) == 1, "typing opened an editor")
            d2 = snapshot("3-after-typing")
            spec.assert_eq(uidriver.focused_widget(), editor(), "the editor has the focus")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), "7", "holding 7")
            spec.assert_true(uidriver.widget_int_field_by_id(editor(), "x") == x0 && uidriver.widget_int_field_by_id(editor(), "y") == y0, "the editor over the cell (${x0},${y0})")
            spec.assert_str_eq(scroll_at(), s0, "still not scrolled")
            spec.assert_str_eq(d2, d0, "the snapshot the same size")
            uidriver.post_ok("/widget/${editor()}/submit", "Return")
            spec.assert_true(shows("edited: 5,4 = 7") == 1, "stored")
            _d3 = snapshot("4-after-return")
            spec.assert_true(uidriver.widget_int_field_by_id(c, "x") == x0 && uidriver.widget_int_field_by_id(c, "y") == y0, "the cell still where it was")
        }
        spec.it("only the shown cells exist: 7 header + 20 x 7 cells, of 5,000,000 (and ten labels)") callback {
            // 1 caption + 7 header + 140 cells + the clicked, selection,
            // activated, resized, moved, header-clicked and edited lines.
            spec.assert_eq(count_of("text"), 157, "texts")
        }
        spec.it("the vertical scrollbar stands up") callback {
            v = nth_of("scrollbar", 0)
            spec.assert_true(uidriver.widget_int_field_by_id(v, "h") > uidriver.widget_int_field_by_id(v, "w"),
                "taller than wide")
        }
        spec.it("each scrollbar's thumb is the share in view: 20 of 100,000 rows, 6 of 49 columns") callback {
            v = uidriver.get_body("/widget/${nth_of("scrollbar", 0)}")
            spec.assert_contains(v, "\"page\":20.00", "a window of the 20 rows shown")
            spec.assert_contains(v, "\"max\":100000.00", "onto 100,000 rows")
            h = uidriver.get_body("/widget/${nth_of("scrollbar", 1)}")
            spec.assert_contains(h, "\"page\":6.00", "a window of the 6 scrolling columns shown")
            spec.assert_contains(h, "\"max\":49.00", "onto 49 (50 less the frozen one)")
        }
        spec.it("a click names the cell it shows") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R3C2")}/click", "click R3C2")
            spec.assert_true(shows("clicked: 3,2") == 1, "row 3, column 2")
        }
        spec.it("scrolling to row 90,000 rewrites the cells; the header stays on top") callback {
            hdr_y = field_of_text("A", "y")
            v = nth_of("scrollbar", 0)
            uidriver.post_ok("/widget/${v}/set_value?v=90000", "scroll down")
            spec.assert_true(shows("R90000C1") == 1, "row 90,000 at the top")
            spec.assert_true(shows("90001") == 1, "its row number in the frozen column")
            spec.assert_true(shows("A") == 1, "the header still reads A")
            spec.assert_eq(field_of_text("A", "y"), hdr_y, "and has not moved")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
        spec.it("scrolling across keeps the frozen column and moves the rest") callback {
            hs = nth_of("scrollbar", 1)
            uidriver.post_ok("/widget/${hs}/set_value?v=39", "scroll right")
            spec.assert_true(shows("R90000C40") == 1, "column 40 first")
            spec.assert_true(shows("AN") == 1, "its header letter, AN")
            spec.assert_true(shows("90001") == 1, "the row number stayed")
            spec.assert_eq(count_of("text"), 157, "still no widgets added")
        }
        spec.it("and after scrolling, the cell's new row and column") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R90003C41")}/click", "click R90003C41")
            spec.assert_true(shows("clicked: 90003,41") == 1, "row 90,003, column 41")
        }
        spec.it("scrolling past the end stops at the last window") callback {
            v = nth_of("scrollbar", 0)
            uidriver.post_ok("/widget/${v}/set_value?v=200000", "scroll far down")
            spec.assert_true(shows("R99999C40") == 1, "the last row shows, at the bottom")
        }
    }

    spec.describe(fw, "selection and keys") {
        spec.it("a click puts the cursor on the cell and paints it") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R99990C41")}/click", "click R99990C41")
            spec.assert_true(shows("selection: 99990,41 from 99990,41") == 1, "one cell selected")
            spec.assert_str_eq(bg_of("R99990C41"), "#cce0ff", "the cursor's colour")
            spec.assert_eq(field_of_text("R99990C41", "borderWidth"), 2, "and its 2px border")
            spec.assert_str_eq(bg_of("R99990C42"), "#ffffff", "its neighbour plain")
        }
        spec.it("a Cmd/Ctrl click adds an area; a plain click is one area again") callback {
            uidriver.click_widget_mods(uidriver.widget_id_by_text("R99992C43"), 8)
            spec.assert_true(shows("selection: 99992,43 from 99992,43 and 99990,41,99990,41") == 1, "Cmd: the first cell kept as an area")
            spec.assert_str_eq(bg_of("R99990C41"), "#cce0ff", "it is still painted")
            spec.assert_str_eq(bg_of("R99992C43"), "#cce0ff", "and so is the new one")
            spec.assert_str_eq(bg_of("R99991C42"), "#ffffff", "what lies between is not")
            uidriver.click_widget_mods(uidriver.widget_id_by_text("R99993C44"), 2)
            spec.assert_true(shows("selection: 99993,44 from 99993,44 and 99990,41,99990,41;99992,43,99992,43") == 1, "Ctrl too: a third")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R99990C41")}/click", "click R99990C41")
            spec.assert_true(shows("selection: 99990,41 from 99990,41") == 1, "a plain click: one area")
            spec.assert_str_eq(bg_of("R99992C43"), "#ffffff", "the others repainted plain")
        }
        spec.it("arrows move the cursor") callback {
            key("Down")
            spec.assert_true(shows("selection: 99991,41 from 99991,41") == 1, "Down")
            key("Right")
            key("Left")
            key("Left")
            spec.assert_true(shows("selection: 99991,40 from 99991,40") == 1, "Right, Left, Left")
            spec.assert_str_eq(bg_of("R99990C41"), "#ffffff", "the old cell repainted plain")
        }
        spec.it("Shift+arrows extend a range from the anchor") callback {
            key("Shift%2BRight")
            key("Shift%2BRight")
            key("Shift%2BDown")
            spec.assert_true(shows("selection: 99992,42 from 99991,40") == 1, "a 2 x 3 range")
            spec.assert_str_eq(bg_of("R99991C40"), "#cce0ff", "the anchor is in the range")
            spec.assert_str_eq(bg_of("R99992C41"), "#cce0ff", "so is the middle")
            spec.assert_eq(field_of_text("R99992C42", "borderWidth"), 2, "the cursor has the border")
            spec.assert_eq(field_of_text("R99991C40", "borderWidth"), 0, "the anchor does not")
            spec.assert_str_eq(bg_of("R99993C41"), "#ffffff", "below the range is plain")
            key("Up")
            spec.assert_true(shows("selection: 99991,42 from 99991,42") == 1, "a plain arrow collapses it")
        }
        spec.it("Home goes to the row's start (the frozen column), End to its end, scrolling") callback {
            key("Home")
            spec.assert_true(shows("selection: 99991,0 from 99991,0") == 1, "Home")
            spec.assert_eq(field_of_text("99992", "borderWidth"), 2, "the row-number cell is the cursor")
            key("End")
            spec.assert_true(shows("selection: 99991,49 from 99991,49") == 1, "End")
            spec.assert_true(shows("R99991C49") == 1, "the last column scrolled into view")
            spec.assert_true(shows("AW") == 1, "with its header")
        }
        spec.it("Ctrl+Home and Ctrl+End go to the grid's corners") callback {
            key("Ctrl%2BHome")
            spec.assert_true(shows("selection: 0,0 from 0,0") == 1, "Ctrl+Home")
            spec.assert_true(shows("R0C44") == 1, "scrolled to the top")
            key("Up")
            key("Left")
            spec.assert_true(shows("selection: 0,0 from 0,0") == 1, "the edges clamp")
            key("Ctrl%2BEnd")
            spec.assert_true(shows("selection: 99999,49 from 99999,49") == 1, "Ctrl+End")
            spec.assert_true(shows("R99999C49") == 1, "scrolled to the bottom")
        }
        spec.it("Ctrl+arrows go to the edge of the data (every cell here shows something); Ctrl+Shift extends") callback {
            key("Ctrl%2BUp")
            spec.assert_true(shows("selection: 0,49 from 0,49") == 1, "Ctrl+Up: the top of the run")
            key("Ctrl%2BLeft")
            spec.assert_true(shows("selection: 0,1 from 0,1") == 1, "Ctrl+Left stops before the frozen row numbers")
            key("Ctrl%2BShift%2BRight")
            spec.assert_true(shows("selection: 0,49 from 0,1") == 1, "Ctrl+Shift+Right extends")
            key("Ctrl%2BEnd")
            spec.assert_true(shows("selection: 99999,49 from 99999,49") == 1, "back at the end")
        }
        spec.it("Page_Up and Page_Down move a screenful") callback {
            key("Page_Up")
            spec.assert_true(shows("selection: 99979,49 from 99979,49") == 1, "twenty rows up")
            spec.assert_true(shows("R99979C49") == 1, "and shown")
            key("Page_Down")
            spec.assert_true(shows("selection: 99999,49 from 99999,49") == 1, "and back")
        }
        spec.it("Return activates the cursor cell") callback {
            key("Return")
            spec.assert_true(shows("activated: 99999,49") == 1, "activated")
        }
        spec.it("Ctrl+A selects everything") callback {
            key("Ctrl%2Ba")
            spec.assert_true(shows("selection: 99999,49 from 0,0") == 1, "the whole grid")
            spec.assert_str_eq(bg_of("R99990C45"), "#cce0ff", "a shown cell is in it")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
    }

    spec.describe(fw, "column resize and reorder") {
        spec.it("back to the first columns") callback {
            hs = nth_of("scrollbar", 1)
            uidriver.post_ok("/widget/${hs}/set_value?v=0", "scroll left")
            spec.assert_true(shows("R99980C1") == 1, "column 1 first again")
            spec.assert_eq(header_w("C", 36), 36, "C starts 36 wide (the demo's width)")
        }
        spec.it("a grip at each header's right edge shows the col-resize pointer") callback {
            g = grip_of("C")
            spec.assert_true(g > 0, "C's header has a grip")
            body = uidriver.get_body("/widget/${g}")
            spec.assert_contains(body, "\"cursor\":\"col-resize\"", "the col-resize pointer over it")
            spec.assert_eq(uidriver.widget_int_field_by_id(g, "w"), 6, "6px wide")
            spec.assert_eq(uidriver.widget_int_field_by_id(g, "x"), field_of_text("C", "x") + field_of_text("C", "w"), "at the label's right edge")
            spec.assert_false(string.contains(uidriver.get_body("/widget/${uidriver.widget_id_by_text("C")}"), "\"cursor\"") == 1, "the label keeps the ordinary pointer")
        }
        spec.it("dragging a header's right edge resizes the column, cells and all") callback {
            drag_grip("C", 60)
            spec.assert_true(shows("resized: 3 to 96") == 1, "on_col_resize heard 3 to 96")
            spec.assert_eq(header_w("C", 96), 96, "the header is 96 wide")
            spec.assert_eq(settled("R99980C3", "w", 96), 96, "so is its column's cell")
            spec.assert_eq(settled("D", "x", field_of_text("C", "x") + 96), field_of_text("C", "x") + 96, "D starts where C ends")
        }
        spec.it("widths are clamped") callback {
            drag_grip("C", 0 - 500)
            spec.assert_true(shows("resized: 3 to 24") == 1, "no narrower than 24")
            spec.assert_eq(header_w("C", 24), 24, "the header is 24 wide")
        }
        spec.it("dragging a header elsewhere moves the column") callback {
            // 36 each but C at 24: B starts at 72, and pressed 18px in and
            // let go 96px right it is 186px in, over E (168 to 204).
            drag("B", 18, 96)
            spec.assert_true(shows("moved: 2 to 5") == 1, "on_col_move heard 2 to 5")
            _bx = settled("B", "x", field_of_text("F", "x") - 36)
            spec.assert_true(field_of_text("B", "x") > field_of_text("E", "x"), "B now right of E")
            spec.assert_true(field_of_text("C", "x") < field_of_text("D", "x"), "C, D and E slid left")
            spec.assert_eq(settled("R99980C2", "x", field_of_text("B", "x")), field_of_text("B", "x"), "B's cells moved with it")
            spec.assert_eq(header_w("C", 24), 24, "and C kept its width")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
        spec.it("a frozen column does not move") callback {
            drag("#", 18, 150)
            spec.assert_true(shows("moved: 2 to 5") == 1, "still the last move")
            spec.assert_true(field_of_text("#", "x") < field_of_text("A", "x"), "# stays first")
            spec.assert_true(shows("header clicked: none") == 1, "a drag is not a click")
        }
        spec.it("a header pressed and let go where it was is a click, its model column told") callback {
            drag("D", 10, 0)
            spec.assert_true(shows("header clicked: 4") == 1, "D's header: model column 4")
            spec.assert_true(shows("moved: 2 to 5") == 1, "and nothing moved")
            drag("#", 5, 2)
            spec.assert_true(shows("header clicked: 0") == 1, "the corner over the row numbers: 0, under 4 px of travel")
            drag("E", 10, 3)
            spec.assert_true(shows("header clicked: 5") == 1, "E's, moved 3 px: still a click")
        }
    }

    spec.describe(fw, "editing") {
        spec.it("a double click opens an editor over the cell, caret at the end") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R99981C1")}/double_click", "double-click R99981C1")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            e = editor()
            spec.assert_str_eq(uidriver.widget_text_by_id(e), "R99981C1", "holding the cell's text")
            spec.assert_eq(uidriver.widget_int_field_by_id(e, "sel_start"), 8, "the caret after it")
            spec.assert_eq(uidriver.widget_int_field_by_id(e, "sel_end"), 8, "with nothing selected")
            spec.assert_eq(uidriver.widget_int_field_by_id(e, "x"), field_of_text("R99981C1", "x"), "over the cell")
            spec.assert_eq(uidriver.widget_int_field_by_id(e, "y"), field_of_text("R99981C1", "y"), "on its row")
        }
        spec.it("Return commits: on_edit stores it, the cell shows it, the cursor moves down") callback {
            e = editor()
            uidriver.post_ok("/widget/${e}/set_text?v=hello", "type hello")
            uidriver.post_ok("/widget/${e}/submit", "Return")
            spec.assert_true(shows("edited: 99981,1 = hello") == 1, "on_edit heard it")
            spec.assert_true(editor_open(0) == 1, "the editor closed")
            spec.assert_true(shows("hello") == 1, "the cell shows the stored text")
            spec.assert_true(shows("selection: 99982,1 from 99982,1") == 1, "the cursor moved down")
        }
        spec.it("typing opens an editor holding the typed character") callback {
            key("x")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), "x", "holding x")
            spec.assert_eq(uidriver.widget_int_field_by_id(editor(), "sel_start"), 1, "the caret after it")
        }
        spec.it("Escape cancels") callback {
            key("Escape")
            spec.assert_true(editor_open(0) == 1, "the editor closed")
            spec.assert_true(shows("R99982C1") == 1, "the cell is unchanged")
            spec.assert_true(shows("edited: 99981,1 = hello") == 1, "nothing was stored")
        }
        spec.it("F2 opens one; Tab commits and moves right") callback {
            key("F2")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), "R99982C1", "holding the cell's text")
            key("Tab")
            spec.assert_true(editor_open(0) == 1, "Tab closed it")
            spec.assert_true(shows("edited: 99982,1 = R99982C1") == 1, "and committed")
            spec.assert_true(shows("selection: 99982,2 from 99982,2") == 1, "the cursor moved right")
        }
        spec.it("an edit in a moved column lands in its model column") callback {
            // View column 2 shows model column 3 (C) since the move above.
            key("F2")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), "R99982C3", "on C's cell")
            uidriver.post_ok("/widget/${editor()}/set_text?v=zz", "type zz")
            uidriver.post_ok("/widget/${editor()}/submit", "Return")
            spec.assert_true(shows("edited: 99982,3 = zz") == 1, "on_edit heard model column 3 (C)")
            spec.assert_true(shows("zz") == 1, "and the cell shows it")
        }
        spec.it("clicking another cell commits the open editor") callback {
            key("q")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R99990C1")}/click", "click elsewhere")
            spec.assert_true(editor_open(0) == 1, "the editor closed")
            spec.assert_true(shows("edited: 99983,3 = q") == 1, "and committed q (model column 3)")
            spec.assert_eq(count_of("text"), 157, "no widgets left behind")
        }
        spec.it("a key named by a word opens an editor holding its character") callback {
            key("comma")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), ",", "holding the comma")
            key("Escape")
            spec.assert_true(editor_open(0) == 1, "and Escape closed it")
        }
        spec.it("focus leaving the grid commits the open editor") callback {
            key("w")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            uidriver.post_ok("/widget/${uidriver.widget_id_of("textfield", "")}/focus", "focus the Notes field outside the grid")
            spec.assert_true(editor_open(0) == 1, "the editor closed")
            spec.assert_true(shows("edited: 99990,1 = w") == 1, "and committed w")
        }
    }
    spec.describe(fw, "accessibility") {
        spec.it("the grid says its size: 100,000 rows and a header row, 50 columns") callback {
            gid = id_of_role("grid")
            spec.assert_true(gid > 0, "a widget with the grid role")
            spec.assert_eq(uidriver.widget_int_field_by_id(gid, "a11y_rows"), 100001, "rows, the header row included")
            spec.assert_eq(uidriver.widget_int_field_by_id(gid, "a11y_cols"), 50, "columns")
        }
        spec.it("a cell names its row, its column and its column's header") callback {
            spec.assert_str_eq(str_of_text("R99985C1", "role"), "gridcell", "a grid cell")
            spec.assert_eq(field_of_text("R99985C1", "a11y_row"), 99986, "model row 99,985 is row 99,986 (the header row is 0)")
            spec.assert_eq(field_of_text("R99985C1", "a11y_col"), 1, "column 1")
            spec.assert_str_eq(uidriver.widget_text_by_id(field_of_text("R99985C1", "a11y_header")), "A", "its header is A")
        }
        spec.it("a header is row 0 of its column, and a moved column's header goes with it") callback {
            spec.assert_str_eq(str_of_text("A", "role"), "columnheader", "a column header")
            spec.assert_eq(field_of_text("A", "a11y_row"), 0, "row 0")
            spec.assert_eq(field_of_text("A", "a11y_col"), 1, "column 1")
            spec.assert_eq(field_of_text("B", "a11y_col"), 5, "B, moved to column 5, says 5")
        }
        spec.it("scrolling: the same cell widget names the row it shows now") callback {
            v = nth_of("scrollbar", 0)
            uidriver.post_ok("/widget/${v}/set_value?v=0", "scroll to the top")
            spec.assert_true(shows("R0C1") == 1, "row 0 shown")
            spec.assert_eq(field_of_text("R0C1", "a11y_row"), 1, "model row 0 is row 1")
            spec.assert_eq(field_of_text("R2C1", "a11y_row"), 3, "model row 2 is row 3")
        }
    }

    spec.describe(fw, "a cell's style and an editor's starting text") {
        spec.it("cell_style colours a cell from the model") callback {
            spec.assert_str_eq(bg_of("R7C2"), "#ffe0e0", "row 7's column 2: the alarm background")
            spec.assert_str_eq(fstr("R7C2", "fg"), "#b00000", "its text colour")
            spec.assert_str_eq(fstr("R7C2", "fontWeight"), "bold", "bold")
            spec.assert_str_eq(bg_of("R8C2"), "#ffffff", "row 8's is plain")
        }
        spec.it("the selection lies over a styled cell's colour; the cursor is a border") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R7C2")}/click", "click R7C2")
            spec.assert_str_eq(bg_of("R7C2"), "#e5e0ef", "#ffe0e0 and #cce0ff, half and half")
            spec.assert_eq(field_of_text("R7C2", "borderWidth"), 2, "a 2px border")
            spec.assert_str_eq(fstr("R7C2", "borderColor"), "#2f6fd0", "in the cursor's blue")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R8C2")}/click", "click R8C2")
            spec.assert_str_eq(bg_of("R7C2"), "#ffe0e0", "R7C2 is its own colour again")
            spec.assert_eq(field_of_text("R7C2", "borderWidth"), 0, "without the border")
        }
        spec.it("an editor starts with edit_text, the formula, not the value shown") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R9C1")}/double_click", "double-click R9C1")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            uidriver.post_ok("/widget/${editor()}/set_text?v=%3D200%2B34", "type =200+34")
            uidriver.post_ok("/widget/${editor()}/submit", "Return")
            spec.assert_true(shows("234") == 1, "the cell shows the formula's value")
            spec.assert_str_eq(fstr("234", "anchor"), "end", "at the right (cell_style)")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("234")}/double_click", "double-click it again")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), "=200+34", "holding the formula")
            key("Escape")
            spec.assert_true(editor_open(0) == 1, "Escape closed it")
        }
        spec.it("a cell whose style changes is redrawn, however long the two styles") callback {
            // Two long styles a 32-bit djb2 hash wrapped to the same value,
            // so the cell kept the first through any refresh.
            spec.assert_str_eq(bg_of("R10C3"), "#ffebee", "R10C3 starts pink")
            uidriver.post_ok("/widget/${uidriver.widget_id_of("button", "Swap colours")}/click", "Swap colours (refreshes the grid)")
            spec.assert_true(uidriver.wait_body_contains("/widget/${uidriver.widget_id_by_text("R10C3")}", "\"bg\":\"#e8f5e9\"", 20), "and turns green")
            uidriver.post_ok("/widget/${uidriver.widget_id_of("button", "Swap colours")}/click", "and back")
            spec.assert_true(uidriver.wait_body_contains("/widget/${uidriver.widget_id_by_text("R10C3")}", "\"bg\":\"#ffebee\"", 20), "pink again")
        }
    }

    spec.describe(fw, "fit a column to its text") {
        spec.it("a double click on a header's grip fits the column") callback {
            uidriver.post_ok("/widget/${grip_of("A")}/double_click", "double-click A's grip")
            spec.assert_true(uidriver.wait_body_contains("/widgets", "resized: 1 to ", 20), "on_col_resize heard column 1")
            w = header_w("A", 0)
            spec.assert_true(w > 36, "wider than 36 (\"R19C1\" does not fit in 36): ${w}")
            spec.assert_true(w < 120, "but only as wide as its text: ${w}")
            spec.assert_true(shows("resized: 1 to ${w}") == 1, "the width it reported is the header's")
        }
        spec.it("fitting again changes nothing") callback {
            before = header_w("A", 0)
            uidriver.post_ok("/widget/${grip_of("A")}/double_click", "again")
            sleep(300)
            spec.assert_eq(header_w("A", before), before, "the same width")
        }
        spec.it("a squeezed column grows to fit") callback {
            spec.assert_eq(header_w("C", 24), 24, "C was clamped to 24")
            uidriver.post_ok("/widget/${grip_of("C")}/double_click", "double-click C's grip")
            spec.assert_true(uidriver.wait_body_contains("/widgets", "resized: 2 to ", 20), "on_col_resize heard view column 2")
            spec.assert_true(header_w("C", 0) > 36, "C grew")
        }
    }

    spec.describe(fw, "hidden rows and columns") {
        spec.it("hidden rows take no room, and a strip marks where they were") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            spec.assert_true(shows("R4C1") == 1, "row 4 is shown")
            y3 = field_of_text("R3C1", "y")
            spec.assert_eq(settled("R4C1", "y", y3 + 24), y3 + 24, "straight under row 3")
            press("Hide rows 5-6")
            spec.assert_true(gone("R4C1") == 1, "row 4 is not shown")
            spec.assert_true(gone("R5C1") == 1, "nor row 5")
            spec.assert_true(shows("R6C1") == 1, "row 6 is")
            spec.assert_eq(settled("R6C1", "y", y3 + 24 + 3), y3 + 27, "under row 3, below a 3px strip")
            spec.assert_true(shows("row 4 shown is model row 6") == 1, "datagrid_row_model: the fifth row shown is model row 6")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
        spec.it("the keys and a Shift range step over them; callbacks keep model rows") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R3C1")}/click", "click R3C1")
            spec.assert_true(shows("clicked: 3,1") == 1, "the click is model row 3")
            key("Down")
            spec.assert_true(shows("selection: 6,1 from 6,1") == 1, "Down from row 3 is row 6")
            spec.assert_str_eq(bg_of("R6C1"), "#cce0ff", "the cursor is on it")
            key("Shift%2BUp")
            spec.assert_true(shows("selection: 3,1 from 6,1") == 1, "Shift+Up extends back to row 3")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R7C1")}/click", "click R7C1")
            spec.assert_true(shows("clicked: 7,1") == 1, "a click below the hidden rows is its model row")
        }
        spec.it("a hidden column: the next one takes its place, and the keys step over it") callback {
            ax = field_of_text("A", "x")
            aw = header_w("A", 0)
            spec.assert_true(shows("C") == 1, "C is shown")
            press("Hide C")
            spec.assert_true(gone("C") == 1, "C is not")
            spec.assert_eq(settled("D", "x", ax + aw), ax + aw, "D straight after A")
            spec.assert_true(gone("R3C3") == 1, "nor its cells")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R3C1")}/click", "click R3C1")
            key("Right")
            spec.assert_true(shows("selection: 3,3 from 3,3") == 1, "Right from A lands on view column 3, D")
            spec.assert_str_eq(bg_of("R3C4"), "#cce0ff", "the cursor is on D's cell")
            key("Left")
            spec.assert_true(shows("selection: 3,1 from 3,1") == 1, "and Left back on A")
        }
        spec.it("shown again, all is as it was") callback {
            press("Hide C")
            press("Hide rows 5-6")
            spec.assert_true(shows("C") == 1, "C is back")
            spec.assert_true(shows("R4C1") == 1, "and row 4")
            y3 = field_of_text("R3C1", "y")
            spec.assert_eq(settled("R4C1", "y", y3 + 24), y3 + 24, "straight under row 3, no strip")
            spec.assert_true(shows("row 4 shown is model row 4") == 1, "the fifth row shown is model row 4 again")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
    }

    spec.describe(fw, "frozen rows") {
        spec.it("frozen rows stay at the top while the rest scroll") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            y0 = field_of_text("R0C1", "y")
            press("Freeze 2 rows")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=1000", "scroll down")
            spec.assert_true(shows("R1002C1") == 1, "the scrolling rows start at row 1,002")
            spec.assert_true(shows("R0C1") == 1, "row 0 stays")
            spec.assert_true(shows("R1C1") == 1, "and row 1")
            spec.assert_true(gone("R2C1") == 1, "row 2 has scrolled away")
            spec.assert_eq(settled("R0C1", "y", y0), y0, "row 0 where it was")
            spec.assert_eq(settled("R1002C1", "y", y0 + 48), y0 + 48, "row 1,002 under row 1")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
        spec.it("they are drawn as the frozen columns are") callback {
            spec.assert_str_eq(bg_of("R1C3"), "#f2f2f5", "#f2f2f5")
            spec.assert_true(string.contains(str_of_text("R1C3", "classes"), "aui-grid-frozen") == 1, "aui-grid-frozen")
            spec.assert_str_eq(bg_of("R1002C3"), "#ffffff", "a scrolling row is white")
        }
        spec.it("Down from a frozen row goes to the next row, scrolled to") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R1C1")}/click", "click R1C1")
            spec.assert_true(shows("selection: 1,1 from 1,1") == 1, "row 1 selected")
            key("Down")
            spec.assert_true(shows("selection: 2,1 from 2,1") == 1, "Down is row 2")
            spec.assert_true(shows("R2C1") == 1, "scrolled back to show it")
            spec.assert_eq(settled("R2C1", "y", y_of_row1() + 24), y_of_row1() + 24, "under the frozen rows")
        }
        spec.it("unfrozen, row 0 scrolls again") callback {
            press("Freeze 2 rows")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            spec.assert_true(shows("R1C3") == 1, "row 1 shown, in the scrolling rows")
            spec.assert_true(uidriver.wait_body_contains("/widget/${uidriver.widget_id_by_text("R1C3")}", "aui-grid-cell", 20), "R1C3 is a plain cell again")
            spec.assert_str_eq(bg_of("R1C3"), "#ffffff", "white")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=500", "scroll down")
            spec.assert_true(shows("R500C1") == 1, "row 500 at the top")
            spec.assert_true(gone("R0C1") == 1, "row 0 has scrolled away")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "and back")
        }
    }

    spec.describe(fw, "more of a style") {
        spec.it("italic, underline and line-through") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            spec.assert_true(shows("R12C4") == 1, "row 12 shown")
            spec.assert_str_eq(fstr("R12C4", "fontStyle"), "italic", "R12C4 italic")
            spec.assert_str_eq(fstr("R12C4", "textDecoration"), "underline", "and underlined")
            spec.assert_str_eq(fstr("R13C4", "textDecoration"), "line-through", "R13C4 struck through")
            spec.assert_str_eq(fstr("R13C4", "fontStyle"), "normal", "and not italic")
        }
        spec.it("borders on a cell's edges") callback {
            spec.assert_str_eq(fstr("R14C4", "borderTop"), "1 #000000", "a 1px black line on top")
            spec.assert_str_eq(fstr("R14C4", "borderBottom"), "2 #c00000", "a 2px red one underneath")
            spec.assert_str_eq(fstr("R14C4", "borderLeft"), "", "none at the sides")
        }
        spec.it("a data bar, from either edge") callback {
            spec.assert_str_eq(fstr("R15C4", "bar"), "0.50", "half the width from the start")
            spec.assert_str_eq(fstr("R15C4", "barColor"), "#638ec6", "in the colour given")
            spec.assert_str_eq(fstr("R16C4", "bar"), "-0.25", "a quarter from the end")
            spec.assert_str_eq(fstr("R16C4", "barColor"), "#638ec6", "in Excel's blue when none is given")
        }
        spec.it("a comment's corner marker, and its tooltip") callback {
            spec.assert_str_eq(fstr("R17C4", "corner"), "#dd0000", "a red corner")
            spec.assert_str_eq(fstr("R17C4", "tooltip"), "a note on R17C4", "the comment on hover")
            spec.assert_str_eq(fstr("R18C4", "tooltip"), "", "a cell without one has none")
        }
        spec.it("a widget that scrolls on to a plain cell loses them") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=1", "scroll down a row")
            spec.assert_true(shows("R18C4") == 1, "row 18 shown")
            spec.assert_str_eq(fstr("R13C4", "fontStyle"), "normal", "where R12C4 was italic, R13C4 is not")
            spec.assert_str_eq(fstr("R17C4", "bar"), "", "where the bar was, none")
            spec.assert_str_eq(fstr("R18C4", "corner"), "", "nor a corner where the marker was")
            spec.assert_str_eq(fstr("R18C4", "tooltip"), "", "nor a tooltip")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "and back")
        }
    }

    spec.describe(fw, "merged cells") {
        spec.it("a merge is one cell: its top-left's text across it") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            spec.assert_true(shows("R9C5") == 1, "the four cells are shown")
            w4 = field_of_text("R8C4", "w")
            w5 = field_of_text("R8C5", "w")
            x6 = field_of_text("R8C6", "x")
            press("Merge D9:E10")
            spec.assert_true(gone("R8C5") == 1, "R8C5 is part of it")
            spec.assert_true(gone("R9C4") == 1, "R9C4 too")
            spec.assert_true(gone("R9C5") == 1, "and R9C5")
            // Within a pixel: Android reports dp, each width rounded on its own.
            wm = settled("R8C4", "w", w4 + w5)
            spec.assert_true(wm >= w4 + w5 - 1 && wm <= w4 + w5 + 1, "R8C4 across both columns: ${wm} for ${w4} + ${w5}")
            spec.assert_eq(settled("R8C6", "x", x6), x6, "and the next column where it was")
            spec.assert_true(shows("R10C4") == 1, "the row under it as it was")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
        spec.it("a click on it selects all of it, the cursor on its top-left") callback {
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R8C4")}/click", "click the merge")
            spec.assert_true(shows("selection: 8,3 from 9,4") == 1, "the cursor at 8,3, the range to 9,4")
            spec.assert_true(shows("clicked: 8,3") == 1, "the click is its top-left")
            spec.assert_str_eq(bg_of("R8C4"), "#cce0ff", "drawn selected")
        }
        spec.it("the keys step over it, and into it from either side") callback {
            key("Down")
            spec.assert_true(shows("selection: 10,3 from 10,3") == 1, "Down leaves by its bottom edge")
            key("Up")
            spec.assert_true(shows("selection: 8,3 from 9,4") == 1, "Up from below selects all of it")
            key("Right")
            spec.assert_true(shows("selection: 8,5 from 8,5") == 1, "Right leaves by its right edge")
            key("Left")
            spec.assert_true(shows("selection: 8,3 from 9,4") == 1, "Left from beside it selects all of it")
        }
        spec.it("unmerged, its cells are back") callback {
            w4 = header_w("D", 0)
            press("Merge D9:E10")
            spec.assert_true(shows("R8C5") == 1, "R8C5")
            spec.assert_true(shows("R9C4") == 1, "R9C4")
            spec.assert_true(shows("R9C5") == 1, "R9C5")
            spec.assert_eq(settled("R8C4", "w", w4), w4, "R8C4 its column's width again")
        }
    }

    spec.describe(fw, "row heights and wrapped text") {
        spec.it("a taller row: those under it move down, and fewer rows show") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            spec.assert_true(shows("R19C1") == 1, "twenty rows shown")
            y3 = field_of_text("R3C1", "y")
            press("Tall row 4")
            spec.assert_eq(settled("R3C1", "h", 60), 60, "row 3 is 60 tall")
            spec.assert_eq(settled("R4C1", "y", y3 + 60), y3 + 60, "row 4 under it")
            spec.assert_true(gone("R18C1") == 1, "rows 18 and 19 no longer fit")
            spec.assert_true(shows("R17C1") == 1, "row 17 does")
            spec.assert_eq(count_of("text"), 157, "no widgets added")
        }
        spec.it("the last rows are still reached at the end") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=200000", "scroll to the end")
            spec.assert_true(shows("R99999C1") == 1, "the last row")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "and back")
            spec.assert_true(shows("R3C1") == 1, "row 3 again")
        }
        spec.it("a cell styled white-space: normal wraps in a row that holds more than a line") callback {
            id = uidriver.widget_id_by_text("a long note that wraps")
            spec.assert_true(id > 0, "the long note is shown")
            spec.assert_true(uidriver.wait_body_contains("/widget/${id}", "\"wrap\":true", 20), "and wraps")
        }
        spec.it("fitting a row makes it as tall as its text") callback {
            press("Tall row 4")
            spec.assert_eq(settled("R3C1", "h", 24), 24, "back to 24")
            id = uidriver.widget_id_by_text("a long note that wraps")
            spec.assert_true(uidriver.wait_body_contains("/widget/${id}", "\"wrap\":false", 20), "a row one line tall: one line")
            press("Fit row 4")
            fh = settled("R3C1", "h", 0)
            spec.assert_true(fh > 48, "taller than two lines for the wrapped note: ${fh}")
            spec.assert_true(uidriver.wait_body_contains("/widget/${id}", "\"wrap\":true", 20), "and it wraps again")
            press("Tall row 4")
            spec.assert_eq(settled("R3C1", "h", 24), 24, "and back")
        }
    }

    spec.describe(fw, "the editor's text as it is typed") {
        spec.it("on_edit_change hears what an editor opens with, and its caret") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R11C1")}/click", "click R11C1")
            key("equal")
            spec.assert_true(editor_open(1) == 1, "an editor opened holding =")
            spec.assert_true(shows("typing: = @1") == 1, "heard = with the caret after it")
        }
        spec.it("datagrid_edit_insert puts text at the caret, and on_edit_change hears it") callback {
            key("F4")
            spec.assert_true(shows("typing: =A1 @3") == 1, "=A1, the caret after the reference")
            spec.assert_str_eq(uidriver.widget_text_by_id(editor()), "=A1", "the editor holds it")
        }
        spec.it("typing is heard too") callback {
            uidriver.post_ok("/widget/${editor()}/set_text?v=%3DSUM(A1", "type =SUM(A1")
            spec.assert_true(uidriver.wait_body_contains("/widgets", "typing: =SUM(A1 @", 20), "heard =SUM(A1")
            key("Escape")
            spec.assert_true(editor_open(0) == 1, "Escape closed it")
        }
        spec.it("an editor opened from on_select while datagrid_edit moves the cursor: one editor, and none once it closes") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R0C1")}/click", "click R0C1")
            press("Edit R6C2 twice")
            spec.assert_true(editor_open(1) == 1, "an editor opened")
            spec.assert_eq(count_of("textfield"), 2, "Notes and one editor, not two")
            key("Escape")
            spec.assert_true(editor_open(0) == 1, "Escape closed it")
            spec.assert_eq(count_of("textfield"), 1, "and none is left over the grid")
        }
    }
    spec.describe(fw, "the selection's glide") {
        spec.it("datagrid_selection_glide: the cursor's box passes the cells between, then rests on the new one; 0 jumps") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 1)}/set_value?v=0", "and the left")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R0C1")}/click", "click R0C1")
            spec.assert_true(boxed_on("R0C1") == 1, "the box on R0C1")
            press("Glide")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R0C5")}/click", "click R0C5")
            // Polled until the box is on a cell between, or has come to rest
            // on R0C5 without passing one (the glide is the demo's 1500 ms).
            between = 0
            rested = 0
            k = 0
            while k < 300 && between == 0 && rested == 0 {
                b = boxed()
                if string.equals(b, "R0C2") == 1 || string.equals(b, "R0C3") == 1 || string.equals(b, "R0C4") == 1 { between = 1 }
                if string.equals(b, "R0C5") == 1 { rested = 1 }
                sleep(10)
                k = k + 1
            }
            spec.assert_eq(between, 1, "it passed a cell between on its way")
            spec.assert_true(boxed_on("R0C5") == 1, "and rests on R0C5")
            press("Glide")
            uidriver.post_ok("/widget/${uidriver.widget_id_by_text("R0C1")}/click", "click R0C1")
            spec.assert_true(string.equals(boxed(), "R0C1") == 1, "off: it is there at once")
        }
    }
    spec.describe(fw, "a picture in a cell") {
        spec.it("datagrid_cell_picture: an image over R2C5, fitted to it, and gone again") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            uidriver.post_ok("/widget/${nth_of("scrollbar", 1)}/set_value?v=0", "and the left")
            n0 = count_of("image")
            press("Picture")
            i = 0
            while i < 30 && count_of("image") == n0 { sleep(100); i = i + 1 }
            spec.assert_eq(count_of("image"), n0 + 1, "an image")
            img = uidriver.widget_id_last_of("image", "")
            cell = uidriver.widget_id_by_text("R2C5")
            spec.assert_eq(uidriver.widget_int_field_by_id(img, "x"), uidriver.widget_int_field_by_id(cell, "x"), "over R2C5")
            spec.assert_true(uidriver.widget_int_field_by_id(img, "w") <= uidriver.widget_int_field_by_id(cell, "w") + 1, "within it")
            press("Picture")
            i = 0
            while i < 30 && count_of("image") != n0 { sleep(100); i = i + 1 }
            spec.assert_eq(count_of("image"), n0, "gone again")
        }
    }
    spec.describe(fw, "the grid's own row height") {
        spec.it("datagrid_set_row_heights: every row that height, and back") callback {
            uidriver.post_ok("/widget/${nth_of("scrollbar", 0)}/set_value?v=0", "scroll to the top")
            c = uidriver.widget_id_by_text("R1C1")
            h0 = uidriver.widget_int_field_by_id(c, "h")
            press("Rows 36")
            i = 0
            while i < 30 && uidriver.widget_int_field_by_id(c, "h") == h0 { sleep(100); i = i + 1 }
            spec.assert_eq(uidriver.widget_int_field_by_id(c, "h"), 36, "R1C1 36 high")
            press("Rows 36")
            i = 0
            while i < 30 && uidriver.widget_int_field_by_id(c, "h") != h0 { sleep(100); i = i + 1 }
            spec.assert_eq(uidriver.widget_int_field_by_id(c, "h"), h0, "and back")
        }
    }
    spec.describe(fw, "the column headers") {
        spec.it("datagrid_show_header hides the header row and shows it again") callback {
            // The rows' top (the scrollbar's) below the caption over the
            // grid: on a phone the demo is taller than the screen, and the
            // views Auto Layout squeezed take back some of what the header
            // gives up, so the screen position alone moves only part of it.
            v = nth_of("scrollbar", 0)
            cap = uidriver.widget_id_by_text("100,000 rows x 50 columns")
            d0 = below(v, cap)
            press("Headers")
            i = 0
            while i < 30 && d0 - below(v, cap) < 20 { sleep(100); i = i + 1 }
            d1 = below(v, cap)
            spec.assert_true(d0 - d1 >= 20, "hidden: the rows move up into its place (${d0} to ${d1} below the caption)")
            press("Headers")
            i = 0
            while i < 30 && below(v, cap) != d0 { sleep(100); i = i + 1 }
            spec.assert_eq(below(v, cap), d0, "shown again")
        }
    }
    spec.describe(fw, "a grid given less or more height") {
        spec.it("datagrid_set_height shows the rows that fit, and all of them again") callback {
            v = nth_of("scrollbar", 0)
            h0 = uidriver.widget_int_field_by_id(v, "h")
            press("Ten rows high")
            i = 0
            while i < 30 && uidriver.widget_int_field_by_id(v, "h") == h0 { sleep(100); i = i + 1 }
            spec.assert_eq(uidriver.widget_int_field_by_id(v, "h"), 240, "the scrollbar ten rows high")
            spec.assert_true(cell_texts() <= 60, "at most ten rows of six cells say anything (${cell_texts()})")
            press("All rows high")
            i = 0
            while i < 30 && uidriver.widget_int_field_by_id(v, "h") != h0 { sleep(100); i = i + 1 }
            spec.assert_eq(uidriver.widget_int_field_by_id(v, "h"), h0, "and back to all twenty")
            spec.assert_true(cell_texts() > 60, "more rows of cells again (${cell_texts()})")
        }
    }

    spec.describe(fw, "columns frozen at run time") {
        spec.it("datagrid_freeze_cols keeps A beside the row numbers as the rest scroll") callback {
            hs = nth_of("scrollbar", 1)
            uidriver.post_ok("/widget/${hs}/set_value?v=0", "scroll to the left")
            press("Freeze A")
            uidriver.post_ok("/widget/${hs}/set_value?v=20", "scroll right")
            spec.assert_true(shows("V") == 1, "the scrolling columns moved on (V)")
            spec.assert_true(shows("A") == 1, "A stayed")
            spec.assert_true(gone("B") == 1, "B scrolled away")
            spec.assert_true(field_of_text("A", "x") < field_of_text("V", "x"), "A left of them")
            press("Free A")
            uidriver.post_ok("/widget/${hs}/set_value?v=0", "scroll back")
            spec.assert_true(shows("B") == 1, "free again: B back beside A")
        }
    }

    return spec.run_summary(fw)
}
