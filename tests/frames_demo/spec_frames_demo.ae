import aeocha
import uidriver
import std.string

main() {
    fw = aeocha.init()
    uidriver.wait_server()

    aeocha.describe(fw, "ui.frames retained harness") {
        aeocha.it("starts with two overlapping frames and topmost hit") callback {
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "\"canvas\"", "has a canvas")
            aeocha.assert_contains(body, "bounds: alpha=60,60,460,320 beta=180,110,500,360",
                "initial frame bounds")
            aeocha.assert_contains(body, "z: alpha=0 beta=1", "beta starts above alpha")
            aeocha.assert_contains(body, "hit: Beta at 200,130", "overlap hit is topmost")
        }

        aeocha.it("reports last repaint area and replay command count") callback {
            // Drive one real paint first. Under AETHER_UI_HEADLESS=1 (which
            // spec_matrix.sh exports on win32 and macOS) the window never
            // maps, so no WM_PAINT/draw arrives on its own and the metrics
            // sit at 0/0/0/0 — the counters report what canvas_paint
            // recorded on its LAST run, so with no run there is nothing to
            // read. GET /screenshot forces one paint through the same
            // painter, making these assertions hold mapped or unmapped.
            _ = uidriver.get_body("/screenshot")
            sleep(120)
            area = uidriver.canvas_debug_area()
            cmds = uidriver.canvas_debug_commands()
            w = uidriver.canvas_debug_w()
            h = uidriver.canvas_debug_h()
            aeocha.assert_gt(area, 0, "last repaint area is positive")
            aeocha.assert_eq(area, w * h,
                "immediate mode repaints the whole canvas (${w}x${h})")
            aeocha.assert_gt(cmds, 20, "cube payload emits a non-trivial command stream")
        }

        aeocha.it("reports current frame composite work") callback {
            // Drive a paint with a CLICK on empty canvas, not /screenshot.
            // On macOS (and win32) /screenshot takes the headless
            // canvas_write_png route, which renders the command buffer
            // without running the painter -- the composite counters never
            // advance and this reads one paint however many times it is
            // called. A click goes through the normal repaint path on every
            // backend. Measured on the .160 VM: two /screenshot calls left
            // paints=1, two clicks gave paints=2 then 3.
            uidriver.click(900.0, 600.0)
            sleep(120)
            body = uidriver.get_body("/widgets")
            // Alpha and Beta both animate and invalidate every tick; Gamma
            // holds no payload, so once painted it stays valid. These are the
            // numbers the SHIPPING app reports -- there is deliberately no
            // test-only frame configuration, because an assertion that only
            // holds under a spec env var proves nothing about what users run.
            aeocha.assert_contains(body, "composite: rerender=2 blit=1",
                "animating frames re-render while the static frame would blit")
        }

        aeocha.it("keeps a static frame valid across repeated paints") callback {
            // Validity must PERSIST. One paint proving blit=1 could be a frame
            // that happens to be valid once; the point of the cache is that it
            // stays valid while nothing touches it.
            // Two REAL paints (see the note above on /screenshot).
            uidriver.click(900.0, 600.0)
            sleep(120)
            uidriver.click(900.0, 600.0)
            sleep(120)
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "composite: rerender=2 blit=1",
                "static frame stays valid over successive paints")
        }

        // ── Stage 3 acceptance ────────────────────────────────────────
        // THE claim from docs/design/stage3-per-frame-surfaces.md: with a
        // frame that does not animate, that frame re-renders ZERO times
        // beyond its first paint while the animating ones re-render every
        // paint. Today every frame is drawn inline on every paint and Gamma
        // is merely COUNTED as a blit, so its pixels are still produced from
        // scratch each time. This test is expected to FAIL until per-frame
        // surfaces exist -- that failure is the point, and per the design
        // note it must be demonstrated before the fix lands.
        aeocha.it("static frame is drawn once, not once per paint") callback {
            // Force several paints, then read the app's own count of how many
            // times Gamma's content callback actually RAN. That counts pixels
            // being produced, so no bookkeeping in frames_draw can fake it --
            // unlike the blit tally, which already reads 1 today.
            uidriver.click(900.0, 600.0)
            sleep(60)
            uidriver.click(900.0, 600.0)
            sleep(60)
            uidriver.click(900.0, 600.0)
            sleep(60)
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "gdraw=1",
                "static frame content produced once, however many paints occur")
        }

        aeocha.it("moving a frame does not invalidate it") callback {
            // The design's least-certain claim, and the whole saving: a
            // dragged frame's PIXELS are unchanged, only its position is.
            // Bake this in now, before surfaces depend on it.
            uidriver.click(700.0, 420.0)
            uidriver.move_to(720.0, 440.0)
            uidriver.post_ok("/canvas/1/release?x=720&y=440", "canvas release")
            _ = uidriver.get_body("/screenshot")
            sleep(120)
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "composite: rerender=2 blit=1",
                "a moved frame is still blittable")
        }

        aeocha.it("clicking alpha raises it above beta") callback {
            uidriver.click(80.0, 70.0)
            body = uidriver.get_body("/widgets")
            // alpha=2, not 1: the static Gamma frame took a Z slot when it
            // was added, so raising Alpha puts it above Gamma as well as Beta.
            aeocha.assert_contains(body, "z: alpha=2 beta=0", "alpha raised")
            aeocha.assert_contains(body, "hit: Alpha at 80,70", "click hit alpha")
        }

        aeocha.it("title-bar drag moves the raised frame") callback {
            uidriver.click(80.0, 70.0)
            uidriver.move_to(140.0, 100.0)
            _ = uidriver.get_body("/screenshot")
            sleep(120)
            area = uidriver.canvas_debug_area()
            w = uidriver.canvas_debug_w()
            h = uidriver.canvas_debug_h()
            // What the repaint area SHOULD be depends on whether this
            // backend can clip safely, so ask the app rather than assuming.
            // Only GTK4 retains a paint surface (Stage 2.5); win32 and macOS
            // rebuild theirs per paint, so frames_demo gates clipping OFF
            // there and a full-canvas repaint is the CORRECT answer, not a
            // failure. See docs/design/retained-compositor.md Stage 2.5b.
            clipping = uidriver.get_body("/widgets")
            honest = 0
            if string.contains(clipping, "clip: on/clipped") == 1 { honest = 1 }
            if string.contains(clipping, "clip: on/full") == 1 { honest = 1 }
            if string.contains(clipping, "clip: off") == 1 { honest = 1 }
            aeocha.assert_eq(honest, 1,
                "clip readout reports observed paint mode")
            if string.contains(clipping, "clip: on/clipped") == 1 {
                aeocha.assert_gt(area, 50000, "dirty clip covers old and new frame bounds")
                aeocha.assert_true(area < w * h, "dirty clip is much smaller than the canvas")
            } else {
                aeocha.assert_eq(area, w * h,
                    "reported full paint covers the canvas")
            }
            uidriver.post_ok("/canvas/1/release?x=140&y=100", "canvas release")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "bounds: alpha=120,90,460,320",
                "alpha moved by drag delta")
        }

        aeocha.it("bottom-right gripper resizes with minimums enforced") callback {
            uidriver.click(575.0, 405.0)
            uidriver.move_to(625.0, 445.0)
            uidriver.post_ok("/canvas/1/release?x=625&y=445", "canvas release")
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "bounds: alpha=120,90,510,360",
                "alpha resized by gripper delta")
        }

        aeocha.it("close box removes a frame from hit testing") callback {
            uidriver.click(616.0, 100.0)
            body = uidriver.get_body("/widgets")
            aeocha.assert_contains(body, "z: alpha=-1 beta=0", "alpha closed")
            uidriver.click(200.0, 130.0)
            body2 = uidriver.get_body("/widgets")
            aeocha.assert_contains(body2, "hit: Beta at 200,130", "closed alpha no longer hits")
        }
    }
    aeocha.run_summary(fw)
}
