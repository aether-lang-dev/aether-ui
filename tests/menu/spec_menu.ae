// spec_menu.ae — drives the native menu bar over the AetherUIDriver.
// Proves ui.menu: the bar's menus + item labels are exposed (GET /menus),
// and activating an item fires its REAL closure — the same one the native
// GTK4 GAction (GtkPopoverMenuBar), macOS NSMenu, and win32 menu run — with
// the effect observable in the app body (a bound counter that the File/Edit
// items bump).
//
// Run via ci.sh / spec_matrix, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/menu/bin/menu &
//   UI_SPEC=menu/spec_menu tests/run_spec.sh
import std.spec
import uidriver
import std.string

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "menu bar over AetherUIDriver") {
        spec.it("the bar exposes File/Edit/Help with their items") callback {
            b = uidriver.menus_body()
            // The File menu's items are recorded in declaration order.
            spec.assert_contains(b, "\"New\"", "File → New present")
            spec.assert_contains(b, "\"Open...\"", "File → Open present")
            spec.assert_contains(b, "\"Save\"", "File → Save present")
            spec.assert_contains(b, "\"Quit\"", "File → Quit present")
            spec.assert_contains(b, "\"Undo\"", "Edit → Undo present")
            spec.assert_contains(b, "\"About\"", "Help → About present")
            // Each item resolves to a menu handle.
            fh = uidriver.menu_handle_with("New")
            spec.assert_gt(fh, 0, "the File menu has a handle")
        }

        spec.it("activating File → New fires its closure (counter bumps)") callback {
            // Counter starts at 0.
            b0 = uidriver.get_body("/widgets")
            spec.assert_contains(b0, "Actions taken: 0", "counter starts at 0")
            fh = uidriver.menu_handle_with("New")
            uidriver.menu_activate(fh, "New")
            ok = uidriver.wait_body_contains("/widgets", "Actions taken: 1", 20)
            spec.assert_true(ok, "New's closure ran — counter is 1")
        }

        spec.it("a second item on the same menu also fires") callback {
            fh = uidriver.menu_handle_with("Save")
            uidriver.menu_activate(fh, "Save")
            ok = uidriver.wait_body_contains("/widgets", "Actions taken: 2", 20)
            spec.assert_true(ok, "Save's closure ran — counter is 2")
        }

        spec.it("Edit → Undo runs its (decrementing) closure") callback {
            eh = uidriver.menu_handle_with("Undo")
            spec.assert_gt(eh, 0, "the Edit menu has a handle")
            uidriver.menu_activate(eh, "Undo")
            ok = uidriver.wait_body_contains("/widgets", "Actions taken: 1", 20)
            spec.assert_true(ok, "Undo's closure ran — counter back to 1")
        }

        // The DECLARATIVE menu scope: the Help menu is built with the menu as
        // ambient context (`menu("Help") { item("About") … }`) rather than by
        // repeating the handle on every line. This asserts the scope resolved
        // -- both items reached the right menu with nothing passed to them.
        spec.it("a DECLARED menu carries its items") callback {
            b = uidriver.get_body("/menus")
            spec.assert_contains(b, "\"About\"", "declared item present")
            spec.assert_contains(b, "\"Shortcuts\"",
                "the second declared item is on the SAME menu")
        }

        // NATIVE activation: through the item's own toolkit binding (GTK4's
        // GAction), not the label side-store the specs above use. GTK4 named
        // actions by index-within-section, so "Actual Size" (first item after
        // the separator) and "Zoom +" (first item of the menu) shared one
        // action and one of them ran the other's closure. Both sides of the
        // separator are checked so it fails whichever registration wins.
        spec.it("natively, the item BEFORE a separator runs its own closure") callback {
            vh = uidriver.menu_handle_with("Actual Size")
            spec.assert_gt(vh, 0, "the View menu has a handle")
            st = uidriver.menu_native_activate(vh, "Zoom +")
            if st != 501 {
                spec.assert_eq(st, 200, "Zoom + activated natively")
                ok = uidriver.wait_body_contains("/widgets", "Actions taken: 500", 20)
                spec.assert_true(ok, "Zoom +'s closure ran (500), not Actual Size's")
            }
        }

        spec.it("natively, the item AFTER a separator runs its own closure") callback {
            vh = uidriver.menu_handle_with("Actual Size")
            st = uidriver.menu_native_activate(vh, "Actual Size")
            if st != 501 {
                spec.assert_eq(st, 200, "Actual Size activated natively")
                ok = uidriver.wait_body_contains("/widgets", "Actions taken: 700", 20)
                spec.assert_true(ok, "Actual Size's closure ran (700), not Zoom +'s")
            }
        }

        // The label route decodes its query: a space arrives as '+', a
        // literal plus as %2B. Undecoded, neither label matched any item.
        spec.it("a label with a literal '+' activates by label") callback {
            vh = uidriver.menu_handle_with("Zoom +")
            uidriver.menu_activate(vh, "Zoom +")
            ok = uidriver.wait_body_contains("/widgets", "Actions taken: 500", 20)
            spec.assert_true(ok, "Zoom +'s closure ran via label=Zoom+%2B")
        }

        spec.it("a label with a space activates by label") callback {
            vh = uidriver.menu_handle_with("Actual Size")
            uidriver.menu_activate(vh, "Actual Size")
            ok = uidriver.wait_body_contains("/widgets", "Actions taken: 700", 20)
            spec.assert_true(ok, "Actual Size's closure ran via label=Actual+Size")
            st = uidriver.post_status("/menu/${vh}/activate?label=Actual%20Size")
            spec.assert_eq(st, 200, "the %20 spelling of a space resolves too")
        }

        spec.it("an unknown label still answers 404") callback {
            vh = uidriver.menu_handle_with("Actual Size")
            st = uidriver.post_status("/menu/${vh}/activate?label=No+Such+Item")
            spec.assert_eq(st, 404, "no such item")
        }
    }
    return spec.run_summary(fw)
}
