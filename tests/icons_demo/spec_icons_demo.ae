// spec_icons_demo.ae — vector icons render as real widgets.
//
// Icons are drawn with vg, so each one is a CANVAS in the widget tree —
// which is exactly what makes them assertable without pixel-diffing: the
// canvases are there, sized as asked, alongside the labels they annotate.
// The path data is queryable too (icon_path), so the demo publishes a
// length the spec pins — geometry that changes shape fails the test.
//
// Run via ci.sh Phase 5 / tests/spec_matrix.sh, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/icons_demo/bin/icons_demo &
//   UI_SPEC=icons_demo/spec_icons_demo tests/run_spec.sh
import std.spec
import uidriver
import std.string

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "icons_demo over AetherUIDriver") {
        spec.it("draws every icon as a real widget") callback {
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "\"canvas\"", "icons are canvases")
            // 8 in the vocabulary row + 1 search + 3 sizes = 12 canvases.
            n = count_canvases(body)
            spec.assert_eq(n, 12, "one canvas per icon")
        }

        spec.it("icons compose with the controls they annotate") callback {
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "\"textfield\"", "search row has its field")
            spec.assert_gt(uidriver.widget_id_of("button", "Favourites"), 0,
                "chip button present")
            // The chip keeps the pill styling from the border/hover layers.
            spec.assert_contains(body, "\"borderWidth\":1", "chip is an outline")
            spec.assert_contains(body, "\"hoverBg\"", "chip reacts to hover")
        }

        spec.it("the same icon renders at several sizes") callback {
            // Three hearts at 12/20/32. The canvases WIDEN to fill their
            // hstack (that is the layout doing its job), so height is the
            // honest size signal: the row is as tall as the largest icon.
            // Canvas geometry is laid out by the backend (win32 sizes rows
            // differently from GTK4), so assert the COUNT — three separate
            // canvases for three sizes — not specific pixel dimensions.
            body = uidriver.get_body("/widgets")
            n = count_canvases(body)
            spec.assert_eq(n, 12, "all three sizes are separate canvases")
        }

        spec.it("icon path data is queryable geometry") callback {
            // The heart's 24-grid path, published by the app. Pinning the
            // length catches a silently-changed or emptied glyph.
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "heart path length: 97", "heart geometry intact")
        }
    }
    return spec.run_summary(fw)
}

count_canvases(body: string) -> int {
    n = 0
    at = 0
    while at >= 0 {
        at = string.string_index_of_from(body, "\"type\":\"canvas\"", at)
        if at < 0 { return n }
        n = n + 1
        at = at + 10
    }
    return n
}
