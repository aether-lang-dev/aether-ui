// spec_undo_demo.ae — Undo/Redo (the Swing UndoManager shape) over the
// AetherUIDriver. undoable() records real do/undo pairs; the spec steps
// the SAME stack the app's buttons and Primary+Z (Cmd/Ctrl) use, via POST /undo,
// POST /redo, GET /undo_state — and asserts effects from widget text.
import std.spec
import uidriver
import std.string

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "undo manager over AetherUIDriver") {
        spec.it("starts with an empty stack") callback {
            b = uidriver.get_body("/undo_state")
            spec.assert_contains(b, "\"undo_depth\":0", "no undoable edits yet")
            spec.assert_contains(b, "\"redo_depth\":0", "no redoable edits yet")
        }

        spec.it("undoable() runs the action and records it") callback {
            a = uidriver.widget_id_by_text("Add 5")
            uidriver.post_ok("/widget/${a}/click", "add 5")
            uidriver.post_ok("/widget/${a}/click", "add 5 again")
            ok = uidriver.wait_body_contains("/widgets", "total: 10", 20)
            spec.assert_true(ok, "both actions ran")
            b = uidriver.get_body("/undo_state")
            spec.assert_contains(b, "\"undo_depth\":2", "two edits recorded")
            spec.assert_contains(b, "\"label\":\"add 5\"", "next undo is labelled")
        }

        spec.it("POST /undo reverts; /redo reapplies") callback {
            r = uidriver.post_body("/undo")
            spec.assert_contains(r, "\"did\":1", "undo stepped")
            ok = uidriver.wait_body_contains("/widgets", "total: 5", 20)
            spec.assert_true(ok, "undo reverted the counter")
            b = uidriver.get_body("/undo_state")
            spec.assert_contains(b, "\"redo_depth\":1", "one edit redoable")
            r2 = uidriver.post_body("/redo")
            spec.assert_contains(r2, "\"did\":1", "redo stepped")
            ok2 = uidriver.wait_body_contains("/widgets", "total: 10", 20)
            spec.assert_true(ok2, "redo reapplied")
        }

        spec.it("a new edit truncates the redo tail (the classic rule)") callback {
            _u1 = uidriver.post_body("/undo")
            ren = uidriver.widget_id_by_text("Rename")
            uidriver.post_ok("/widget/${ren}/click", "rename")
            ok = uidriver.wait_body_contains("/widgets", "name: Ripley", 20)
            spec.assert_true(ok, "rename ran")
            b = uidriver.get_body("/undo_state")
            spec.assert_contains(b, "\"redo_depth\":0", "redo tail truncated")
            spec.assert_contains(b, "\"label\":\"rename\"", "rename is next undo")
        }

        // enable_undo_shortcuts registers Primary+Z: the platform's command
        // key, Cmd on macOS/iOS and Ctrl on GTK4/Win32 (toolkit-envy G2).
        // It used to register Ctrl+Z, so undo on a Mac was Control-Z.
        spec.it("the OTHER platform's undo key is inert") callback {
            b = uidriver.get_body("/widgets")
            mac = string.contains(b, "backend: macos") + string.contains(b, "backend: uikit")
            other = "Cmd%2BZ"
            if mac > 0 { other = "Ctrl%2BZ" }
            _k = uidriver.post_body("/window/key?combo=${other}")
            ok = uidriver.wait_body_contains("/widgets", "name: Ellen", 5)
            spec.assert_false(ok, "the non-platform key did not undo the rename")
            st = uidriver.get_body("/undo_state")
            spec.assert_contains(st, "\"label\":\"rename\"", "rename is still next undo")
        }

        spec.it("the platform's undo key (Primary+Z) routes to undo") callback {
            b = uidriver.get_body("/widgets")
            mac = string.contains(b, "backend: macos") + string.contains(b, "backend: uikit")
            mine = "Ctrl%2BZ"
            if mac > 0 { mine = "Cmd%2BZ" }
            k = uidriver.post_body("/window/key?combo=${mine}")
            spec.assert_contains(k, "\"fired\":true", "shortcut handled")
            ok = uidriver.wait_body_contains("/widgets", "name: Ellen", 20)
            spec.assert_true(ok, "the platform's undo key undid the rename")
        }
    }
    return spec.run_summary(fw)
}
