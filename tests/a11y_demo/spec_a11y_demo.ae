// spec_a11y_demo.ae — drives the accessibility example over the AetherUIDriver.
// Proves the semantics layer (roadmap: Accessibility):
//   * native widgets carry a11y for FREE — a plain button reports role
//     "button" and its label as the accessible name, with nothing set;
//   * a11y_label OVERRIDES the auto name — an icon-only button reports the
//     supplied name (not its glyph), plus a11y_description;
//   * a11y_role tags a plain text as a "heading";
//   * listbox rows are auto-tagged "listitem" (built-in a11y);
//   * a11y_announce reaches the platform and is read back (announced, a count).
//
// The values are read back from the REAL backend accessible state:
// GET /widget/{id}/a11y → {role,name,description}. GTK4 sets them via
// gtk_accessible_update_property; win32 via MSAA Dynamic Annotation; macOS via
// NSAccessibility. See docs/design/accessibility.md.
//
// Run via ci.sh, or by hand:
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/a11y_demo/bin/a11y_demo &
//   UI_SPEC=a11y_demo/spec_a11y_demo tests/run_spec.sh
import std.spec
import uidriver
import std.string
import std.json

// The row hstack containing label `txt` (rows carry no text of their own).
row_of(txt: string) -> int {
    lbl = uidriver.widget_id_by_text(txt)
    if lbl == 0 { return 0 }
    return uidriver.widget_int_field_by_id(lbl, "parent")
}

main() {
    fw = spec.init()
    uidriver.wait_server()

    spec.describe(fw, "accessibility semantics over AetherUIDriver") {
        spec.it("a plain button gets role+name for free") callback {
            b = uidriver.widget_id_by_text("Save")
            spec.assert_gt(b, 0, "Save button found")
            r = uidriver.get_body("/widget/${b}/a11y")
            spec.assert_contains(r, "\"role\":\"button\"", "auto role is button")
            spec.assert_contains(r, "\"name\":\"Save\"", "auto name is the label")
        }

        spec.it("a11y_label overrides the accessible name (icon button)") callback {
            g = uidriver.widget_id_by_text("⚙")
            spec.assert_gt(g, 0, "gear button found")
            r = uidriver.get_body("/widget/${g}/a11y")
            spec.assert_contains(r, "\"name\":\"Settings\"", "name is the override, not the glyph")
            spec.assert_contains(r, "\"description\":\"Open the settings panel\"",
                "description is set")
        }

        spec.it("a11y_announce on a grid's box and on a canvas, as on a button") callback {
            uidriver.click_widget(uidriver.widget_id_by_text("Announce on the grid"))
            gb = uidriver.widget_int_field_by_id(uidriver.widget_id_by_text("a grid"), "parent")
            spec.assert_contains(uidriver.get_body("/widget/${gb}/a11y"), "\"announced\":\"Grid said\"", "the grid's")
            // From a canvas that has the keyboard focus, as a vg scene being
            // played from the keyboard is: GTK realizes a focused widget's
            // AT context, and with no AT-SPI bus (a test box) that context
            // is GtkTestATContext, whose missing announce hook GTK 4.22
            // called -- the app died on the call.
            cv = uidriver.widget_id_of("canvas", "")
            spec.assert_gt(cv, 0, "the canvas is there")
            uidriver.focus_widget(cv)
            uidriver.click_widget(uidriver.widget_id_by_text("Announce on the canvas"))
            spec.assert_true(uidriver.wait_body_contains("/widgets", "\"type\":\"button\"", 10), "still answering")
            spec.assert_contains(uidriver.get_body("/widget/${cv}/a11y"), "\"announced\":\"Canvas said\"", "the canvas's, read back")
        }

        spec.it("a11y_announce: the screen reader is told, and the driver reads it back") callback {
            g = uidriver.widget_id_by_text("⚙")
            r0 = uidriver.get_body("/widget/${g}/a11y")
            spec.assert_contains(r0, "\"announcements\":0", "none before")
            uidriver.click_widget(uidriver.widget_id_by_text("Announce"))
            r1 = uidriver.get_body("/widget/${g}/a11y")
            spec.assert_contains(r1, "\"announced\":\"Settings saved\"", "the announcement")
            spec.assert_contains(r1, "\"announcements\":1", "one")
            uidriver.click_widget(uidriver.widget_id_by_text("Announce"))
            r2 = uidriver.get_body("/widget/${g}/a11y")
            spec.assert_contains(r2, "\"announcements\":2", "a repeat counted")
            spec.assert_contains(r2, "\"name\":\"Settings\"", "its name unchanged")
        }

        spec.it("a wrap of buttons is a group, not a grid: only the demo's own grid says grid") callback {
            w = uidriver.widget_id_of("wrap", "")
            spec.assert_gt(w, 0, "the wrap is there")
            spec.assert_true(string.contains(uidriver.get_body("/widget/${w}/a11y"), "\"role\":\"grid\"") == 0, "the wrap is not a grid: ${uidriver.get_body("/widget/${w}/a11y")}")
            v, _je = json.parse(uidriver.get_body("/widgets"))
            grids = 0
            i = 0
            while v != null && i < json.json_array_size(v) {
                if string.equals(uidriver.field_str(json.json_array_get_raw(v, i), "role"), "grid") == 1 { grids = grids + 1 }
                i = i + 1
            }
            json.json_free(v)
            spec.assert_eq(grids, 1, "one widget says grid: the demo's own")
        }

        spec.it("a11y_role tags a text as a heading") callback {
            t = uidriver.widget_id_by_text("Accessibility demo")
            spec.assert_gt(t, 0, "title text found")
            r = uidriver.get_body("/widget/${t}/a11y")
            spec.assert_contains(r, "\"role\":\"heading\"", "title reports heading role")
        }

        spec.it("listbox rows are auto-tagged listitem") callback {
            row = row_of("Beta")
            spec.assert_gt(row, 0, "row of Beta found")
            r = uidriver.get_body("/widget/${row}/a11y")
            spec.assert_contains(r, "\"role\":\"listitem\"", "each row is a listitem")
        }

        spec.it("a toggle's own label is its accessible name") callback {
            body = uidriver.get_body("/widgets")
            spec.assert_contains(body, "\"a11y_name\":\"Notify me\"", "the toggle is named by its label")
        }

        spec.it("role + a11y_name also surface in /widgets") callback {
            b = uidriver.widget_id_by_text("Save")
            body = uidriver.get_body("/widgets")
            // The buffer is large; just assert the button's a11y fields appear.
            spec.assert_contains(body, "\"a11y_name\":\"Settings\"",
                "the gear's override name is in /widgets")
            spec.assert_contains(body, "\"role\":\"heading\"",
                "the heading role is in /widgets")
        }
    }
    return spec.run_summary(fw)
}
