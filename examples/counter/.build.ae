// counter — aether-ui toolkit example, built as its own cached aeb node.
import bldr
import aether
import aether (source, output, no_closure_regen)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("counter.ae")          // sibling source in this module dir
            output("counter")
            no_closure_regen()
            ui_backend(root)              // import aether_ui resolves via AEB_COMPILE_LIB (repo root)
        }
        return 0
    }
}
