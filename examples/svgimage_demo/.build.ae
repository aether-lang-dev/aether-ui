// svgimage_demo: aether-ui toolkit example. Needs the vg module tree (the SVG
// parser and rasteriser live there), hence lib("${root}") as the vg apps do.
import bldr
import aether
import aether (source, output, no_closure_regen, lib)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("svgimage_demo.ae")
            output("svgimage_demo")
            lib("${root}")
            no_closure_regen()
            ui_backend(root)
        }
        return 0
    }
}
