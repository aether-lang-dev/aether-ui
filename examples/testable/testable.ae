// Aether UI testable app — enables the AetherUIDriver.
//
// Build and run:
//   ./build.sh examples/testable/testable.ae
//   ./build/perry_testable &
//   # Then run the test script:
//   ./test_automation.sh

import ui
// Opt in to chrome-drawn control faces: inert unless AETHER_UI_CHROME=drawn
// (the chromeparity/chromeproof suites set it; the native suites do not).
import ui.chromed
import std.mem

extern println(s: string)
extern malloc(size: int) -> ptr

main() {
    chromed.enable()
    counter = ui.ui_state(0)

    ui.window("Testable App", 400, 400) {
    root = ui.vstack(10) {
        ui.text("Testable App")
        ui.divider()
        ui.text_bound(counter, "Count: ", "")

        ui.hstack(5) {
            ui.btn("+1") callback {
                ui.ui_set(counter, ui.ui_get(counter) + 1)
            }
            ui.btn("-1") callback {
                ui.ui_set(counter, ui.ui_get(counter) - 1)
            }
        }

        ui.divider()

        ui.textfield("Type here...") callback |val: string| {
            println("Input: ${val}")
        }

        ui.toggle("Accept terms") callback |active: int| {
            println("Terms: ${active}")
        }

        // Shortcuts (item 9): Ctrl+B bumps the counter by 10 — proves the
        // accelerator fires regardless of focus (the spec focuses the
        // entry first). Plain "b" must NOT fire it.
        ui.shortcut("Ctrl+B") callback {
            _sc = ui.ui_set(counter, ui.ui_get(counter) + 10)
        }

        // Canvas key-down/key-up + the ptr blit, for spec_driver_actions.
        // The status label DISAMBIGUATES the two key verbs: if /keyup ever
        // routed into the on_key handler (the wired-to-the-wrong-handler
        // hazard this suite exists for) the label would read "down:" again
        // and the spec's wait for "up:" would fail.
        kstatus = ui.text("keys: idle")
        cv = ui.canvas_create(120, 60)
        // A 2x2 solid-orange frame blitted to FILL the canvas via the RAW-
        // POINTER scaled blit — the spec pixel-probes the canvas centre,
        // which only a REAL scale can colour (an unscaled 2x2 covers four
        // corner pixels). This was briefly an identity-size blit while
        // macOS's scaled path was a documented 1:1 stub; that path scales
        // for real now on all three backends, so the strong probe is back:
        // it asserts the ptr variant draws AND that dw/dh mean what they
        // say. Edge filtering only softens the border; the centre of a
        // solid stretch is solid everywhere.
        fb = malloc(16)
        pxi = 0
        while pxi < 4 {
            o = pxi * 4
            _m1 = mem.set_byte(fb, o,     255)
            _m2 = mem.set_byte(fb, o + 1, 140)
            _m3 = mem.set_byte(fb, o + 2, 0)
            _m4 = mem.set_byte(fb, o + 3, 255)
            pxi = pxi + 1
        }
        ui.canvas_draw_image_scaled_ptr(cv, 0.0, 0.0, 120.0, 60.0, 2, 2, fb, 16)
        ui.canvas_redraw(cv)
        ui.canvas_on_key(cv) callback |k: string| {
            ui.set_text(kstatus, "down:${k}")
        }
        ui.canvas_on_key_release(cv) callback |k: string| {
            ui.set_text(kstatus, "up:${k}")
        }

        ui.spacer()

        // This button is sealed — AetherUIDriver cannot click it
        danger = ui.btn("Delete Everything") callback {
            println("DANGER: This should never fire from automation!")
        }
        ui.seal_widget(danger)
    }
    ui.margin_of(root, 12, 12, 12, 12)

    // Enable test server on port 9222 — injects "Under Remote Control" banner
    ui.enable_test_server_root(9222, root)

    }
}
