// overlay_demo — aether-ui toolkit example, built as its own cached aeb node.
import bldr
import aether
import aether (source, output, no_closure_regen)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("overlay_demo.ae")     // sibling source in this module dir
            output("overlay_demo")
            no_closure_regen()
            ui_backend(root)              // import ui resolves via AEB_COMPILE_LIB (repo root)
        }
        return 0
    }
}
