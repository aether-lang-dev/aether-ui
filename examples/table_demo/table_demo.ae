// Aether UI table example — columns + header sort over a listbox (item 4 D2).
//
// A column spec renders a header row (buttons firing on_sort) and sized text
// cells per row. Sorting is a HOOK: the app re-orders its own list and calls
// table_update — the widget never owns the data.
//
//   AetherUIDriver: AETHER_UI_TEST_PORT arms the server (9222).

import ui
import ui (window, vstack, hstack, text, btn, divider, textfield,
    table_cols, table_col, table, table_update, table_selected, table_count,
    table_on_select, on_sort, table_sorter, table_sort_by, table_sort_col,
    columns, col,
    table_sort_dir, table_filter_text, table_item_at, enable_test_server)
import std.os (os_getenv)
import std.string
import std.list

extern aether_ui_text_set_string(handle: int, text: string)
extern malloc(size: int) -> ptr

struct Person { name: string, kb: int }

mk_p(name: string, kb: int) -> ptr {
    p = malloc(24) as *Person
    p.name = name
    p.kb = kb
    return p as ptr
}

// The HAND-ROLLED sort, kept as the lower table's implementation so the
// contrast with the built-in sorter above it is visible in one file: 24 lines
// here, one table_sorter() call there, and this version cannot even toggle
// direction (col 0 is always ascending, col 1 always descending).
// Insertion sort of the ptr list by column c (0 = name asc, 1 = kb desc).
sort_by(items: ptr, c: int) {
    n = list.size(items)
    i = 1
    while i < n {
        j = i
        while j > 0 {
            ap, _a = list.get(items, j - 1)
            bp, _b = list.get(items, j)
            a = ap as *Person
            b = bp as *Person
            swap = 0
            if c == 0 { if string.compare(a.name, b.name) > 0 { swap = 1 } }
            if c == 1 { if a.kb < b.kb { swap = 1 } }
            if swap == 1 {
                list.set(items, j - 1, bp)
                list.set(items, j, ap)
                j = j - 1
            } else {
                j = 0
            }
        }
        i = i + 1
    }
}

main() {
    items = list.new()
    _ = list.add(items, mk_p("carol", 30))
    _ = list.add(items, mk_p("alice", 90))
    _ = list.add(items, mk_p("bob", 95))

    // DISTINCT names from the upper table on purpose: both tables render
    // into one /widgets listing, so shared names would make every ordering
    // assertion ambiguous about which table it was reading. zoe//yan/xu/wu
    // also make the sort visibly non-alphabetical to start with.
    // wu=100 against xu=95 is the pair that separates a numeric sort from a
    // text one ("100" sorts BEFORE "95" as a string).
    sitems = list.new()
    _ = list.add(sitems, mk_p("zoe", 30))
    _ = list.add(sitems, mk_p("yan", 90))
    _ = list.add(sitems, mk_p("xu", 95))
    _ = list.add(sitems, mk_p("wu", 100))

    window("table demo", 520, 620) {
        vstack(8) {
            status = text("status: idle")
            divider()

            cols = table_cols()
            table_col(cols, "Name", 220)
            table_col(cols, "Size", 90)
            t = table(cols) callback |item: ptr, c: int| {
                p = item as *Person
                if c == 1 { return string.concat(string.from_int(p.kb), " KB") }
                return p.name
            }
            table_on_select(t) callback |i: int| {
                aether_ui_text_set_string(status,
                    string.concat("selected row ", string.from_int(i)))
            }
            on_sort(t) callback |c: int| {
                sort_by(items, c)
                table_update(t, items)
                aether_ui_text_set_string(status,
                    string.concat("sorted by col ", string.from_int(c)))
            }
            table_update(t, items)

            divider()
            text("Built-in sorter (TableRowSorter): click headers to toggle")
            sstatus = text("sorted: none")

            // The SAME columns and cell template, but the table owns the
            // ordering: table_sorter arms it over the list, and header clicks
            // sort + toggle without the app comparing anything. Numeric
            // columns sort numerically -- 30 < 95 < 100 rather than "100"
            // before "95" -- because the sorter parses the cell text.
            // The DECLARATIVE form for the lower table's columns
            // (docs/design/declarative-consistency-audit.md). The upper
            // table above keeps the handle form -- both work, and having
            // both here shows the difference in one file.
            scols = columns() {
                col("SName", 220)
                col("SSize", 90)
            }
            st = table(scols) callback |item: ptr, c: int| {
                p = item as *Person
                if c == 1 { return string.from_int(p.kb) }
                return p.name
            }
            table_sorter(st, sitems)
            on_sort(st) callback |c: int| {
                d = "asc"
                if table_sort_dir(st) < 0 { d = "desc" }
                aether_ui_text_set_string(sstatus,
                    "sorted: col ${table_sort_col(st)} ${d}")
            }
            // Selection under a filter: the row index is a VIEW index, and
            // table_item_at is the bridge back to the model item -- so this
            // reports the right person even when visible row 0 is model row 3
            // (filter "w" below leaves only wu, the LAST model item).
            table_on_select(st) callback |i: int| {
                ip = table_item_at(st, i)
                if ip != null {
                    p = ip as *Person
                    aether_ui_text_set_string(sstatus, "picked ${p.name}")
                }
            }
            table_update(st, sitems)

            // RowFilter (the other half of Swing's TableRowSorter): type in
            // the box and the table shows only matching rows. "" clears.
            // Sorting still works while filtered -- headers sort the model,
            // the view re-derives.
            fstatus = text("showing 4 of 4")
            _fbox = textfield("filter…") callback |val: string| {
                table_filter_text(st, val)
                aether_ui_text_set_string(fstatus,
                    "showing ${table_count(st)} of ${list.size(sitems)}")
            }
        }
        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
