// Aether UI file-drop example: files dropped onto the window.
//
// The drag-and-drop case an editor or a file manager cannot do without, and
// the one #17 called the minimum. The window accepts a drop anywhere in it,
// not only over one widget, which is what makes "drop files here" work
// without a target the user has to aim at.
//
//   AetherUIDriver: set AETHER_UI_TEST_PORT to arm the HTTP test server
//   (9222). A real drag cannot be synthesised headlessly, so the driver
//   delivers to the same closure via POST /window/filedrop?paths=a%0Ab.

import ui
import ui (window, vstack, text, btn, divider, on_file_drop, draggable,
    clear_children, on_ui_thread, enable_test_server)
import std.os (os_getenv)
import std.string

extern aether_ui_text_set_string(handle: int, text: string)

main() {
    drops = 0

    window("file drop", 460, 300) {
        vstack(8) {
            text("Drop files anywhere on this window")
            divider()
            count = text("drops: 0")
            first = text("first path: (none)")
            total = text("files in last drop: 0")
            // One row per file in the last drop, thrown away and rebuilt on
            // every drop. That is what a real collector does (OpenDisk's
            // does), and it is what makes the handler's thread matter: a
            // label update tolerates the wrong thread, creating and parenting
            // native widgets does not.
            listing = vstack(2) { }
            // Which thread the handler ran on, so a spec can see it rather
            // than hope a wrong-thread rebuild crashes. Win32 tolerates one
            // in a headless run and only AppKit aborted on it.
            thread = text("handler thread: (no drop yet)")

            divider()
            text("and the other direction: this row can be dragged OUT")
            // A drag source carrying a file. Dragging it into another app
            // hands over /tmp/dragged.txt, the shape a file manager needs to
            // move a file out to Finder or Files.
            out_row = btn("drag me to another app") callback { }
            draggable(out_row, "/tmp/dragged.txt")

            plain_row = btn("this one is not draggable") callback { }

            on_file_drop(|paths: ptr, n: int| {
                drops = drops + 1
                if on_ui_thread() == 1 {
                    aether_ui_text_set_string(thread, "handler thread: ui")
                } else {
                    aether_ui_text_set_string(thread, "handler thread: NOT the ui thread")
                }
                aether_ui_text_set_string(count, "drops: ${drops}")
                aether_ui_text_set_string(total, "files in last drop: ${n}")
                if n > 0 {
                    aether_ui_text_set_string(first,
                        string.concat("first path: ",
                                      string.string_array_get(paths, 0)))
                }
                clear_children(listing)
                i = 0
                while i < n {
                    _row = btn(listing, string.concat("dropped: ",
                               string.string_array_get(paths, i))) callback { }
                    i = i + 1
                }
            })
        }
        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
