// datagrid_demo — a virtualised grid (docs/design/data-grid.md, phases 1-4):
// 100,000 rows x 50 columns from a function, 20 rows x 6 scrolling columns
// shown, one frozen column of row numbers, a header of column letters. Only
// the shown cells exist as widgets; the scrollbars scroll it. Clicks and keys
// select; the selection and Return are shown under the grid, and so are
// column resizes and moves (drag a header's right edge, or the header).
// Cells are editable (F2, a double click or typing); edits are kept in a map
// over the computed model, by model row and column. Written declaratively:
// the grid is the receiver of its block, as a button is of its own.
//
//   AETHER_UI_TEST_PORT=9222 ./target/build/examples/datagrid_demo/bin/datagrid_demo &
//   UI_SPEC=datagrid_demo/spec_datagrid_demo tests/run_spec.sh

import ui
import ui (window, vstack, text, textfield_bound, btn, datagrid, datagrid_refresh,
    ui_state_i, ui_get_i, ui_set_i, cells, headers, column_width, on_cell_click,
    edit_text, cell_style, cell_tooltip, on_cell_edit_change, datagrid_edit_insert, datagrid_edit, datagrid_show_header, datagrid_header_shown, datagrid_cell_picture, datagrid_set_row_heights, datagrid_row_heights, datagrid_selection_glide, datagrid_glide_ms, shortcut,
    on_cell_activate, on_col_resize, on_col_move, on_header_click, on_cell_edit,
    datagrid_anchor_row, datagrid_anchor_col, datagrid_hide_row, datagrid_hide_col,
    datagrid_row_hidden, datagrid_row_model, datagrid_col_model,
    datagrid_freeze_rows, datagrid_frozen_rows, datagrid_merge, datagrid_unmerge, datagrid_merge_of,
    datagrid_set_row_height, datagrid_row_height, datagrid_fit_row, datagrid_set_height, datagrid_freeze_cols,
    ui_state_s, ui_set_s, text_bound, enable_test_server,
    datagrid_float, datagrid_float_move, datagrid_float_remove, datagrid_float_takes_clicks, datagrid_floats, style_bg_color)
import vg.live (vg)
import vg
import vg (view_box, circle, fill)
import std.os (os_getenv)
import std.string
import std.map

// What the enclosing block does at its end for the vg scenes made in it (their
// shapes are drawn then): run here, for a scene made by a button.
extern aether_ui_surface_flush_deferred_impl()

// What a cell shows for what was typed into it: "=2+3" is a formula, shown
// as its sum; anything else as itself.
shown(raw: string) -> string {
    if string.starts_with(raw, "=") == 0 { return raw }
    parts = string.string_split(string.substring(raw, 1, string.length(raw)), "+")
    sum = 0
    i = 0
    while i < string.string_array_size(parts) {
        n, _err = string.to_int(string.trim(string.string_array_get(parts, i)))
        sum = sum + n
        i = i + 1
    }
    string.string_array_free(parts)
    return string.from_int(sum)
}

// Column letters: A..Z, AA..AZ, ... (a spreadsheet's).
letters(c: int) -> string {
    s = ""
    n = c
    while n >= 0 {
        s = string.concat(string.substring("ABCDEFGHIJKLMNOPQRSTUVWXYZ", n % 26, n % 26 + 1), s)
        n = n / 26 - 1
    }
    return s
}

// A vg scene in a float (its parent): a blue disc at the right of a 32 x 20
// ground that is drawn on nothing, so whatever the float floats over shows
// through the rest of it.
float_scene(parent: ptr) {
    scene = vg(parent, view_box(0, 0, 32, 20), 32, 20)
    disc = circle(scene, 24.0, 14.0, 6.0)
    fill(disc, "#0000ff")
}

main() {
    clicked = ui_state_s("none")
    selected = ui_state_s("none")
    activated = ui_state_s("none")
    resized = ui_state_s("none")
    moved = ui_state_s("none")
    hclicked = ui_state_s("none")
    edited = ui_state_s("none")
    edits = map.map_new()
    notes = ui_state_s("")
    swapped = ui_state_i(0)
    rowmodel = ui_state_s("")
    hidc = ui_state_i(0)
    typing = ui_state_s("")
    reenter = ui_state_i(0)
    flclicks = ui_state_i(0)
    window("datagrid", 1000, 640) {
        vstack(4) {
            text("100,000 rows x 50 columns")
            g = datagrid(100000, 50, 20, 6, 1) {
                // 36 wide, so seven columns (and one widened by a drag)
                // still fit an iPhone's screen, where the iOS simulator
                // runs the spec.
                column_width(36)
                cells() callback |r: int, c: int| {
                    if c == 0 { return string.from_int(r + 1) }
                    if c == 6 && r == 3 { return "a long note that wraps" }
                    v, _e = map.get(edits, "${r},${c}")
                    if v != null { return shown(v) }
                    return "R${r}C${c}"
                }
                // An editor starts with what was typed (a formula), not
                // what the cell shows (its value).
                edit_text() callback |r: int, c: int| {
                    v, _e = map.get(edits, "${r},${c}")
                    if v != null { return v }
                    return "R${r}C${c}"
                }
                // Every seventh row's column 2 is an alarm; a formula's
                // value sits at the right, as a spreadsheet's number does.
                cell_style() callback |r: int, c: int| {
                    if c == 2 && r % 7 == 0 { return "background: #ffe0e0; color: #b00000; font-weight: bold" }
                    // Row 10's column 3 changes colour with "Swap colours":
                    // two long style strings, which a style cache must tell
                    // apart (sae's sorted spreadsheet found one that could not).
                    if c == 3 && r == 10 {
                        if ui_get_i(swapped) == 1 { return "text-align: end; background: #e8f5e9" }
                        return "text-align: end; background: #ffebee"
                    }
                    // Column D, rows 12 to 17: the rest of what a style draws.
                    if c == 4 && r == 12 { return "font-style: italic; text-decoration: underline; font-family: monospace" }
                    if c == 4 && r == 13 { return "text-decoration: line-through; font-size: 16px" }
                    if c == 4 && r == 14 { return "border-top: 1px solid #000; border-bottom: 2px solid #c00000" }
                    if c == 4 && r == 15 { return "--fill: 0.5; --fill-color: #638ec6" }
                    if c == 4 && r == 16 { return "--fill: -0.25" }
                    if c == 4 && r == 17 { return "--corner: #d00" }
                    if c == 6 && r == 3 { return "white-space: normal" }
                    v, _e = map.get(edits, "${r},${c}")
                    if v != null && string.starts_with(v, "=") == 1 { return "text-align: end" }
                    return ""
                }
                // The marked cell's comment, on hover.
                cell_tooltip() callback |r: int, c: int| {
                    if c == 4 && r == 17 { return "a note on R17C4" }
                    return ""
                }
                headers() callback |c: int| {
                    if c == 0 { return "#" }
                    return letters(c - 1)
                }
                on_cell_click() callback |r: int, c: int| {
                    _s = ui_set_s(clicked, "${r},${c}")
                }
                on_cell_activate() callback |r: int, c: int| {
                    _s3 = ui_set_s(activated, "${r},${c}")
                }
                on_col_resize() callback |c: int, w: int| {
                    _s4 = ui_set_s(resized, "${c} to ${w}")
                }
                on_col_move() callback |from: int, to: int| {
                    _s5 = ui_set_s(moved, "${from} to ${to}")
                }
                // A header clicked (pressed and let go without a drag).
                on_header_click() callback |c: int| {
                    _s7 = ui_set_s(hclicked, "${c}")
                }
                // The open editor's text and caret as it is typed.
                on_cell_edit_change() callback |et: string, caret: int| {
                    _ty = ui_set_s(typing, "${et} @${caret}")
                }
                on_cell_edit() callback |r: int, c: int, t: string| {
                    _p = map.put(edits, "${r},${c}", t)
                    _s6 = ui_set_s(edited, "${r},${c} = ${t}")
                }
            }
            // A handler that needs the grid itself takes the handle form (a
            // closure in the block above is made before `g` is assigned),
            // here chained as a method: `g.datagrid_on_select()` is
            // `datagrid_on_select(g)`. (Not in the selective import above:
            // before ae 0.804.0 a method call on a selectively imported name
            // was mangled wrongly (aether #2715), and aether-ui's floor is
            // older than that.)
            g.datagrid_col_limits(24, 1000).datagrid_on_select() callback |r: int, c: int| {
                // Its other areas, after a Ctrl/Cmd click, said after it.
                more = datagrid_areas(g)
                if string.length(more) > 0 { more = " and ${more}" }
                _s2 = ui_set_s(selected, "${r},${c} from ${datagrid_anchor_row(g)},${datagrid_anchor_col(g)}${more}")
                // "Edit R6C2 twice": the move datagrid_edit makes is heard
                // here, and an editor opened from it, as a spreadsheet's
                // point mode does; one editor is left open, not two.
                if ui_get_i(reenter) == 1 {
                    _re = ui_set_i(reenter, 0)
                    _ed = datagrid_edit(g, r, c)
                }
            }
            // A field outside the grid: focus moving to it commits an open
            // editor (a field, since a button takes no focus on iOS).
            _notes = textfield_bound("Notes", notes)
            _swap = btn("Swap colours") callback {
                _sw = ui_set_i(swapped, 1 - ui_get_i(swapped))
                _rf = datagrid_refresh(g)
            }
            // Rows 5 and 6 (model rows 4 and 5) out of the view and back,
            // and the column headed C (wherever it has been moved to).
            _hide = btn("Hide rows 5-6") callback {
                h = 1 - datagrid_row_hidden(g, 4)
                _h4 = datagrid_hide_row(g, 4, h)
                _h5 = datagrid_hide_row(g, 5, h)
                _rm = ui_set_s(rowmodel, "${datagrid_row_model(g, 4)}")
            }
            // The rows' height: ten rows' worth, then all twenty again.
            // Column A frozen beside the row numbers, and freed.
            _fza = btn("Freeze A") callback {
                _fz = datagrid_freeze_cols(g, 1)
            }
            _unf = btn("Free A") callback {
                _fz2 = datagrid_freeze_cols(g, 0)
            }
            _ten = btn("Ten rows high") callback {
                _sh = datagrid_set_height(g, 240)
            }
            _all = btn("All rows high") callback {
                _sh2 = datagrid_set_height(g, 0)
            }
            _hidec = btn("Hide C") callback {
                vc = 0
                while vc < 50 && datagrid_col_model(g, vc) != 3 { vc = vc + 1 }
                hc = 0
                if ui_get_i(hidc) == 0 { hc = 1 }
                _hc = datagrid_hide_col(g, vc, hc)
                _hs = ui_set_i(hidc, hc)
            }
            // The top two rows stay while the rest scroll (Freeze Panes).
            _freeze = btn("Freeze 2 rows") callback {
                _fr = datagrid_freeze_rows(g, 2 - datagrid_frozen_rows(g))
            }
            // Merge & unmerge D9:E10 (rows 8-9, view columns 3-4).
            _merge = btn("Merge D9:E10") callback {
                if string.length(datagrid_merge_of(g, 8, 3)) == 0 {
                    _m = datagrid_merge(g, 8, 3, 2, 2)
                } else {
                    _u = datagrid_unmerge(g, 8, 3)
                }
            }
            // Row 4 (model row 3) 60px tall and back, or as tall as its text.
            _tall = btn("Tall row 4") callback {
                th = 60
                if datagrid_row_height(g, 3) != 24 { th = 0 }
                _t = datagrid_set_row_height(g, 3, th)
            }
            _fit = btn("Fit row 4") callback {
                _f = datagrid_fit_row(g, 3)
            }
            // A picture in R2C5 (a red square), and none, and back.
            pics = ui_state_i(0)
            _pic = btn("Picture") callback {
                _ps = ui_set_i(pics, 1 - ui_get_i(pics))
                _rp = datagrid_refresh(g)
            }
            _pc = datagrid_cell_picture(g) callback |r: int, c: int| {
                if ui_get_i(pics) == 1 && r == 2 && c == 5 { return "iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEUlEQVR4nGM4oaGBFTEMLQkAgl1GAWqNFmsAAAAASUVORK5CYII=" }
                return ""
            }
            // A red box floating over the grid from R9C1 (3 px right, 3 down),
            // 40 x 30: it scrolls with the cells and lets the pointer through
            // to them; "Float takes clicks" makes it take them, and back.
            fl = datagrid_float(g, 9, 1, 3, 3, 40, 30)
            _flc = style_bg_color(fl, 0.85, 0.15, 0.15, 1.0)
            _flt = btn("Float takes clicks") callback {
                taking = 1 - ui_get_i(flclicks)
                _fk = datagrid_float_takes_clicks(g, fl, taking)
                _fs = ui_set_i(flclicks, taking)
            }
            // Move float: to R11C2, and back to where it was made.
            flmoved = ui_state_i(0)
            // "vg float": a vg scene floating over R7C2, a pink cell: a blue
            // disc and, round it, the pink through the scene (its ground is
            // transparent); and taken away again.
            vgf = ui_state_i(0)
            _vgb = btn("vg float") callback {
                if ui_get_i(vgf) == 0 {
                    nf = datagrid_float(g, 7, 2, 2, 2, 32, 20)
                    float_scene(nf)
                    aether_ui_surface_flush_deferred_impl()
                    _vs = ui_set_i(vgf, nf)
                } else {
                    _vr = datagrid_float_remove(g, ui_get_i(vgf))
                    _vs = ui_set_i(vgf, 0)
                }
            }
            _flm = btn("Move float") callback {
                if ui_get_i(flmoved) == 0 {
                    _fm = datagrid_float_move(g, fl, 11, 2, 0, 0, 40, 30)
                } else {
                    _fm = datagrid_float_move(g, fl, 9, 1, 3, 3, 40, 30)
                }
                _fs = ui_set_i(flmoved, 1 - ui_get_i(flmoved))
            }
            // The cursor's box gliding to a new cell over 1500 ms (slowed, so
            // a driver polling /widgets sees it between cells), and back to
            // jumping.
            _glide = btn("Glide") callback {
                ms = 1500
                if datagrid_glide_ms(g) > 0 { ms = 0 }
                _gl = datagrid_selection_glide(g, ms)
            }
            // Every row 36 high and back, as a zoom does (the rows given
            // their own height keep it).
            _rh = btn("Rows 36") callback {
                h = 36
                if datagrid_row_heights(g) == 36 { h = 24 }
                _rr = datagrid_set_row_heights(g, h)
            }
            // The column headers hidden and shown again (View > Headings).
            _hdr = btn("Headers") callback {
                _sh = datagrid_show_header(g, 1 - datagrid_header_shown(g))
            }
            _twice = btn("Edit R6C2 twice") callback {
                _re1 = ui_set_i(reenter, 1)
                _ed1 = datagrid_edit(g, 5, 2)
            }
            // F4 puts a reference in the open editor at its caret (point mode).
            shortcut("F4") callback {
                _ins = datagrid_edit_insert(g, "A1")
            }
            text_bound(typing, "typing: ", "")
            text_bound(rowmodel, "row 4 shown is model row ", "")
            text_bound(clicked, "clicked: ", "")
            text_bound(selected, "selection: ", "")
            text_bound(activated, "activated: ", "")
            text_bound(resized, "resized: ", "")
            text_bound(moved, "moved: ", "")
            text_bound(hclicked, "header clicked: ", "")
            text_bound(edited, "edited: ", "")
        }
        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
