// aetherui — consumer-local aeb library module for building aether-ui apps.
//
// Factors the ~50-line per-platform backend-link block (GTK4 / AppKit / Win32)
// out of every app's .build.ae. `ui_backend` is a `builder` so its bare setter
// calls (include_dir/link_flag/extra_source) bind to the enclosing
// aether.program(b){} block's injected _ctx — call it INSIDE that block:
//
//   aether.program(b) {
//       source("../../<app>.ae")    // path relative to this app's module dir
//       output("<app>")
//       no_closure_regen()
//       ui_backend(root)            // applies the native backend for this OS
//   }
//
// The backend C/ObjC/headers live under backend/, addressed absolutely via root.

import std.string
import std.os (platform, os_getenv)
import aether
import aether (extra_source, link_flag, include_dir)

// The Aether SDK prefix. /usr/local is the Linux/FreeBSD default; macOS
// installs under ~/.local and any pinned-toolchain box may use another
// prefix entirely. A hardcoded /usr/local silently version-skews such a
// box: aeb resolves aetherc/libaether from `command -v ae` (correct), but
// these -I/-L flags kept pointing at whatever /usr/local held — the class
// of bug behind "rubiks red on one box, green on another, same version
// string" (asks/ci-sh-on-a-fresh-headless-box.md §1c) and macvm's contrib
// archives not resolving at all. Override with AETHER_UI_SDK_PREFIX.
sdk_prefix() -> string {
    p = os_getenv("AETHER_UI_SDK_PREFIX")
    if p != null {
        if string.length(p) > 0 { return p }
    }
    return "/usr/local"
}

builder ui_backend(root: string) {
    // Aether runtime headers + libaether (+ its transitive deps via ae cflags).
    sdk = sdk_prefix()
    include_dir("${sdk}/include/aether/runtime")
    include_dir("${sdk}/include/aether/runtime/actors")
    include_dir("${sdk}/include/aether/std")
    include_dir("${sdk}/include/aether/std/collections")
    link_flag("-L${sdk}/lib/aether")
    link_flag("-laether")
    link_flag("-pthread")
    link_flag("-lm")
    // PCRE2/SSL/zlib etc. — apps importing std.regex-using modules need these
    // (same reason build.sh appended it on Linux + macOS).
    link_flag("$(ae cflags --libs 2>/dev/null)")

    // Effective target. There is no iOS *host*, so platform() can never report
    // "ios"; an app cross-building for iOS/iPadOS sets AETHER_UI_TARGET=ios and
    // gets the UIKit backend instead of a host one. NOTE: this arm compiles and
    // links the backend, but producing a RUNNABLE .app still needs the packaging
    // layer that does not exist yet — libaether built for arm64-apple-ios, an
    // Info.plist, code-signing and the bundle. Until then AETHER_UI_TARGET=ios is
    // dormant (nothing sets it in the normal build); ci.sh Phase 1e is what
    // actually gates that this backend builds against the iOS SDK. See the header
    // of backend/aether_ui_uikit.m for the full status.
    os_name = platform()
    is_ios = 0
    ui_target = os_getenv("AETHER_UI_TARGET")
    if ui_target != null {
        if string.equals(ui_target, "ios") == 1 { is_ios = 1 }
    }
    // Force os_name off every host branch when cross-targeting iOS (on macOS,
    // platform() would otherwise also fire the AppKit arm alongside UIKit).
    if is_ios == 1 { os_name = "ios" }
    if is_ios == 1 {
        extra_source("${root}/backend/aether_ui_uikit.m")
        // Same SHARED driver + system-extras the AppKit/Win32 backends carry.
        extra_source("${root}/backend/aether_ui_test_server.c")
        extra_source("${root}/backend/aether_ui_system_extras.c")
        link_flag("-fobjc-arc")
        link_flag("-framework UIKit")       // AppKit's iOS counterpart
        link_flag("-framework Foundation")
        link_flag("-framework QuartzCore")
        link_flag("-framework CoreGraphics")  // canvas: CGBitmapContext/CGGradient
        link_flag("-framework CoreText")    // text metrics (vg.text_extent)
        link_flag("-framework ImageIO")     // headless canvas_write_png
    }
    // Linux and FreeBSD share the GTK4 backend verbatim — the backend sources
    // carry no Linux-only syscalls/headers, and GTK4 (gtk4.pc) plus GDBus (in
    // GIO) are provided on FreeBSD via pkg. FreeBSD needs pkgconf installed and
    // a zlib.pc for the freetype2->zlib chain (base zlib ships none); AE_CC
    // must be clang (no gcc in the base system). See docs/freebsd.md.
    if string.equals(os_name, "linux") == 1 {
        extra_source("${root}/backend/aether_ui_gtk4.c")
        // The SHARED AetherUIDriver. GTK4 used to carry its own HTTP server
        // and so never compiled this; it now fills AetherDriverHooks like
        // win32 and macOS (docs/design/one-driver-not-two.md).
        extra_source("${root}/backend/aether_ui_test_server.c")
        extra_source("${root}/backend/aether_ui_system_extras.c")
        extra_source("${root}/backend/aether_ui_sni.c")
        link_flag("$(pkg-config --cflags gtk4)")
        link_flag("$(pkg-config --libs gtk4)")
    }
    if string.equals(os_name, "freebsd") == 1 {
        extra_source("${root}/backend/aether_ui_gtk4.c")
        // The SHARED AetherUIDriver. GTK4 used to carry its own HTTP server
        // and so never compiled this; it now fills AetherDriverHooks like
        // win32 and macOS (docs/design/one-driver-not-two.md).
        extra_source("${root}/backend/aether_ui_test_server.c")
        extra_source("${root}/backend/aether_ui_system_extras.c")
        extra_source("${root}/backend/aether_ui_sni.c")
        link_flag("$(pkg-config --cflags gtk4)")
        link_flag("$(pkg-config --libs gtk4)")
    }
    if string.equals(os_name, "darwin") == 1 {
        extra_source("${root}/backend/aether_ui_macos.m")
        // macOS drives the SHARED test server (as win32 does) — it used to
        // carry a private, drifted copy with no geometry/focus/key routes.
        extra_source("${root}/backend/aether_ui_test_server.c")
        extra_source("${root}/backend/aether_ui_system_extras.c")
        link_flag("-fobjc-arc")
        link_flag("-framework AppKit")
        link_flag("-framework Foundation")
        link_flag("-framework QuartzCore")
        link_flag("-framework CoreText")   // text metrics (vg.text_extent)
        link_flag("-framework ImageIO")    // headless canvas_write_png
    }
    if string.equals(os_name, "windows") == 1 {
        extra_source("${root}/backend/aether_ui_win32.c")
        extra_source("${root}/backend/aether_ui_test_server.c")
        extra_source("${root}/backend/aether_ui_system_extras.c")
        link_flag("-luser32")
        link_flag("-lgdi32")
        link_flag("-lgdiplus")
        link_flag("-lmsimg32")
        link_flag("-lcomctl32")
        link_flag("-lcomdlg32")
        link_flag("-lshell32")
        link_flag("-lole32")
        // VariantInit/VariantClear — the MSAA Dynamic Annotation path in
        // aether_ui_win32.c (a11y_role/label) calls them.
        link_flag("-loleaut32")
        link_flag("-luuid")
        link_flag("-ldwmapi")
        link_flag("-luxtheme")
        link_flag("-lws2_32")
        link_flag("-lbcrypt")   // libaether crypto: BCryptGenRandom
        // libaether panic traces: ae >= 0.541 symbolises via the DbgHelp API
        // (SymInitialize/SymFromAddr in runtime/aether_panic.c). aether's own
        // Makefile links it (WIN_LINK_LIBS has -ldbghelp); aeb's link line
        // does not — filed as aeb/asks/win32-link-needs-ldbghelp-after-0541.md.
        // Until aeb reads aether's published lib list, carry it here like
        // ws2_32/bcrypt above.
        link_flag("-ldbghelp")
    }
}
