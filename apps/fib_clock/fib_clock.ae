// Fibonacci Clock — one golden-spiral family for the hour lanes and hand.
// Run: aeb apps/fib_clock && target/build/apps/fib_clock/bin/fib_clock
// FIB_CLOCK_TIME=04:30 freezes the clock for a reference screenshot.

import ui
import ui (window, enable_test_server, bg_color)
import vg.live
import vg.live (vg, canvas_region, region_set_animated)
import vg
import vg (view_box, rect, circle, line, path, fill, stroke, linecap,
           text_anchored, vg_root, node_scene)
import std.math
import std.list
import std.string
import std.os (os_getenv, now_local)

const CX: float = 300.0
const CY: float = 540.0
const DIAL: float = 86.0
const PHI: float = 1.6180339887
const INK: string = "#3a3a3a"
const HOT: string = "#f26b5b"
const SPIRAL: string = "#4fb3d0"

// Shared time and references to the retained arc segments.
struct ClockTime { hour: int minute: int second: int arcs: ptr }
struct HourArc { hour: int left: ptr right: ptr }
extern malloc(size: int) -> ptr

clock_time() -> *ClockTime {
    clock = malloc(sizeof(ClockTime)) as *ClockTime
    clock.arcs = list.new()
    update_clock(clock)
    return clock
}

set_clock_time(clock: *ClockTime, hour: int, minute: int, second: int) {
    clock.hour = hour
    clock.minute = minute
    clock.second = second
    i = 0
    while i < list.size(clock.arcs) {
        item, _ = list.get(clock.arcs, i)
        arc = item as *HourArc
        color = INK
        if arc.hour == hour { color = HOT }
        stroke(arc.left, color, 3.5)
        stroke(arc.right, color, 3.5)
        i = i + 1
    }
}

// Geometric spacing leaves the inner labels legible and fits all twelve
// lanes inside the portrait. Opposite hours share a radius.
arc_r(k: int) -> float { return 118.0 * math.pow(1.247, k - 1.0) }

pt(d: string, cmd: string, a: float, r: float) -> string {
    x = string.from_float(CX + r * math.cos(a))
    y = string.from_float(CY + r * math.sin(a))
    return string.concat(d, "${cmd}${x} ${y} ")
}

// Every curve shares this polar equation and centre. `radius` is its
// distance from the dial centre at the label axis. Scaling that radius
// makes nested lanes with the same pitch; rotating by pi mirrors 7–12.
spiral_radius(radius: float, delta: float) -> float {
    return radius * math.pow(PHI, -delta * 2.0 / math.pi())
}

spiral_segment(radius: float, axis: float, a0: float, a1: float) -> string {
    d = ""
    // Keep angular sampling identical for short lanes and the full hand.
    steps = (math.abs_float(a1 - a0) / 0.025) as int + 1
    i = 0
    while i <= steps {
        a = a0 + (a1 - a0) * i / (steps * 1.0)
        r = spiral_radius(radius, a - axis)
        cmd = "L"
        if i == 0 { cmd = "M" }
        d = pt(d, cmd, a, r)
        i = i + 1
    }
    return d
}

hour_axis(k: int) -> float { return hemi(k) * math.pi() / 2.0 }

stroked(n: ptr, color: string, w: float) {
    fill(n, "none"); stroke(n, color, w); linecap(n, "round")
}

// Split each lane around its numeral, with the lower half rotated 180°.
hour_arc(_ctx: ptr, k: int, clock: @keep *ClockTime) {
    r = arc_r(ring(k))
    axis = hour_axis(k)
    gap = 16.0 / r
    left = path(_ctx, spiral_segment(r, axis, axis - 0.65, axis - gap))
    right = path(_ctx, spiral_segment(r, axis, axis + gap, axis + 0.70))
    color = INK
    if k == clock.hour { color = HOT }
    stroked(left, color, 3.5)
    stroked(right, color, 3.5)
    // Keep the nodes so time changes recolour them without rebuilding paths.
    arc = malloc(sizeof(HourArc)) as *HourArc
    arc.hour = k
    arc.left = left
    arc.right = right
    _ = list.add(clock.arcs, arc as ptr)
}

// Reserve a padded background for each hour-lane label.
// Paint ALL backgrounds before ANY labels:
// adjacent inner labels can have overlapping font boxes.
draw_markers(_ctx: ptr, hour: int) {
    k = 1
    while k <= 12 {
        baseline = CY + hemi(k) * arc_r(ring(k)) + 9.0
        w = vg.text_width(30.0, "${k}")
        ascent = vg.font_ascent(30.0)
        descent = vg.font_descent(30.0)
        fill(rect(_ctx, CX - w / 2.0 - 6.0, baseline - ascent - 4.0,
                  w + 12.0, ascent + descent + 8.0), "#000000")
        k = k + 1
    }
    k = 1
    while k <= 12 {
        num = text_anchored(_ctx, CX, CY + hemi(k) * arc_r(ring(k)) + 9.0,
                            30.0, "middle", "${k}")
        if k == hour { fill(num, HOT) } else { fill(num, "#b8b8b8") }
        k = k + 1
    }
}

ring(k: int) -> int { if k > 6 { return k - 6 }; return k }
hemi(k: int) -> float { if k > 6 { return 1.0 }; return -1.0 }

// The hand uses the SAME equation and angular shoulder as the hour
// lanes. Interpolate their scale geometrically as the minutes advance;
// changing time cannot change its pitch relative to the hour markers.
draw_spiral(_ctx: ptr, k: int, mins: float) {
    r = arc_r(ring(k))
    if ring(k) < 6 { r = r * math.pow(1.247, mins / 60.0) }
    axis = hour_axis(k)
    start = axis + math.log(r / 3.0) / math.log(PHI) * math.pi() / 2.0
    end = axis - 0.65
    stroked(path(_ctx, spiral_segment(r, axis, start, end)), SPIRAL, 4.0)
}

hand(_ctx: ptr, frac: float, len: float, color: string, w: float) {
    a = frac * 2.0 * math.pi() - math.pi() / 2.0
    h = line(_ctx, CX, CY, CX + len * math.cos(a), CY + len * math.sin(a))
    stroke(h, color, w); linecap(h, "round")
}

two(n: int) -> string {
    if n < 10 { return "0${n}" }
    return "${n}"
}

update_clock(clock: *ClockTime) {
    t = now_local()
    h12 = t.hour % 12
    if h12 == 0 { h12 = 12 }
    minute = t.minute
    second = t.second
    fixed = os_getenv("FIB_CLOCK_TIME")
    if fixed != null {
        if string.length(fixed) == 5 && string.substring(fixed, 2, 3) == ":" {
            hh, he = string.to_int(string.substring(fixed, 0, 2))
            mm, me = string.to_int(string.substring(fixed, 3, 5))
            if he == "" && me == "" && hh >= 0 && hh <= 23 && mm >= 0 && mm <= 59 {
                h12 = hh % 12
                if h12 == 0 { h12 = 12 }
                minute = mm
                second = 0
            }
        }
    }
    set_clock_time(clock, h12, minute, second)
}

// Function-first builders return the drawing scope for their trailing block.
// The block's verbs receive _ctx implicitly, just like window() and vg().
clock_face(_ctx: ptr) -> ptr {
    fill(rect(_ctx, 0.0, 0.0, 600.0, 1040.0), "#000000")
    return vg_root(node_scene(_ctx))
}

classic_dial(_ctx: ptr, outline_width: float) -> ptr {
    stroked(circle(_ctx, CX, CY, DIAL), "#ffffff", outline_width)
    return vg_root(node_scene(_ctx))
}

tick_marks(_ctx: ptr, minute_width: float, hour_width: float) {
    i = 0
    while i < 60 {
        a = i * math.pi() / 30.0
        r0 = DIAL - 4.0
        if i % 5 == 0 { r0 = DIAL - 9.0 }
        tk = line(_ctx, CX + r0 * math.cos(a), CY + r0 * math.sin(a),
                  CX + DIAL * math.cos(a), CY + DIAL * math.sin(a))
        width = minute_width
        if i % 5 == 0 { width = hour_width }
        stroke(tk, "#ffffff", width)
        i = i + 1
    }
}

// Conventional numerals sit below the foreground spiral.
dial_numerals(_ctx: ptr, size: float, radius: float) {
    n = 1
    while n <= 12 {
        a = n * math.pi() / 6.0 - math.pi() / 2.0
        x = CX + radius * math.cos(a)
        baseline = CY + radius * math.sin(a) + 5.0
        w = vg.text_width(size, "${n}")
        ascent = vg.font_ascent(size)
        descent = vg.font_descent(size)
        fill(rect(_ctx, x - w / 2.0 - 2.0, baseline - ascent - 1.0,
                  w + 4.0, ascent + descent + 2.0), "#000000")
        fill(text_anchored(_ctx, x, baseline, size, "middle", "${n}"), "#ffffff")
        n = n + 1
    }
}

// Only time-dependent foreground shapes are rebuilt on each second.
clock_foreground(_ctx: ptr, clock: *ClockTime) {
    h12 = clock.hour
    mins = clock.minute + clock.second / 60.0
    fill(text_anchored(_ctx, CX, 122.0, 42.0, "middle", "${two(h12)}:${two(clock.minute)}"), HOT)
    hand(_ctx, (h12 % 12 + mins / 60.0) / 12.0, DIAL * 0.8, "#ffffff", 3.0)
    fill(circle(_ctx, CX, CY, 8.0), HOT)
    draw_spiral(_ctx, h12, mins)
    draw_markers(_ctx, h12)
}

main() {
    clock = clock_time()
    window("Fibonacci Clock", 460, 798) {
        bg_color(0.0, 0.0, 0.0, 1.0)
        vg(view_box(0, 0, 600, 1040), 460, 798) {
            root = vg_root(node_scene(rect(0, 0, 0, 0)))
            clock_face(root) {
                text_anchored(CX, 56.0, 64.0, "middle", "Fibonacci Clock") {
                    fill("#ffffff")
                }

                for hour in [1, 2, 3, 4, 5, 6] {
                    hour_arc(hour, clock)
                }
                for hour in [7, 8, 9, 10, 11, 12] {
                    hour_arc(hour, clock)
                }

                classic_dial(1.25) {
                    tick_marks(0.6, 1.0)
                    dial_numerals(16.0, 64.0)
                }
                text_anchored(CX, 972.0, 36.0, "middle", "Time, drawn by a Fibonacci spiral") {
                    fill(SPIRAL)
                }
                text_anchored(CX, 1030.0, 36.0, "middle", "1   1   2   3   5   8   13") {
                    fill("#8a8a8a")
                }
            }

            // Static artwork above is declared once. The foreground region
            // shares its time state with the retained arcs' stroke colours.
            region = canvas_region(root, 0.0, 0.0, 600.0, 1040.0) callback |rn: ptr, t: float| {
                clock_foreground(rn, clock)
            }
            region_set_animated(region, 0)
            scene = node_scene(root)
            ui.timer(1000) callback {
                update_clock(clock)
                _ = vg.scene_refresh(scene)
            }
        }
        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
