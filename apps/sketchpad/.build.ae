// sketchpad — aether-ui toolkit example, built as its own cached aeb node.
import bldr
import aether
import aether (source, output, no_closure_regen, lib)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("sketchpad.ae")
            output("sketchpad")
            lib("${root}")
            no_closure_regen()
            ui_backend(root)
        }
        return 0
    }
}
