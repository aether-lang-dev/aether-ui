// gesture_probe — aether-ui diagnostic app, built as its own cached aeb node.
import build
import aether
import aether (source, output, no_closure_regen)
import build_support.aetherui (ui_backend)

main() {
    b = build.start()
    root = build._get(b, "root")
    aether.program(b) {
        source("gesture_probe.ae")
        output("gesture_probe")
        no_closure_regen()
        ui_backend(root)
    }
    return 0
}
