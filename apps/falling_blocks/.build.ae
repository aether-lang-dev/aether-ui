import build
import aether
import aether (source, output, no_closure_regen, lib)
import build_support.aetherui (ui_backend)

main() {
    b = build.start()
    root = build._get(b, "root")
    aether.program(b) {
        source("falling_blocks.ae")
        output("falling_blocks")
        lib("${root}")
        no_closure_regen()
        ui_backend(root)
    }
    return 0
}
