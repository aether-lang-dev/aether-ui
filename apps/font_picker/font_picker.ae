// font_picker.ae — a font picker for aether-ui.
//
// PORTED from Javascript Font Picker (https://www.jsfontpicker.com/),
// MIT License. The upstream project is a browser component; this is the
// same picker as a native app on all three aether-ui backends. Its logic
// layer — the compressed family format, fuzzy search, filters, sorting,
// favourites and keyboard map — is ported rule-for-rule in
// picker_engine.ae (see the header there).
//
//   Portions Copyright (c) 2024-2025 Zygomatic
//   Portions Copyright (c) 2026 Aether developers
//
// See LICENSE-jsfontpicker (upstream's notice, verbatim) and NOTICE.
//
// The dialog mirrors upstream's layout (templates/dialogContent.html):
//   search + subset + category filters | sort key + direction |
//   the font list | a live preview | the variant row | footer actions.
//
// WHERE THIS PORT DIVERGES, deliberately:
//   * Font list: real files discovered on this machine, not Google's
//     catalogue (no network). Each family's record is built in the
//     upstream compressed format so the engine is exercised as written.
//   * Previews are drawn from the ACTUAL font file via vg.font +
//     vg.text_path — real outlines, not a CSS font-family switch. That
//     is aether-ui's own capability and makes the preview honest even
//     for a face the desktop has no CSS handle on.
//   * Favourites are in-memory (upstream persists to localStorage).
//
// Run: DISPLAY=:0 ./target/build/apps/font_picker/bin/font_picker

import ui (
    window, vstack, hstack, text, btn, textfield,
    listbox, listbox_update, listbox_select, listbox_count, on_select,
    style_font_family, style_font_size,
    picker, picker_add, enable_test_server, shortcut,
    edge_insets, style_corner_radius, style_border, style_bg_color,
    style_text_color, style_hover,
    ui_state_s, ui_set_s, bind_text
)
import vg.font
import vg.live (vg, canvas_region)
import vg (
    view_box, rect, fill, use_font, text_path, typeface, text_paths_width,
    vg_root, node_scene, scene_set_refreshing
)
import ui.disclosure (disclosure)
import picker_engine
import std.string
import std.list
import std.fs (list_dir, dir_list_count, dir_list_get)
import std.os (os_getenv)

extern malloc(size: int) -> ptr
extern lrint(x: float) -> long
extern string_to_lower(s: string) -> string
extern string_contains(s: string, sub: string) -> int
extern string_substring(s: string, start: int, end: int) -> string

const FP_PREVIEW: string = "Handgloves 123"

// One visible row: the family index plus the strings the row renders.
struct Row { fi: int label: string cat: string fam: string }
mk_row(fi: int, label: string, cat: string, fam: string) -> ptr {
    r = malloc(48) as *Row
    r.fi = fi
    r.label = label
    r.cat = cat
    r.fam = fam
    return r as ptr
}

// ─── App state ───────────────────────────────────────────────────────────────
struct App {
    list: ptr          // PickList (engine)
    st_status: int     // bound status label
    st_sel: int        // bound selection label
    lb: ptr            // the font listbox
    scene: ptr         // vg scene for the preview canvas
    variant_idx: int   // index into the selected family's variants
    chip_sans: int     // the category chips, restyled on every refresh
    chip_serif: int
    chip_mono: int
    chip_disp: int
}
mk_app() -> *App {
    a = malloc(64) as *App
    a.list = picker_engine.pl_new()
    a.st_status = 0
    a.st_sel = 0
    a.lb = null
    a.scene = null
    a.variant_idx = 0
    a.chip_sans = 0
    a.chip_serif = 0
    a.chip_mono = 0
    a.chip_disp = 0
    return a
}

// ─── Font discovery: build upstream-format records from real files ───────────
// Upstream ships a compressed catalogue; we synthesise the same records
// from what vg.font can actually open, so the engine's parser, filters and
// sorts are exercised on genuine data.
// `cat` is retained for call-site documentation; the real category is
// derived per FACE (upstream ships a curated one per family).
scan_dir(app: *App, dir: string, cat: string, subsets: string) -> int {
    _cat_hint = cat
    added = 0
    dl, err = list_dir(dir)
    if string.length(err) > 0 { return 0 }
    n = dir_list_count(dl)
    i = 0
    while i < n {
        nm = dir_list_get(dl, i)
        if is_ttf(nm) == 1 {
            path = "${dir}/${nm}"
            fh = font.font_load(path)
            if font.font_ok(fh) == 1 {
                face = font_name_of(fh, nm)
                // The upstream compressed record: name/category/variants/subsets
                vars = variants_for(face)
                // Classify from the font's OWN tables (post.isFixedPitch,
                // OS/2 PANOSE). Guessing from the NAME fails for Consolas,
                // Times New Roman, Georgia — most of the Windows set.
                fcat = "sans-serif"
                if font.font_is_serif(fh) == 1 { fcat = "serif" }
                if font.font_is_monospace(fh) == 1 { fcat = "monospace" }
                rec = "${face}/${fcat}/${vars}/${subsets}"
                fam = picker_engine.fam_parse(rec, path)
                if picker_engine.pl_add(app.list, fam) == 1 { added = added + 1 }
            }
        }
        i = i + 1
    }
    return added
}

// The face's own name, falling back to the filename.
font_name_of(fh: ptr, nm: string) -> string {
    n = font.font_name(fh)
    if string.length(n) > 0 { return n }
    return strip_ext(nm)
}

is_ttf(nm: string) -> int {
    n = string.length(nm)
    if n < 5 { return 0 }
    tail = string_substring(nm, n - 4, n)
    if string.equals(tail, ".ttf") == 1 { return 1 }
    if string.equals(tail, ".ttc") == 1 { return 1 }
    return 0
}
strip_ext(nm: string) -> string {
    n = string.length(nm)
    if n < 5 { return nm }
    return string_substring(nm, 0, n - 4)
}

// Weight/italic variants inferred from the face name — the file-level twin
// of upstream's per-family variant list.
variants_for(face: string) -> string {
    lower = string_to_lower(face)
    w = "400"
    if string_contains(lower, "bold") == 1 { w = "700" }
    if string_contains(lower, "light") == 1 { w = "300" }
    if string_contains(lower, "black") == 1 { w = "900" }
    if string_contains(lower, "thin") == 1 { w = "100" }
    ital = 0
    if string_contains(lower, "italic") == 1 { ital = 1 }
    if string_contains(lower, "oblique") == 1 { ital = 1 }
    if ital == 1 { return "${w}i" }
    return w
}

// Category guess from the face name (upstream ships a curated category).
category_for(face: string) -> string {
    lower = string_to_lower(face)
    if string_contains(lower, "mono") == 1 { return "monospace" }
    if string_contains(lower, "serif") == 1 {
        if string_contains(lower, "sans") == 1 { return "sans-serif" }
        return "serif"
    }
    if string_contains(lower, "sans") == 1 { return "sans-serif" }
    return "display"
}

// A category pill: toggles its category in the engine's SET and restyles
// itself to show the state. The whole vocabulary this needed — padding,
// radius, border, hover — landed in the toolkit as the coverage gaps
// were closed; before that this control could not be drawn.
chip(_ctx: ptr, app: *App, cat: string) -> int {
    // The handle isn't in scope inside its own callback, so the chip is
    // restyled by refresh_list (which knows every chip) rather than here.
    b = btn(_ctx, cat) callback {
        _on = picker_engine.pl_toggle_category(app.list, cat)
        refresh_list(app)
    }
    style_chip(b, 0)
    return b
}

// Chip appearance for a state: outline when off, filled when on.
style_chip(h: int, on: int) {
    _p = edge_insets(h, 6.0, 14.0, 6.0, 14.0)
    _r = style_corner_radius(h, 999.0)
    _bd = style_border(h, 1.0, 0.10, 0.45, 0.91)
    if on == 1 {
        _bg = style_bg_color(h, 0.10, 0.45, 0.91, 1.0)
        _fg = style_text_color(h, 1.0, 1.0, 1.0)
    } else {
        _bg = style_bg_color(h, 1.0, 1.0, 1.0, 1.0)
        _fg = style_text_color(h, 0.10, 0.45, 0.91)
    }
    _hv = style_hover(h, 0.91, 0.94, 0.99)
}
sort_at(i: int) -> string {
    if i == 1 { return "popularity" }
    if i == 2 { return "width" }
    if i == 3 { return "thickness" }
    if i == 4 { return "complexity" }
    if i == 5 { return "curvature" }
    return "name"
}

// ─── List rendering ──────────────────────────────────────────────────────────
refresh_list(app: *App) {
    picker_engine.pl_apply(app.list)
    if app.lb == null { return }
    items = list.list_new()
    n = picker_engine.pl_visible_count(app.list)
    i = 0
    while i < n {
        fi = picker_engine.pl_visible_at(app.list, i)
        fam = picker_engine.pl_at(app.list, fi)
        nm = picker_engine.fam_name(fam)
        mark = ""
        if picker_engine.pl_is_fav(app.list, fi) == 1 { mark = "* " }
        // The family NAME doubles as the font to typeset the row in — the
        // defining feature of a font picker: you choose by SEEING the face.
        _ = list.list_add_raw(items,
            mk_row(fi, "${mark}${nm}", picker_engine.fam_category(fam), nm))
        i = i + 1
    }
    listbox_update(app.lb, items)
    // Chips reflect the engine's category set.
    if app.chip_sans != 0 {
        style_chip(app.chip_sans, picker_engine.pl_category_on(app.list, "sans-serif"))
        style_chip(app.chip_serif, picker_engine.pl_category_on(app.list, "serif"))
        style_chip(app.chip_mono, picker_engine.pl_category_on(app.list, "monospace"))
        style_chip(app.chip_disp, picker_engine.pl_category_on(app.list, "display"))
    }
    total = picker_engine.pl_count(app.list)
    favs = picker_engine.pl_fav_count(app.list)
    if app.st_status != 0 {
        s = ui_set_s(app.st_status, "showing ${n}/${total} · favourites ${favs}")
        if s < 0 { return }
    }
}

// The selected family's current variant label (upstream Font.toString).
sel_label(app: *App) -> string {
    si = picker_engine.pl_selected(app.list)
    if si < 0 { return "no selection" }
    fam = picker_engine.pl_at(app.list, si)
    nv = picker_engine.fam_variant_count(fam)
    vi = app.variant_idx
    if vi >= nv { vi = 0 }
    v = picker_engine.fam_variant_at(fam, vi)
    return picker_engine.font_label(fam, v)
}

refresh_selection(app: *App) {
    if app.st_sel == 0 { return }
    lbl = sel_label(app)
    s = ui_set_s(app.st_sel, "selected: ${lbl}")
    if s < 0 { return }
}

// ─── Preview: drawn from the real font file (aether-ui's own twist) ──────────
draw_preview(app: *App, rn: ptr) {
    bg = rect(rn, 0.0, 0.0, 460.0, 90.0)
    fill(bg, "#14141c")
    si = picker_engine.pl_selected(app.list)
    if si < 0 { return }
    fam = picker_engine.pl_at(app.list, si)
    path = picker_engine.fam_path(fam)
    if string.length(path) == 0 { return }
    if use_font(path) == 0 { return }
    // Scale to fit the panel: shrink until the sample fits 440 units.
    size = 44.0
    w = text_paths_width(FP_PREVIEW, size)
    if w > 440.0 { size = size * 440.0 / w }
    t = text_path(rn, 16.0, 62.0, size, FP_PREVIEW)
    fill(t, "#e8ecf2")
}

// ─── App ─────────────────────────────────────────────────────────────────────
main() {
    app = mk_app()
    status = ui_state_s("scanning…")
    seltext = ui_state_s("no selection")
    app.st_status = status
    app.st_sel = seltext

    // Discover fonts. Upstream loads a catalogue; we take what this
    // machine really has, in the same record format.
    // Every platform's usual font homes; missing dirs are skipped silently,
    // so the same binary populates on Linux, BSD, Windows and macOS.
    found = scan_dir(app, "fonts", "sans-serif", "latin")
    found = found + scan_dir(app, "/usr/share/fonts/truetype/dejavu", "sans-serif", "latin,greek,cyrillic")
    found = found + scan_dir(app, "/usr/share/fonts/truetype/liberation", "sans-serif", "latin")
    found = found + scan_dir(app, "/usr/local/share/fonts/dejavu", "sans-serif", "latin")
    found = found + scan_dir(app, "/usr/local/share/fonts/DejaVu", "sans-serif", "latin")
    found = found + scan_dir(app, "/usr/local/share/fonts/liberation-fonts-ttf", "sans-serif", "latin")
    found = found + scan_dir(app, "C:/Windows/Fonts", "sans-serif", "latin")
    found = found + scan_dir(app, "/System/Library/Fonts", "sans-serif", "latin")
    found = found + scan_dir(app, "/Library/Fonts", "sans-serif", "latin")

    window("Font Picker", 620, 720) {
        vstack(6) {
            t_status = text("scanning…")
            bind_text(t_status, status)

            // ── Filters section (upstream's first accordion) ──
            disclosure("Filters", 1) callback |fbody: int| {
            hstack(fbody, 6) {
                textfield("search fonts…") callback |q: string| {
                    picker_engine.pl_set_query(app.list, q)
                    refresh_list(app)
                }
                // Category CHIPS — multi-select, like upstream's pills
                // (filters.categories is a list, not a single value).
                app.chip_sans = chip(app, "sans-serif")
                app.chip_serif = chip(app, "serif")
                app.chip_mono = chip(app, "monospace")
                app.chip_disp = chip(app, "display")
            }

            }

            // ── Sort section (upstream's third accordion) ──
            disclosure("Sort", 1) callback |sbody: int| {
            hstack(sbody, 6) {
                sorts = picker() callback |idx: int| {
                    picker_engine.pl_set_sort(app.list, sort_at(idx))
                    refresh_list(app)
                }
                picker_add(sorts, "name")
                picker_add(sorts, "popularity")
                picker_add(sorts, "width")
                picker_add(sorts, "thickness")
                picker_add(sorts, "complexity")
                picker_add(sorts, "curvature")
                btn("Reverse") callback {
                    cur = 0
                    if picker_engine.pl_reverse(app.list) == 0 { cur = 1 }
                    picker_engine.pl_set_reverse(app.list, cur)
                    refresh_list(app)
                }
                btn("Clear filters") callback {
                    picker_engine.pl_clear_filters(app.list)
                    refresh_list(app)
                }
            }

            }

            // ── The font list (rows are real widgets, upstream's fp__fonts) ──
            app.lb = listbox(2) callback |item: ptr, i: int, row: int| {
                r = item as *Row
                nm = text(row, r.label)
                // Each row in ITS OWN typeface (upstream's per-row rendering).
                _f = style_font_family(nm, r.fam)
                _z = style_font_size(nm, 16.0)
                _c = text(row, r.cat)
            }
            on_select(app.lb) callback |i: int| {
                fi = picker_engine.pl_visible_at(app.list, i)
                picker_engine.pl_set_selected(app.list, fi)
                app.variant_idx = 0
                refresh_selection(app)
            }

            // ── Live preview, drawn from the real font file ──
            vg(view_box(0, 0, 460, 90), 470, 95) {
                anchor = rect(0, 0, 0, 0)
                root_node = vg_root(node_scene(anchor))
                app.scene = node_scene(root_node)
                scene_set_refreshing(app.scene, 1)
                canvas_region(root_node, 0.0, 0.0, 460.0, 90.0)
                    callback |rn: ptr, t: float| {
                        draw_preview(app, rn)
                    }
            }

            t_sel = text("no selection")
            bind_text(t_sel, seltext)

            // ── Footer actions (upstream: favourite / variant / pick) ──
            hstack(6) {
                btn("Favourite (f)") callback {
                    si = picker_engine.pl_selected(app.list)
                    if si >= 0 {
                        _t = picker_engine.pl_toggle_fav(app.list, si)
                        refresh_list(app)
                    }
                }
                btn("Variant ▸") callback {
                    si = picker_engine.pl_selected(app.list)
                    if si >= 0 {
                        fam = picker_engine.pl_at(app.list, si)
                        nv = picker_engine.fam_variant_count(fam)
                        app.variant_idx = (app.variant_idx + 1) % nv
                        refresh_selection(app)
                    }
                }
                btn("Pick") callback {
                    lbl = sel_label(app)
                    s = ui_set_s(seltext, "picked: ${lbl}")
                    if s < 0 { return }
                }
            }

            text("↑/↓ move · f favourite · Enter pick — ported from jsfontpicker (MIT)")
        }

        // Upstream keyboard map (onKeyPressed): the subset that maps
        // cleanly onto a native window.
        shortcut("Down") callback {
            _m = picker_engine.pl_move_selection(app.list, 1)
            sync_listbox(app)
        }
        shortcut("Up") callback {
            _m = picker_engine.pl_move_selection(app.list, 0 - 1)
            sync_listbox(app)
        }
        shortcut("f") callback {
            si = picker_engine.pl_selected(app.list)
            if si >= 0 {
                _t = picker_engine.pl_toggle_fav(app.list, si)
                refresh_list(app)
            }
        }
        shortcut("Return") callback {
            lbl = sel_label(app)
            s = ui_set_s(seltext, "picked: ${lbl}")
            if s < 0 { return }
        }

        // Report the scan total FIRST, then let refresh_list own the status
        // line from here on (it prints "showing N/M · favourites K"). Doing
        // it the other way round leaves whichever call lands last in charge,
        // which differed per backend.
        s0 = ui_set_s(status, "found ${found} fonts")
        if s0 < 0 { println("status failed") }
        refresh_list(app)

        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}

// Keep the listbox highlight in step with the engine's selection.
sync_listbox(app: *App) {
    si = picker_engine.pl_selected(app.list)
    at = picker_engine.pl_visible_index_of(app.list, si)
    if at >= 0 && app.lb != 0 { listbox_select(app.lb, at) }
    refresh_selection(app)
}
