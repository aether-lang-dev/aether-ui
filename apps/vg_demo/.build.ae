import bldr
import aether
import aether (source, output, no_closure_regen, lib)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("vg_demo.ae")
            output("vg_demo")
            lib("${root}")        // sibling modules: vg, vg_live, loader, …
            no_closure_regen()
            ui_backend(root)
        }
        return 0
    }
}
