// turtle.ae — a small turtle-graphics editor: a code editor + canvas + a
// picker of bundled examples, wired to turtle_interp.ae's interpreter.
//
// Ported from Swiby's demo/turtle/ (a JRuby turtle DSL + live editor over
// Swing) — this is a fresh implementation of the same idea (editor + canvas
// + "Run") over aether-ui's canvas and textarea widgets, not a line-by-line
// port. See turtle_interp.ae for the command grammar and what's cut from
// Swiby's original (procedure definitions, localized command names).
//
// Build and run:
//   ./build.sh apps/turtle/turtle.ae build/turtle

import ui
import turtle_interp
import turtle_interp (run_turtle_script, run_turtle_script_view)
import std.os (os_getenv)

extern malloc(size: int) -> ptr
extern aether_ui_text_set_string(handle: int, text: string)

CANVAS_W() -> float { return 560.0 }
CANVAS_H() -> float { return 560.0 }

struct TurtleUiState {
    editor: int
    canvas: int
    // VIEW state. Zoom is not a widget transform -- the canvas replays in
    // absolute coordinates -- so it is a RE-RUN of the script at a different
    // scale. That makes it exact rather than resampled: lines are redrawn at
    // the new size, and the 2px pen stays 2px however far you zoom in.
    scale: float
    panx: float
    pany: float
    status: int
}

flower_script() -> string {
    return <<TURTLE
repeat 36 [
    right 10
    repeat 4 [
        forward 50
        right 90
    ]
]
TURTLE
}

star_script() -> string {
    return <<TURTLE
back 70

repeat 12 [
    repeat 160 [
        fd 100
        rt 100
    ]
    rt 60
]
TURTLE
}

geometric_form_script() -> string {
    return <<TURTLE
repeat 8 [
    repeat 8 [
        fd 50
        rt 45
    ]
    rt 45
]
TURTLE
}

house_script() -> string {
    return <<TURTLE
penup
back 120
left 90
forward 140
right 90
pendown

fd 150
rt 90
fd 300
rt 90
fd 150
rt 90
fd 300
rt 90

penup
forward 150
pendown
right 45
forward 60
right 45
forward 217
right 45
forward 60

penup
right 45
fd 150
right 90
fd 260
right 90
pendown

fd 60
rt 90
fd 30
rt 90
fd 60

penup
back 120
left 90
back 30
pendown

fd 60
rt 90
fd 30
rt 90
fd 60
rt 90
fd 30
rt 90

penup
fd 80
pendown

fd 60
rt 90
fd 30
rt 90
fd 60
rt 90
fd 30
rt 90

penup
fd 80
pendown

fd 60
rt 90
fd 30
rt 90
fd 60
rt 90
fd 30
rt 90

penup
rt 90
fd 62
right 90
fd 100
rt 180
pendown

fd 120
rt 90
fd 40
rt 90
fd 120
rt 90
fd 40
rt 90
TURTLE
}

// One redraw path for everything: Run, zoom, pan and Reset all go through
// this, so the canvas can never disagree with the view state.
redraw(st: *TurtleUiState) {
    run_turtle_script_view(st.canvas, CANVAS_W(), CANVAS_H(),
                           ui.textarea_get_text(st.editor),
                           st.scale, st.panx, st.pany)
    if st.status != 0 {
        pct = st.scale * 100.0
        aether_ui_text_set_string(st.status, "zoom: ${pct}%  (+ / - to zoom; scroll works where the trackpad sends it)")
    }
}

main() {
    ui.window("Turtle", 920, 620) {

        // A malloc'd struct, not plain locals — `editor`/`canvas` are each
        // assigned exactly once, but by the time that assignment runs, the
        // picker's callback (built first, above the textarea) and the Run
        // button's callback (built inside `left`, before `canvas` is built
        // in the sibling block after it) have ALREADY been created. A
        // closure that only READS an outer local captures it BY VALUE at
        // closure-CREATION time, not live — confirmed by running this: the
        // picker's callback silently no-opped (editor read as 0) and Run
        // silently drew nothing (canvas read as 0), because both closures
        // were created before the real assignment ran. Same fix as
        // ui.auto_hide's setup_timer bug: field-writes through an
        // already-valid pointer sidestep the whole issue, since the
        // POINTER itself is assigned once, before any closure exists.
        app_state = malloc(80) as *TurtleUiState
        app_state.editor = 0
        app_state.canvas = 0
        app_state.scale = 1.0
        app_state.panx = 0.0
        app_state.pany = 0.0
        app_state.status = 0

        root = ui.hstack(12) {

            left = ui.vstack(8) {
                title = ui.text("Turtle")
                title.style_font_size(16).style_font_bold()

                examples = ui.picker() callback |idx: int| {
                    if idx == 0 { ui.textarea_set_text(app_state.editor, flower_script()) }
                    if idx == 1 { ui.textarea_set_text(app_state.editor, star_script()) }
                    if idx == 2 { ui.textarea_set_text(app_state.editor, geometric_form_script()) }
                    if idx == 3 { ui.textarea_set_text(app_state.editor, house_script()) }
                }
                ui.picker_add(examples, "flower")
                ui.picker_add(examples, "star")
                ui.picker_add(examples, "geometric_form")
                ui.picker_add(examples, "house")

                app_state.editor = ui.textarea("forward 50 ...") callback |val: string| { }
                ui.width(app_state.editor, 300)

                run = ui.btn("Run") callback { redraw(app_state) }

                // Zoom controls, so the feature is reachable without a
                // touchpad (and testable through the driver, which cannot
                // synthesise a wheel event).
                zoomrow = ui.hstack(6) {
                    _zin = ui.btn("+") callback {
                        app_state.scale = app_state.scale * 1.25
                        redraw(app_state)
                    }
                    _zout = ui.btn("-") callback {
                        app_state.scale = app_state.scale / 1.25
                        redraw(app_state)
                    }
                    _zreset = ui.btn("Reset view") callback {
                        app_state.scale = 1.0
                        app_state.panx = 0.0
                        app_state.pany = 0.0
                        redraw(app_state)
                    }
                }
                app_state.status = ui.text("zoom: 100%  (+ / - to zoom; scroll works where the trackpad sends it)")
            }
            ui.width(left, 320)

            ui.divider()

            // The DISPLAYED size ends up larger than 560x560 (an hstack
            // canvas expands to absorb layout slack — confirmed by running
            // this: 552x572, not 560x560; ui.width/height don't override it,
            // the same expand-vs-constrain tension grand_perspective's
            // aeui_mark_expand exists for). Cosmetic only — canvas contents
            // scale to fit the widget bounds, same as examples/canvas's own
            // fixed-buffer-in-a-flexible-container precedent, just a slight
            // aspect-ratio skew rather than a functional bug.
            app_state.canvas = ui.canvas_create(560, 560)
            ui.canvas_fill_rect(app_state.canvas, 0.0, 0.0, CANVAS_W(), CANVAS_H(), 1.0, 1.0, 1.0, 1.0)
            ui.canvas_redraw(app_state.canvas)

            // Wheel / two-finger scroll over the canvas.
            //   plain scroll  -> zoom (dy < 0 = away from you = zoom in)
            //
            // SHIFT-SCROLL TO PAN IS NOT IMPLEMENTED, and the label no longer
            // claims it: canvas_on_scroll passes only (dx, dy), so the
            // modifier never crosses the ABI and there is nothing to branch
            // on. The modifier IS available at the GTK layer --
            // apps/gesture_probe measured mods=257 (256+SHIFT) on a
            // shift-held drag -- so this wants canvas_on_scroll widened to
            // carry mods, not a workaround here.
            //
            // NB on a Chromebook trackpad (Crostini) NEITHER pinch NOR
            // two-finger scroll reaches the app at all; see gesture_probe's
            // header for the measurements. The +/- buttons are the reliable
            // path there.
            // Pan rather than a scrollview: the canvas is a fixed-size widget
            // whose CONTENT grows, not a widget that grows, so there is no
            // larger child for a scrollview to scroll. Moving the origin is
            // the honest equivalent, and it costs one re-run.
            ui.canvas_on_scroll(app_state.canvas) callback |dx: float, dy: float| {
                if dy < 0.0 {
                    app_state.scale = app_state.scale * 1.1
                } else if dy > 0.0 {
                    app_state.scale = app_state.scale / 1.1
                }
                // Keep it usable: below ~0.1 the drawing is a dot, above 20x
                // a single step can take a minute to re-run.
                if app_state.scale < 0.1 { app_state.scale = 0.1 }
                if app_state.scale > 20.0 { app_state.scale = 20.0 }
                redraw(app_state)
            }
        }
        ui.margin_of(root, 12, 12, 12, 12)

        ui.textarea_set_text(app_state.editor, flower_script())
        run_turtle_script(app_state.canvas, CANVAS_W(), CANVAS_H(), flower_script())

        if os_getenv("AETHER_UI_TEST_PORT") != null { ui.enable_test_server(9222) }
    }
}
