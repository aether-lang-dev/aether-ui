import bldr
import aether
import aether (source, output, no_closure_regen, lib)
import build_support.aetherui (ui_backend)

main() {
    bldr.build() {
        root = _get("root")
        aether.program() {
            source("vg_png.ae")
            output("vg_png")
            lib("${root}")
            no_closure_regen()
            ui_backend(root)
        }
        return 0
    }
}
