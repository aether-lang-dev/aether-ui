// maerkdown.ae — a word-as-widget document editor speaking basic markdown.
//
// Every word on the page is a first-class object: it has a measured box,
// paints itself as glyph geometry, and answers to pointing (wordflow.ae).
// The editor leans into that — the unit of editing IS the word:
//   type letters   build the word at the caret (it reflows live, accent
//                  ink, committed by space / Enter / a click elsewhere)
//   click a word   EXPAND it: the word's full markdown source (markers
//                  and all — ==highlight==, **bold**) replaces it in the
//                  editing line, char-addressable and editable. The
//                  momentary non-WYSIWYG view; commit re-parses, so
//                  editing the delimiters IS restyling.
//   arrows         caret moves by CHARACTER; walking into a word expands
//                  it the same way, Up/Down move by layout LINE
//   click a gap    move the caret there
//   BackSpace      deletes at the cursor; at a gap, expands the previous
//                  word — words come apart the way they went together
//   Enter          split the block at the caret (headings hand off to a
//                  fresh paragraph, lists continue as lists)
// Toolbar/shortcut toggles queue on `pend` and XOR into the word at
// commit — press B on an expanded **word** and it un-bolds. Block
// commands (H1/H2/H3/¶/•/code) retype the caret's block in place.
//
// The document model and its markdown round-trip live in mdown.ae; Source
// publishes md_serialize of the live model. Styling is geometric all the
// way down: bold is the stroker thickening glyph outlines, italic is the
// path toolkit shearing them — the same vg surface every backend renders
// identically.
//
// Render-on-demand: a static scene, one refresh per edit. An idle editor
// costs nothing.
//
// Run: DISPLAY=:0 ./target/build/apps/maerkdown/bin/maerkdown

import ui (
    window, vstack, hstack, text, text_wrapped, btn, enable_test_server,
    canvas_on_click, canvas_on_key,
    canvas_read_pixel, canvas_widget, width, height, widget_shortcut, scrollview,
    ui_state_s, ui_set_s, bind_text,
    menu_bar, menu, menu_item, menu_item_accel, menu_separator, menu_bar_add,
    attach_menu_bar_to_window, open_file, save_file
)
import vg.live (vg, canvas_region, region_set_animated)
import vg (
    view_box, rect, fill, vg_root, node_scene, scene_canvas,
    scene_refresh, scene_px_to_vb_x, scene_px_to_vb_y
)
import mdown
import wordflow
import std.list
import std.string
import std.fs
import std.os (os_getenv)

extern malloc(size: int) -> ptr
extern free(p: ptr)
extern string_substring(s: string, start: int, end: int) -> string
extern string_retain(s: string)

const SC_W: int = 560
const SC_H: int = 430

struct Ed {
    doc: ptr
    lo: ptr          // current wordflow layout
    cb: int          // caret block
    cg: int          // caret gap (0..word_count)
    buf: string      // the word being typed / edited ("" = none)
    bpos: int        // caret position WITHIN buf (0..len)
    pend: int        // style flags for words typed next
    canvas: int
    scene: ptr
    st_stat: int
    st_caret: int
    st_src: int
    cur_path: string   // last opened/saved path ("" = untitled)
}

// ---- publishing ------------------------------------------------------------

publish(ed: *Ed) {
    nb = mdown.md_doc_blocks(ed.doc)
    nw = 0
    i = 0
    while i < nb {
        nw = nw + mdown.md_block_words(mdown.md_doc_block(ed.doc, i))
        i = i + 1
    }
    _a = ui_set_s(ed.st_stat, "blocks: ${nb} words: ${nw}")
    _b = ui_set_s(ed.st_caret,
        "caret: ${ed.cb}/${ed.cg} pend: ${ed.pend} buf: [${ed.buf}] cpos: ${ed.bpos}")
}

// Rebuild the layout from the model and repaint. The single funnel every
// edit goes through.
relayout(ed: *Ed) {
    if ed.lo != null { wordflow.wf_free(ed.lo) }
    ed.lo = wordflow.wf_layout(ed.doc, SC_W * 1.0, ed.cb, ed.cg, ed.buf, ed.bpos)
    publish(ed)
    _r = scene_refresh(ed.scene)
}

// ---- editing core ----------------------------------------------------------

set_buf(ed: *Ed, s: string) {
    string_retain(s)
    ed.buf = s
}

// XOR two flag words bit-by-bit (no ^ operator in the language).
flags_xor(a: int, b: int) -> int {
    r = 0
    bit = 1
    while bit <= 128 {
        if (a / bit) % 2 + (b / bit) % 2 == 1 { r = r + bit }
        bit = bit * 2
    }
    return r
}

// Commit the buffer into the model at the caret gap. The buffer is the
// word's SOURCE form: parse it (markers → flags, stripped text), then
// XOR the pending toolbar toggles in — so B on an expanded **word**
// un-bolds it, and B before typing a fresh word bolds it. A marker-only
// or empty buffer commits nothing. Sup/sub can both survive an XOR
// (word had one, pend the other): the pending one wins.
commit_word(ed: *Ed) {
    if string.length(ed.buf) == 0 { ed.pend = 0; return }
    pw = mdown.md_parse_word(ed.buf)
    txt = mdown.md_word_text(pw)
    fl = flags_xor(mdown.md_word_flags(pw), ed.pend)
    if (fl / mdown.MD_SUP) % 2 == 1 && (fl / mdown.MD_SUB) % 2 == 1 {
        if (ed.pend / mdown.MD_SUP) % 2 == 1 { fl = fl - mdown.MD_SUB }
        else { fl = fl - mdown.MD_SUP }
    }
    if string.length(txt) > 0 {
        bp = mdown.md_doc_block(ed.doc, ed.cb)
        cp = string.copy(txt)
        string_retain(cp)
        mdown.md_insert_word(bp, ed.cg, cp, fl)
        ed.cg = ed.cg + 1
    }
    free(pw)
    set_buf(ed, "")
    ed.bpos = 0
    ed.pend = 0
}

// Lift word `wi` of the caret block into the buffer in its SOURCE form
// (the expand half of expand/edit/commit). Cursor placement is the
// caller's business.
lift_word(ed: *Ed, wi: int) {
    bp = mdown.md_doc_block(ed.doc, ed.cb)
    wp = mdown.md_block_word(bp, wi)
    src = mdown.md_word_source(wp)
    string_retain(src)
    mdown.md_remove_word(bp, wi)
    ed.pend = 0
    set_buf(ed, src)
}

// Enter: split the caret block at the gap. Words after the caret move to
// the new block. Headings hand off to a paragraph; lists continue as
// lists, code as code.
split_block(ed: *Ed) {
    commit_word(ed)
    bp = mdown.md_doc_block(ed.doc, ed.cb)
    kind = mdown.md_block_kind(bp)
    nk = kind
    if kind == mdown.MD_H1 || kind == mdown.MD_H2 || kind == mdown.MD_H3 {
        nk = mdown.MD_PARA
    }
    tail = mdown.md_insert_block(ed.doc, ed.cb + 1, nk)
    while mdown.md_block_words(bp) > ed.cg {
        wp = mdown.md_block_word(bp, ed.cg)
        cp = string.copy(mdown.md_word_text(wp))
        string_retain(cp)
        mdown.md_insert_word(tail, mdown.md_block_words(tail), cp,
                             mdown.md_word_flags(wp))
        mdown.md_remove_word(bp, ed.cg)
    }
    ed.cb = ed.cb + 1
    ed.cg = 0
}

// BackSpace, in falling order of specificity: trim the live word; delete
// the selection; LIFT the word before the caret back into the buffer
// (editable again, styling preserved in pend); merge this block into the
// previous one at a block start.
backspace(ed: *Ed) {
    n = string.length(ed.buf)
    if n > 0 {
        if ed.bpos <= 0 { return }
        head = string_substring(ed.buf, 0, ed.bpos - 1)
        tail = string_substring(ed.buf, ed.bpos, n)
        joined = "${head}${tail}"
        string_retain(joined)
        ed.buf = joined
        ed.bpos = ed.bpos - 1
        return
    }
    if ed.cg > 0 {
        lift_word(ed, ed.cg - 1)
        ed.cg = ed.cg - 1
        ed.bpos = string.length(ed.buf)
        return
    }
    if ed.cb > 0 {
        bp = mdown.md_doc_block(ed.doc, ed.cb)
        prev = mdown.md_doc_block(ed.doc, ed.cb - 1)
        junction = mdown.md_block_words(prev)
        while mdown.md_block_words(bp) > 0 {
            wp = mdown.md_block_word(bp, 0)
            cp = string.copy(mdown.md_word_text(wp))
            string_retain(cp)
            mdown.md_insert_word(prev, mdown.md_block_words(prev), cp,
                                 mdown.md_word_flags(wp))
            mdown.md_remove_word(bp, 0)
        }
        mdown.md_remove_block(ed.doc, ed.cb)
        ed.cb = ed.cb - 1
        ed.cg = junction
    }
}

// Queue a style toggle: XORed into the buffer's word at commit. On an
// expanded word this means toggle; on a fresh word, apply.
toggle_flag(ed: *Ed, bit: int) {
    ed.pend = flags_xor(ed.pend, bit)
    relayout(ed)
}

// Toggle `bit` but clear `other` when setting — super/subscript are
// mutually exclusive.
toggle_excl(ed: *Ed, bit: int, other: int) {
    if (ed.pend / bit) % 2 == 1 { ed.pend = ed.pend - bit }
    else {
        ed.pend = ed.pend + bit
        if (ed.pend / other) % 2 == 1 { ed.pend = ed.pend - other }
    }
    relayout(ed)
}

// Retype the caret's block (or the selection's). Bullet toggles back to
// paragraph when applied twice.
set_kind(ed: *Ed, kind: int) {
    bp = mdown.md_doc_block(ed.doc, ed.cb)
    if kind == mdown.MD_BULLET && mdown.md_block_kind(bp) == mdown.MD_BULLET {
        mdown.md_block_set_kind(bp, mdown.MD_PARA)
    } else {
        mdown.md_block_set_kind(bp, kind)
    }
    relayout(ed)
}

// ---- files -----------------------------------------------------------------

// Frees the old model: anything still holding into it dangles after this.
load_path(ed: *Ed, path: string) -> string {
    src, err = fs.read(path)
    if err != "" { return err }
    mdown.md_doc_free(ed.doc)
    ed.doc = mdown.md_parse(src)
    ed.cb = 0
    ed.cg = 0
    set_buf(ed, "")
    ed.bpos = 0
    ed.pend = 0
    string_retain(path)
    ed.cur_path = path
    relayout(ed)
    return ""
}

// Commits the in-flight word first, or the word being typed is missing from
// what lands on disk.
save_path(ed: *Ed, path: string) -> string {
    if string.length(ed.buf) > 0 {
        commit_word(ed)
        relayout(ed)
    }
    err = fs.write(path, mdown.md_serialize(ed.doc))
    if err != "" { return err }
    string_retain(path)
    ed.cur_path = path
    return ""
}

save_or_prompt(ed: *Ed) {
    path = ed.cur_path
    if string.length(path) == 0 {
        path = save_file("Save markdown", "untitled.md")
        if string.length(path) == 0 { return }
    }
    err = save_path(ed, path)
    if err != "" {
        _e = ui_set_s(ed.st_src, "save failed: ${err}")
    } else {
        _s = ui_set_s(ed.st_src, "saved: ${path}")
    }
}

// ---- keyboard --------------------------------------------------------------

// GDK key names → typed characters. Single-character names (letters,
// digits, shifted symbols the backend already resolves) pass through;
// the named punctuation earns a table. Unknown names type nothing.
key_char(k: string) -> string {
    if string.length(k) == 1 { return k }
    if string.equals(k, "period") == 1 { return "." }
    if string.equals(k, "comma") == 1 { return "," }
    if string.equals(k, "apostrophe") == 1 { return "'" }
    if string.equals(k, "quotedbl") == 1 { return "\"" }
    if string.equals(k, "colon") == 1 { return ":" }
    if string.equals(k, "semicolon") == 1 { return ";" }
    if string.equals(k, "exclam") == 1 { return "!" }
    if string.equals(k, "question") == 1 { return "?" }
    if string.equals(k, "minus") == 1 { return "-" }
    if string.equals(k, "plus") == 1 { return "+" }
    if string.equals(k, "equal") == 1 { return "=" }
    if string.equals(k, "underscore") == 1 { return "_" }
    if string.equals(k, "slash") == 1 { return "/" }
    if string.equals(k, "numbersign") == 1 { return "#" }
    if string.equals(k, "ampersand") == 1 { return "&" }
    if string.equals(k, "at") == 1 { return "@" }
    if string.equals(k, "asterisk") == 1 { return "*" }
    if string.equals(k, "parenleft") == 1 { return "(" }
    if string.equals(k, "parenright") == 1 { return ")" }
    if string.equals(k, "percent") == 1 { return "%" }
    if string.equals(k, "dollar") == 1 { return "$" }
    if string.equals(k, "bar") == 1 { return "|" }
    if string.equals(k, "asciicircum") == 1 { return "^" }
    if string.equals(k, "asciitilde") == 1 { return "~" }
    if string.equals(k, "grave") == 1 { return "`" }
    if string.equals(k, "less") == 1 { return "<" }
    if string.equals(k, "greater") == 1 { return ">" }
    if string.equals(k, "bracketleft") == 1 { return "[" }
    if string.equals(k, "bracketright") == 1 { return "]" }
    return ""
}

on_key(ed: *Ed, k: string) {
    if string.equals(k, "space") == 1 {
        commit_word(ed)
        relayout(ed)
        return
    }
    if string.equals(k, "Return") == 1 {
        split_block(ed)
        relayout(ed)
        return
    }
    if string.equals(k, "BackSpace") == 1 {
        backspace(ed)
        relayout(ed)
        return
    }
    if string.equals(k, "Escape") == 1 {
        commit_word(ed)
        relayout(ed)
        return
    }
    if string.equals(k, "Up") == 1 || string.equals(k, "Down") == 1 {
        // Vertical movement is a LAYOUT question: take the caret's pixel
        // position, aim one line up/down, and ask the layout which gap
        // is nearest. (Blocks with no words have no lines, so Up/Down
        // steps over empty blocks; Left/Right still reaches them.)
        cx = wordflow.wf_caret_x(ed.lo)
        cy = wordflow.wf_caret_y(ed.lo)
        chh = wordflow.wf_caret_h(ed.lo)
        if string.length(ed.buf) > 0 {
            commit_word(ed)
            relayout(ed)
        }
        ty = cy - 6.0
        if string.equals(k, "Down") == 1 { ty = cy + chh + 6.0 }
        code = wordflow.wf_hit_gap(ed.lo, ed.doc, cx, ty)
        ed.cb = wordflow.wf_gap_block(code)
        ed.cg = wordflow.wf_gap_index(code)
        relayout(ed)
        return
    }
    // Left/Right are CHARACTER-wise. Inside the live buffer the cursor
    // just moves; at a buffer edge the word commits and the caret crosses
    // the gap; and moving INTO a committed word lifts it back into the
    // buffer with the cursor at the entered end — per-character traversal
    // over a word-grained model.
    if string.equals(k, "Left") == 1 {
        if string.length(ed.buf) > 0 {
            if ed.bpos > 0 {
                ed.bpos = ed.bpos - 1
                relayout(ed)
                return
            }
            // At the word's left edge: commit and sit BEFORE it.
            commit_word(ed)
            ed.cg = ed.cg - 1
            relayout(ed)
            return
        }
        if ed.cg > 0 {
            // Enter the previous word from its right end — it expands to
            // its SOURCE form, cursor one step inside the trailing
            // markers.
            lift_word(ed, ed.cg - 1)
            ed.cg = ed.cg - 1
            ed.bpos = string.length(ed.buf) - 1
            if ed.bpos < 0 { ed.bpos = 0 }
            relayout(ed)
            return
        }
        if ed.cb > 0 {
            ed.cb = ed.cb - 1
            ed.cg = mdown.md_block_words(mdown.md_doc_block(ed.doc, ed.cb))
        }
        relayout(ed)
        return
    }
    if string.equals(k, "Right") == 1 {
        if string.length(ed.buf) > 0 {
            if ed.bpos < string.length(ed.buf) {
                ed.bpos = ed.bpos + 1
                relayout(ed)
                return
            }
            // At the word's right edge: commit; caret lands after it.
            commit_word(ed)
            relayout(ed)
            return
        }
        nw = mdown.md_block_words(mdown.md_doc_block(ed.doc, ed.cb))
        if ed.cg < nw {
            // Enter the next word from its left end — source form, cursor
            // one step past the leading marker (or first char).
            lift_word(ed, ed.cg)
            ed.bpos = 1
            if ed.bpos > string.length(ed.buf) { ed.bpos = string.length(ed.buf) }
            relayout(ed)
            return
        }
        if ed.cb + 1 < mdown.md_doc_blocks(ed.doc) {
            ed.cb = ed.cb + 1
            ed.cg = 0
        }
        relayout(ed)
        return
    }
    ch = key_char(k)
    if string.length(ch) == 0 { return }
    blen = string.length(ed.buf)
    if ed.bpos > blen { ed.bpos = blen }
    head = string_substring(ed.buf, 0, ed.bpos)
    tail = string_substring(ed.buf, ed.bpos, blen)
    grown = "${head}${ch}${tail}"
    string_retain(grown)
    ed.buf = grown
    ed.bpos = ed.bpos + 1
    relayout(ed)
}

// ---- pointing --------------------------------------------------------------

on_click(ed: *Ed, x: float, y: float) {
    // Commit any in-flight edit and RELAYOUT before hit-testing: the
    // committed word's box replaces the buffer's virtual box, and the
    // click must resolve against what is actually on screen now.
    if string.length(ed.buf) > 0 {
        commit_word(ed)
        relayout(ed)
    }
    hi = wordflow.wf_hit_word(ed.lo, x, y)
    if hi >= 0 {
        // EXPAND the clicked word into its source form, cursor placed
        // proportionally to where in the word the click landed (left
        // edge → before the leading marker).
        bx = wordflow.wf_box_x(ed.lo, hi)
        bw = wordflow.wf_box_w(ed.lo, hi)
        ed.cb = wordflow.wf_box_bi(ed.lo, hi)
        ed.cg = wordflow.wf_box_wi(ed.lo, hi)
        lift_word(ed, ed.cg)
        blen = string.length(ed.buf)
        rel = 0.0
        if bw > 0.0 { rel = (x - bx) / bw }
        if rel < 0.0 { rel = 0.0 }
        if rel > 1.0 { rel = 1.0 }
        pos = rel * (blen * 1.0) + 0.5
        ed.bpos = pos as int
        if ed.bpos > blen { ed.bpos = blen }
        if ed.bpos < 0 { ed.bpos = 0 }
    } else {
        code = wordflow.wf_hit_gap(ed.lo, ed.doc, x, y)
        ed.cb = wordflow.wf_gap_block(code)
        ed.cg = wordflow.wf_gap_index(code)
    }
    relayout(ed)
}

draw_page(ed: *Ed, rn: ptr) {
    bg = rect(rn, 0.0, 0.0, SC_W * 1.0, SC_H * 1.0)
    fill(bg, "#14141c")
    if ed.lo != null {
        wordflow.wf_render(rn, ed.doc, ed.lo, 0 - 1, ed.buf)
    }
}

// PAGE-DARK coverage on a 4px grid (driver probe). The probe counts the
// page background (#14141c) and its dark plates — NOT the glyphs —
// because dark is the one signal no backend can fake: on backends whose
// height pin is advisory the replay bitmap can outsize the mapped area
// and leak a WHITE ground (the sketchpad lesson), and this app's ink is
// near-white by design. White leak can never read as dark. The lever
// inverts accordingly: bolding a word THICKENS its glyphs and so
// REMOVES dark samples — bold_dark < plain_dark, on every backend.
probe(ed: *Ed) -> int {
    dark = 0
    y = 2
    while y < SC_H {
        x = 2
        while x < SC_W {
            pv = canvas_read_pixel(ed.canvas, x, y, SC_W, SC_H)
            if ((pv >> 16) & 255) < 60 && (pv & 255) < 90 { dark = dark + 1 }
            x = x + 4
        }
        y = y + 4
    }
    return dark
}

main() {
    ed = malloc(104) as *Ed
    ed.doc = mdown.md_doc_new()
    ed.lo = null
    ed.cb = 0
    ed.cg = 0
    ed.buf = ""
    ed.bpos = 0
    ed.pend = 0
    ed.cur_path = ""
    stat = ui_state_s("blocks: 1 words: 0")
    car = ui_state_s("caret: 0/0 pend: 0 buf: [] cpos: 0")
    src = ui_state_s("source: (press Source)")
    inkl = ui_state_s("dark: unprobed")
    ed.st_stat = stat
    ed.st_caret = car
    ed.st_src = src

    window("Maerkdown", 600, 660) {
        vstack(6) {
            hstack(6) {
                btn("B") callback { toggle_flag(ed, mdown.MD_BOLD) }
                btn("I") callback { toggle_flag(ed, mdown.MD_ITALIC) }
                btn("U") callback { toggle_flag(ed, mdown.MD_UNDER) }
                btn("Code") callback { toggle_flag(ed, mdown.MD_CODEW) }
                btn("Mark") callback { toggle_flag(ed, mdown.MD_MARK) }
                btn("Spoil") callback { toggle_flag(ed, mdown.MD_SPOIL) }
                btn("Sup") callback {
                    toggle_excl(ed, mdown.MD_SUP, mdown.MD_SUB)
                }
                btn("Sub") callback {
                    toggle_excl(ed, mdown.MD_SUB, mdown.MD_SUP)
                }
            }
            hstack(6) {
                btn("H1") callback { set_kind(ed, mdown.MD_H1) }
                btn("H2") callback { set_kind(ed, mdown.MD_H2) }
                btn("H3") callback { set_kind(ed, mdown.MD_H3) }
                btn("P") callback { set_kind(ed, mdown.MD_PARA) }
                btn("List") callback { set_kind(ed, mdown.MD_BULLET) }
                btn("Sample") callback {
                    mdown.md_doc_free(ed.doc)
                    ed.doc = mdown.md_parse("# Maerkdown\n\nEvery word here is an object with a box. Click one to select it, then restyle it.\n\n- point at words\n- type new ones\n- **bold** is the stroker at work\n\nItalic is a *shear* on the glyph outlines. Also: ++insertion++ ==highlight== ^raised^ ~lowered~ and a ||spoiler|| (click it).")
                    ed.cb = 0
                    ed.cg = 1
                    set_buf(ed, "")
                    ed.bpos = 0
                    ed.pend = 0
                    relayout(ed)
                }
                btn("Source") callback {
                    _s = ui_set_s(ed.st_src, mdown.md_serialize(ed.doc))
                }
                btn("Probe") callback {
                    _p = ui_set_s(inkl, "dark: ${probe(ed)}")
                }
            }
            vg(view_box(0, 0, 560, 430), SC_W, SC_H) {
                anchor = rect(0.0, 0.0, 0.0, 0.0)
                root_node = vg_root(node_scene(anchor))
                ed.scene = node_scene(root_node)
                ed.canvas = scene_canvas(node_scene(root_node))
                _w = width(canvas_widget(ed.canvas), SC_W)
                _h = height(canvas_widget(ed.canvas), SC_H)
                reg = canvas_region(root_node, 0.0, 0.0, SC_W * 1.0, SC_H * 1.0)
                    callback |rn: ptr, tt: float| {
                        draw_page(ed, rn)
                    }
                region_set_animated(reg, 0)
                ed.lo = wordflow.wf_layout(ed.doc, SC_W * 1.0, 0, 0, "", 0)

                cid = scene_canvas(node_scene(root_node))
                canvas_on_click(cid) callback |px: float, py: float| {
                    on_click(ed, scene_px_to_vb_x(ed.scene, px),
                                 scene_px_to_vb_y(ed.scene, py))
                }
                canvas_on_key(cid) callback |k: string| {
                    on_key(ed, k)
                }
                widget_shortcut(canvas_widget(cid), "Ctrl+B") callback {
                    toggle_flag(ed, mdown.MD_BOLD)
                }
                widget_shortcut(canvas_widget(cid), "Ctrl+I") callback {
                    toggle_flag(ed, mdown.MD_ITALIC)
                }
                widget_shortcut(canvas_widget(cid), "Ctrl+U") callback {
                    toggle_flag(ed, mdown.MD_UNDER)
                }
            }
            t_s = text("blocks: 1 words: 0")
            bind_text(t_s, stat)
            t_c = text("caret: 0/0 pend: 0 buf: [] cpos: 0")
            bind_text(t_c, car)
            // Wrapping + scrolling, not clipping: serialized markdown
            // lines are long, and a plain label CLIPS each line at the
            // window edge — the tail of a line (and every marker in it)
            // silently vanished. Wrapped lines in turn overflow the
            // window bottom, so the source lives in its own scrollview.
            src_scroll = scrollview() {
                t_src = text_wrapped("source: (press Source)", 560)
                bind_text(t_src, src)
            }
            _sh = height(src_scroll, 120)
            t_i = text("dark: unprobed")
            bind_text(t_i, inkl)
        }
        // Window handle 1 is the primary window this builder owns.
        bar = menu_bar()
        fmenu = menu("File")
        menu_item(fmenu, "Open...") callback {
            path = open_file("Open markdown")
            if string.length(path) > 0 {
                err = load_path(ed, path)
                if err != "" {
                    _f = ui_set_s(ed.st_src, "open failed: ${err}")
                } else {
                    _o = ui_set_s(ed.st_src, "opened: ${path}")
                }
            }
        }
        menu_item_accel(fmenu, "Save", "Ctrl+S") callback {
            save_or_prompt(ed)
        }
        menu_item(fmenu, "Save As...") callback {
            path = save_file("Save markdown as", "untitled.md")
            if string.length(path) > 0 {
                err = save_path(ed, path)
                if err != "" {
                    _e = ui_set_s(ed.st_src, "save failed: ${err}")
                } else {
                    _s = ui_set_s(ed.st_src, "saved: ${path}")
                }
            }
        }
        menu_separator(fmenu)
        menu_item(fmenu, "Quit") callback { exit(0) }
        menu_bar_add(bar, fmenu)
        attach_menu_bar_to_window(1, bar)

        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
