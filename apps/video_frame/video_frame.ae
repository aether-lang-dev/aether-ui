// video_frame.ae — an MP4 playing inside a ui.frames internal frame, with
// other Aether-UI widgets around it.
//
// Decode is IN-PROCESS via contrib.avcodec (aether 63b42e55). The earlier
// version spawned ffmpeg to transcode the whole clip to a raw-RGBA file and
// fs.pread'd frames back out: 27.6 MB for six seconds of 320x240, ~1.5 GB
// per minute of 1080p, and no workaround at all for a LIVE source, which has
// no file to read. That intermediate is gone.
//
// Everything below region_push is unchanged from that version -- which was
// the point of the exercise: the region path did not care where the pixels
// came from.
//
// avcodec.next_frame_into writes into ONE reused buffer, so playback costs
// no per-frame allocation. bytes.to_string then hands the region a string
// without consuming the buffer (bytes.finish would destroy it).
//
//   VF_CLIP=/path/clip.mp4 ./build/video_frame
//
import ui
import ui (window, vstack, hstack, text, btn, enable_test_server,
           ui_state_s, ui_set_s, bind_text, canvas_widget, width, height,
           canvas_on_click, canvas_on_move, canvas_on_release)
import vg.live (vg, canvas_region, region_set_animated)
import vg (view_box, rect, text_sized, fill, stroke, vg_root, node_scene,
           scene_refresh, scene_set_refreshing, opacity, scene_canvas)
import vg.region
import ui.frames (
    frames, frame, frame_invalidate, frame_set_opacity, frame_bounds,
    frames_draw, frames_rerender_count, frames_blit_count,
    frames_on_click, frames_on_move, frames_on_release
)
import std.fs
import std.os
import std.os (os_getenv)
import contrib.avcodec
import std.audio
import std.string
import std.list
import std.bytes

extern malloc(size: int) -> ptr
extern free(p: ptr)
extern lrint(x: float) -> long

// Clip geometry. Env-overridable because these are the numbers you vary
// when asking "how fast can this actually go" -- see VF_W / VF_H / VF_FPS.
env_int(name: string, dflt: int) -> int {
    v = os_getenv(name)
    if string.length(v) == 0 { return dflt }
    n, ok = string.to_int(v)
    if ok == 0 { return dflt }
    return n
}

VW_of() -> int { return env_int("VF_W", 320) }
VH_of() -> int { return env_int("VF_H", 240) }
FPS_of() -> float { return (env_int("VF_FPS", 15) as float) }
// viewBox units == canvas pixels, deliberately. ui.frames hit-tests the
// coordinates canvas_on_click delivers, which are canvas PIXELS; if the
// viewBox is a different size those coordinates are scaled and every click
// misses the frame it looks like it hit. frames_demo has the same 1:1
// mapping for the same reason. Keep CW/CH equal to the vg() canvas size.
const CW: int = 900
const CH: int = 600

struct App {
    host: ptr
    scene: ptr
    canvas: int
    vframe: ptr
    st_status: int
    dec: ptr         // contrib.avcodec decoder
    t0: float        // scene clock at playback start (or after a loop)
    held: int        // frames NOT presented because their PTS was in the future
    late: int        // frames dropped because their PTS was already past
    looped: int      // set on wrap; tells present_at to stop for this tick
    asrc: ptr        // std.audio source; null = no audio, scene clock is master
    aclock: int      // 1 = presenting against the AUDIO clock
    src: string      // clip path, kept for the loop-at-EOF reopen
    buf: ptr         // ONE reusable frame buffer, w*h*4
    rgn: ptr         // the raster region the frames are pushed into
    shown: int       // how many frames have been presented
    pts: int         // presentation timestamp of the last frame, ms
}

// Open the clip. The decoder scales to VW x VH during its RGBA conversion,
// so resizing costs no extra pass.
open_clip(src: string) -> ptr {
    d, err = avcodec.open(src, VW_of(), VH_of())
    if string.length(err) > 0 {
        println("avcodec.open failed: ${err}")
        return null
    }
    num, den = avcodec.fps(d)
    println("clip: ${avcodec.width(d)}x${avcodec.height(d)} fps=${num}/${den}")
    return d
}

// Present the next frame. At EOF, reopen and loop -- there is no seek in the
// v1 shim surface, and reopening a local file is cheap.
// present_at(app, t) — show the frame whose PRESENTATION TIME has arrived.
//
// The old policy was "one decoded frame per paint tick", which plays at
// whatever rate the compositor happens to paint: measured 41fps for a 15fps
// clip, ~2.7x too fast, and a 60fps clip would crawl. Frame rate was a
// property of the renderer rather than of the video.
//
// Now the decoder's own PTS decides. Wall-clock elapsed comes from the scene
// clock `t`; a frame is presented once its pts_ms is due, HELD if it is
// still in the future (paint again, same pixels -- the region blits the
// cached frame, costing nothing), and if decode falls behind we keep
// decoding until we catch up rather than presenting stale frames in slow
// motion.
//
// This is the half of A/V sync that does not need audio: video correct
// against a clock. Adding audio later means swapping the scene clock for the
// audio device's clock -- the structure does not change, which is why it is
// worth doing first.
present_at(app: *App, t: float) {
    if app.dec == null { return }

    // THE A/V SYNC SUBSTITUTION. With audio loaded the master clock is the
    // audio DEVICE's own position, not the scene clock -- audio cannot drop
    // or repeat samples the way video can drop frames, so it leads and video
    // chases. Without audio the scene clock stands in and the rest of this
    // function is unchanged, which is exactly what presenting on PTS bought:
    // the timing structure did not have to change to gain sync.
    elapsed_ms = 0.0
    if app.aclock == 1 {
        elapsed_ms = (audio.position_ms(app.asrc) as float)
    } else {
        if app.t0 < 0.0 { app.t0 = t }
        elapsed_ms = (t - app.t0) * 1000.0
    }

    // Already showed a frame whose time has not come yet -- hold it.
    if app.shown > 0 {
        if (app.pts as float) > elapsed_ms {
            app.held = app.held + 1
            return
        }
    }

    // Decode forward until we reach a frame that is due now or later. If
    // several are already past (a slow paint, a stall), the intermediate
    // ones are DROPPED rather than shown late -- dropping is what keeps a
    // clock-driven player honest.
    app.looped = 0
    guard = 0
    while guard < 64 {
        if show_next(app) == 0 { return }
        if app.looped == 1 { return }
        if (app.pts as float) >= elapsed_ms { guard = 64 }
        else {
            app.late = app.late + 1
            guard = guard + 1
        }
    }
}

// Decode and present exactly one frame. Returns 1 on success, 0 if the clip
// could not be advanced. Looping resets the clock origin so the next cycle
// is timed from its own start rather than drifting further each pass.
show_next(app: *App) -> int {
    if app.dec == null { return 0 }
    fb = VW_of() * VH_of() * 4
    n, err = avcodec.next_frame_into(app.dec, bytes.data(app.buf), fb)
    if n == 0 {
        avcodec.close(app.dec)
        app.dec = open_clip(app.src)
        if app.dec == null { return 0 }
        n2, _e = avcodec.next_frame_into(app.dec, bytes.data(app.buf), fb)
        if n2 == 0 { return 0 }
        // Re-anchor at the loop point AND signal the caller to stop
        // decoding this tick. Without the stop, present_at keeps comparing
        // the new clip's early PTS against the OLD elapsed time -- every
        // frame reads as "late", and the catch-up loop burns through the
        // start of the clip (measured: late jumped 2 -> 67 at each wrap).
        app.t0 = 0.0 - 1.0
        app.looped = 1
        // Restart the audio too, or video wraps to 0 while the audio clock
        // keeps climbing to the end of the track -- every subsequent frame
        // reads as hopelessly late and the catch-up loop burns 64 frames a
        // tick (measured: late exploding to 1771). The two streams must
        // loop TOGETHER or the master clock stops describing the video.
        if app.aclock == 1 {
            _sk = audio.seek_ms(app.asrc, 0)
            _rp = audio.play(app.asrc)
        }
    }
    // set_length FIRST. bytes.new(fb) reserves CAPACITY but leaves length
    // at 0, and bytes.to_string clamps to the LOGICAL length -- so writing
    // through bytes.data() and calling to_string straight after mints an
    // EMPTY string, and the region blits uninitialised memory. That is what
    // made the video render as noise while every counter looked healthy.
    _ = bytes.set_length(app.buf, fb)
    px = bytes.to_string(app.buf, fb)
    region.region_push(app.rgn, px, fb)
    app.shown = app.shown + 1
    app.pts = avcodec.pts_ms(app.dec)
    return 1
}

publish(app: *App) {
    sh = app.shown
    pt = app.pts
    hd = app.held
    lt = app.late
    ck = "scene"
    ap = 0
    if app.aclock == 1 {
        ck = "audio"
        ap = audio.position_ms(app.asrc) as int
    }
    rr = frames_rerender_count(app.host)
    bl = frames_blit_count(app.host)
    _s = ui_set_s(app.st_status,
        "video: shown=${sh} pts_ms=${pt} held=${hd} late=${lt} clock=${ck} apos=${ap} | composite: rerender=${rr} blit=${bl}")
}

main() {
    src = os_getenv("VF_CLIP")
    if string.length(src) == 0 { src = "/tmp/vidtest/clip.mp4" }
    // A missing or unreadable clip is not a failure -- the app still opens
    // and draws its frames, just with an empty video rect. The spec asserts
    // only that pixels reach the screen, which the chrome alone satisfies.
    app = malloc(256) as *App
    app.shown = 0
    app.pts = 0
    app.t0 = 0.0 - 1.0
    app.held = 0
    app.late = 0
    app.looped = 0
    app.asrc = null
    app.aclock = 0
    app.src = src
    app.buf = bytes.new(VW_of() * VH_of() * 4)
    app.dec = open_clip(src)

    // Audio, if a sidecar WAV is present. std.audio v1 decodes WAV, and the
    // avcodec shim is video-only, so the demo takes audio from a .wav beside
    // the clip rather than demuxing it. That is a DEMO limitation, not an
    // architectural one: what matters here is which CLOCK drives
    // presentation, and audio.position_ms is that clock either way.
    wav = os_getenv("VF_WAV")
    if string.length(wav) == 0 { wav = "/tmp/vidtest/av.wav" }
    if audio.open() == true {
        wdata, wn, werr = fs.read_binary(wav)
        if string.length(werr) == 0 {
            asrc, aerr = audio.load_wav(wdata, wn)
            if string.length(aerr) == 0 {
                app.asrc = asrc
                app.aclock = 1
                _ap = audio.play(asrc)
                println("audio: ${audio.duration_ms(asrc)}ms, clock=audio")
            }
        }
    }
    if app.aclock == 0 { println("audio: none, clock=scene") }

    window("Aether-UI — MP4 in a frame", CW + 60, CH + 120) {
        vstack(0) {
            app.st_status = ui_state_s("video: starting")
            vg(view_box(0, 0, CW, CH), CW, CH) {
                root = rect(0, 0, CW * 1.0, CH * 1.0) { fill("#151a21") }
                app.scene = node_scene(root)
                // scene_canvas, NOT 0. Hardcoding zero registered every
                // pointer handler against a canvas that does not exist, so
                // the frames drew but never dragged -- and nothing errored,
                // because registering a handler on a bogus id is silent.
                app.canvas = scene_canvas(app.scene)
                _cw = width(canvas_widget(app.canvas), CW)
                _ch = height(canvas_widget(app.canvas), CH)
                scene_set_refreshing(app.scene, 1)
                host = frames(app.scene, 0.0, 0.0, CW * 1.0, CH * 1.0) {
                    // A static frame BESIDE the video, to prove the point:
                    // it is cached and never re-renders while the video
                    // plays at 15fps next to it (Stage 5).
                    _notes = frame("Notes (static)", 600.0, 80.0, 250.0, 180.0)
                        callback |rn: ptr, t: float, x: float, y: float, w: float, h: float| {
                            bg = rect(rn, x, y, w, h)
                            fill(bg, "#1f2937")
                            l1 = text_sized(rn, x + 12.0, y + 24.0, 13.0, "Static neighbour")
                            fill(l1, "#a7f3d0")
                            l2 = text_sized(rn, x + 12.0, y + 46.0, 11.0, "never re-renders")
                            fill(l2, "#6ee7b7")
                        }
                    // The video frame. Its content callback draws the chrome
                    // background only -- the PIXELS come from the raster
                    // region below, blitted over this rect in Z order.
                    app.vframe = frame("MP4", 60.0, 60.0, 480.0, 380.0)
                        callback |rn: ptr, t: float, x: float, y: float, w: float, h: float| {
                            frame_invalidate(app.vframe)
                            bg = rect(rn, x, y, w, h)
                            fill(bg, "#000000")
                        }
                }
                app.host = host
                frame_set_opacity(app.vframe, 1.0)

                // The raster region carrying the decoded frames, positioned
                // inside the video frame's content area.
                app.rgn = region.live_raster_new(72.0, 96.0, 456.0, 332.0, VW_of(), VH_of())
                region.region_set_animated(app.rgn, 1)
                vg.scene_add_live_region(app.scene, app.rgn)
                region.region_set_z(app.rgn, 50)
                // One decoded frame per tick. The old version computed a
                // frame INDEX from t*fps and pread it; a decoder has its own
                // cursor, so advancing it is the whole policy. Presenting at
                // the clip's true rate (rather than the tick rate) wants the
                // PTS model in TODO.md aim #4 -- pts_ms is already published.
                region.region_set_source(app.rgn) callback |rgn: ptr, t: float| {
                    present_at(app, t)
                }

                reg = canvas_region(root, 0.0, 0.0, CW * 1.0, CH * 1.0)
                    callback |rn: ptr, t: float| {
                        back = rect(rn, 0.0, 0.0, CW * 1.0, CH * 1.0)
                        fill(back, "#151a21")
                        frames_draw(app.host, rn, t)
                        // Keep the video region glued to the frame. The rect
                        // is set at creation, so without this a dragged frame
                        // leaves its picture behind -- the frame moves and the
                        // video does not. region_set_rect is cheap: the blit
                        // scales source to dest, so moving costs no re-decode.
                        fx, fy, fw2, fh2 = frame_bounds(app.vframe)
                        region.region_set_rect(app.rgn,
                            fx + 12.0, fy + 36.0, fw2 - 24.0, fh2 - 48.0)
                        publish(app)
                    }
                region_set_animated(reg, 0)

                // Pointer -> frames. Without these three the frames draw but
                // do not DRAG: ui.frames tracks the gesture, but nothing
                // feeds it pointer events. The imports were here and the
                // wiring was not, which looks identical until you try to
                // move a frame.
                canvas_on_click(app.canvas) callback |x: float, y: float| {
                    frames_on_click(app.host, x, y)
                    _r = scene_refresh(app.scene)
                }
                canvas_on_move(app.canvas) callback |x: float, y: float| {
                    frames_on_move(app.host, x, y)
                    _r = scene_refresh(app.scene)
                }
                canvas_on_release(app.canvas) callback |x: float, y: float| {
                    frames_on_release(app.host, x, y)
                    _r = scene_refresh(app.scene)
                }
            }
            st = text("video: starting")
            bind_text(st, app.st_status)
        }
        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
