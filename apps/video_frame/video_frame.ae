// video_frame.ae — an MP4 playing inside a ui.frames internal frame, with
// other Aether-UI widgets around it.
//
// The decode is ffmpeg's, not ours: aether-ui links no codec. ffmpeg is
// spawned to transcode the clip into a file of concatenated RGBA8888 frames,
// and the app preads frames out of that file as they appear. That is the
// "pipe" without needing a streaming fd read, which the stdlib does not have
// (std.ipc is write-only from the child, and there is no fd_read) --
// fs.pread_into gives positional reads into a REUSED buffer, so playback
// costs no per-frame allocation.
//
// Swap the ffmpeg spawn for an in-process decoder and everything below the
// region_push is unchanged.
//
//   VF_CLIP=/path/clip.mp4 ./build/video_frame
//
import ui
import ui (window, vstack, hstack, text, btn, enable_test_server,
           ui_state_s, ui_set_s, bind_text, canvas_widget, width, height)
import vg.live (vg, canvas_region, region_set_animated)
import vg (view_box, rect, text_sized, fill, stroke, vg_root, node_scene,
           scene_refresh, scene_set_refreshing, opacity)
import vg.region
import ui.frames (
    frames, frame, frame_invalidate, frame_set_opacity,
    frames_draw, frames_rerender_count, frames_blit_count,
    frames_on_click, frames_on_move, frames_on_release
)
import std.fs
import std.os
import std.os (os_getenv, run_capture, spawn_proc)
import std.string
import std.list
import std.bytes

extern malloc(size: int) -> ptr
extern free(p: ptr)
extern lrint(x: float) -> long

// Clip geometry. Env-overridable because these are the numbers you vary
// when asking "how fast can this actually go" -- see VF_W / VF_H / VF_FPS.
env_int(name: string, dflt: int) -> int {
    v = os_getenv(name)
    if string.length(v) == 0 { return dflt }
    n, ok = string.to_int(v)
    if ok == 0 { return dflt }
    return n
}

VW_of() -> int { return env_int("VF_W", 320) }
VH_of() -> int { return env_int("VF_H", 240) }
FPS_of() -> float { return (env_int("VF_FPS", 15) as float) }
const CW: int = 900
const CH: int = 600

struct App {
    host: ptr
    scene: ptr
    canvas: int
    vframe: ptr
    st_status: int
    fh: ptr          // open handle on the raw-RGBA file
    buf: ptr         // ONE reusable frame buffer, w*h*4
    rgn: ptr         // the raster region the frames are pushed into
    shown: int       // how many distinct frames have been presented
    last_idx: int
    avail: int       // frames currently decoded and readable
}

// Transcode the MP4 to concatenated RGBA8888 frames. Runs to completion
// before playback here for simplicity; ffmpeg writes progressively, so a
// longer clip could start playing while this is still running -- the pread
// loop below already tolerates a file that is still growing.
decode_to_raw(src: string, dst: string) -> int {
    VF_R = env_int("VF_FPS", 15)
    av = list.new()
    _ = list.add(av, "-y")
    _ = list.add(av, "-i")
    _ = list.add(av, src)
    _ = list.add(av, "-f")
    _ = list.add(av, "rawvideo")
    _ = list.add(av, "-pix_fmt")
    _ = list.add(av, "rgba")
    _ = list.add(av, "-s")
    _ = list.add(av, "${VW_of()}x${VH_of()}")
    _ = list.add(av, "-r")
    _ = list.add(av, "${VF_R}")
    _ = list.add(av, dst)
    _out, status, err = run_capture("ffmpeg", av, null)
    list.free(av)
    if string.length(err) > 0 { return 0 }
    if status != 0 { return 0 }
    return 1
}

// How many whole frames are readable right now.
frames_available(path: string) -> int {
    kind, size, _mt, err = fs.file_stat(path)
    if string.length(err) > 0 { return 0 }
    fb = VW_of() * VH_of() * 4
    return (size as int) / fb
}

// Present frame `idx`: pread it into the reusable buffer, push to the region.
show_frame(app: *App, idx: int) {
    if app.fh == null { return }
    fb = VW_of() * VH_of() * 4
    off = (idx * fb) as long
    // pread_into + bytes.to_string: the buffer is REUSED across frames
    // (no per-frame allocation of a 300KB..8MB buffer), and to_string is
    // the non-consuming reader -- bytes.finish would DESTROY the buffer,
    // so a reused one is freed on frame 1 and every later read scribbles
    // on freed memory. That froze playback at shown=1 with the scene's
    // repaint timer retired, which looks like a timer bug, not corruption.
    n, err = fs.pread_into(app.fh, app.buf, fb, off)
    if string.length(err) > 0 { return }
    if n < fb { return }
    px = bytes.to_string(app.buf, fb)
    region.region_push(app.rgn, px, fb)
    app.shown = app.shown + 1
    app.last_idx = idx
}

publish(app: *App) {
    sh = app.shown
    av = app.avail
    li = app.last_idx
    rr = frames_rerender_count(app.host)
    bl = frames_blit_count(app.host)
    _s = ui_set_s(app.st_status,
        "video: frame=${li} shown=${sh} avail=${av} | composite: rerender=${rr} blit=${bl}")
}

main() {
    src = os_getenv("VF_CLIP")
    if string.length(src) == 0 { src = "/tmp/vidtest/clip.mp4" }
    // No clip and no ffmpeg is not a failure -- the app still opens and
    // draws its frames, just with an empty video rect. The spec asserts
    // only that pixels reach the screen, which the chrome alone satisfies.
    raw = "/tmp/vidtest/clip.rgba"

    ok = decode_to_raw(src, raw)
    if ok == 0 { println("ffmpeg decode failed for ${src}") }

    app = malloc(256) as *App
    app.shown = 0
    app.last_idx = 0 - 1
    app.avail = frames_available(raw)
    app.buf = bytes.new(VW_of() * VH_of() * 4)
    fh, ferr = fs.open(raw, "rb")
    app.fh = fh
    if string.length(ferr) > 0 { println("open failed: ${ferr}") }
    println("clip: ${app.avail} frames ${VW_of()}x${VH_of()}")

    window("Aether-UI — MP4 in a frame", 960, 720) {
        vstack(0) {
            app.st_status = ui_state_s("video: starting")
            vg(view_box(0, 0, CW, CH), CW, CH) {
                root = rect(0, 0, CW * 1.0, CH * 1.0) { fill("#151a21") }
                app.scene = node_scene(root)
                app.canvas = 0
                _cw = width(canvas_widget(app.canvas), CW)
                _ch = height(canvas_widget(app.canvas), CH)
                scene_set_refreshing(app.scene, 1)
                host = frames(app.scene, 0.0, 0.0, CW * 1.0, CH * 1.0) {
                    // A static frame BESIDE the video, to prove the point:
                    // it is cached and never re-renders while the video
                    // plays at 15fps next to it (Stage 5).
                    _notes = frame("Notes (static)", 600.0, 80.0, 250.0, 180.0)
                        callback |rn: ptr, t: float, x: float, y: float, w: float, h: float| {
                            bg = rect(rn, x, y, w, h)
                            fill(bg, "#1f2937")
                            l1 = text_sized(rn, x + 12.0, y + 24.0, 13.0, "Static neighbour")
                            fill(l1, "#a7f3d0")
                            l2 = text_sized(rn, x + 12.0, y + 46.0, 11.0, "never re-renders")
                            fill(l2, "#6ee7b7")
                        }
                    // The video frame. Its content callback draws the chrome
                    // background only -- the PIXELS come from the raster
                    // region below, blitted over this rect in Z order.
                    app.vframe = frame("MP4", 60.0, 60.0, 480.0, 380.0)
                        callback |rn: ptr, t: float, x: float, y: float, w: float, h: float| {
                            frame_invalidate(app.vframe)
                            bg = rect(rn, x, y, w, h)
                            fill(bg, "#000000")
                        }
                }
                app.host = host
                frame_set_opacity(app.vframe, 1.0)

                // The raster region carrying the decoded frames, positioned
                // inside the video frame's content area.
                app.rgn = region.live_raster_new(72.0, 96.0, 456.0, 332.0, VW_of(), VH_of())
                region.region_set_animated(app.rgn, 1)
                vg.scene_add_live_region(app.scene, app.rgn)
                region.region_set_z(app.rgn, 50)
                region.region_set_source(app.rgn) callback |rgn: ptr, t: float| {
                    if app.avail <= 0 { app.avail = frames_available(raw) }
                    if app.avail > 0 {
                        idx = (lrint(t * FPS_of()) as int) % app.avail
                        if idx != app.last_idx { show_frame(app, idx) }
                    }
                }

                reg = canvas_region(root, 0.0, 0.0, CW * 1.0, CH * 1.0)
                    callback |rn: ptr, t: float| {
                        back = rect(rn, 0.0, 0.0, CW * 1.0, CH * 1.0)
                        fill(back, "#151a21")
                        frames_draw(app.host, rn, t)
                        publish(app)
                    }
                region_set_animated(reg, 0)
            }
            st = text("video: starting")
            bind_text(st, app.st_status)
        }
        if os_getenv("AETHER_UI_TEST_PORT") != null { enable_test_server(9222) }
    }
}
