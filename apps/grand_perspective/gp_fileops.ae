// gp_fileops.ae — GrandPerspective: Open / Reveal / Delete-to-trash.
//
// Part of the grand_perspective app (see grand_perspective.ae for the full
// provenance note; GPL-2.0 lineage applies).
//
// The entry ops act on: the SELECTION, else the tile under the pointer
// (gp_state.op_target — so the canvas right-click menu works on whatever was
// right-clicked). Delete is a two-click confirm on the toolbar button; the
// arm times out from the app tick (disarm_delete).

exports (
    open_path, do_open, do_reveal,
    DEL_CONFIRM_SECS, disarm_delete, do_delete, execute_trash
)

import std.list
import std.string
import std.os (run_capture, os_getenv)
import ui (backend_name)
import ui (set_button_label)
import gp_model
import gp_model (FileEntry, bump_ancestors, fmt_size)
import gp_state
import gp_state (AppState, op_target)
import gp_nav
import gp_nav (relayout, clear_selection)
import gp_scan
import gp_scan (rebuild_type_stats)

extern aether_ui_text_set_string(handle: int, text: string)

// xdg-open a path (file → default app, dir → file manager). Argv-based,
// no shell. Reports to the status line either way.
open_path(s: *AppState, p: string) {
    av = list.new()
    _ = list.add(av, p)
    _out, xstatus, xerr = run_capture("xdg-open", av, null)
    list.free(av)
    ok = 1
    if string.length(xerr) > 0 { ok = 0 }
    if xstatus != 0 { ok = 0 }
    if s.status != 0 {
        if ok == 1 { aether_ui_text_set_string(s.status, string.concat("Opened: ", p)) }
        else { aether_ui_text_set_string(s.status, string.concat("Open failed: ", p)) }
    }
}

do_open(s: *AppState) {
    t = op_target(s)
    if t == null { return }
    open_path(s, t.path)
}

// Reveal: open the CONTAINING directory in the file manager (a file's
// parent; a dir reveals its own parent so you see it in context).
do_reveal(s: *AppState) {
    t = op_target(s)
    if t == null { return }
    d = t.path
    if t.parent != null { d = t.parent.path }
    open_path(s, d)
}

// ─── Delete → trash, with a two-click confirm ────────────────────
//
// First press arms ("Confirm delete?" on the button + the path in the
// status line); a second press within the window executes `gio trash`.
// The arm times out (tick disarms) and any navigation clears selection,
// which also effectively disarms. Only an explicit SELECTION can be
// deleted — never the hover target.
const DEL_CONFIRM_SECS: float = 6.0

disarm_delete(s: *AppState) {
    s.del_armed_t = 0.0 - 1.0
    if s.del_btn != 0 { _ = set_button_label(s.del_btn, "Delete") }
}

do_delete(s: *AppState) {
    if s.selected == null {
        if s.status != 0 { aether_ui_text_set_string(s.status, "Select a tile or row first, then Delete") }
        return
    }
    if s.del_armed_t > 0.0 {
        if s.frame_t - s.del_armed_t < DEL_CONFIRM_SECS {
            execute_trash(s)
            return
        }
    }
    s.del_armed_t = s.frame_t
    if s.del_btn != 0 { _ = set_button_label(s.del_btn, "Confirm delete?") }
    if s.status != 0 {
        aether_ui_text_set_string(s.status,
            string.concat("Move to trash: ", string.concat(s.selected.path, "   — press Delete again to confirm")))
    }
}

// MSYS/Cygwin path -> native Windows path. "/c/Users/paul/x" becomes
// "C:\\Users\\paul\\x". PowerShell is a native Win32 program and cannot
// resolve MSYS paths: passing one through verbatim fails with
// `Could not find file '/c/Users/...'` and the Delete silently does
// nothing (measured on winbaz — the gp_fileops spec's only red). Paths
// that are already native are returned unchanged.
_win_native_path(p: string) -> string {
    n = string.length(p)
    if n < 3 { return p }
    if string.equals(string.substring(p, 0, 1), "/") == 0 { return p }
    // /<letter>/... — the MSYS drive form.
    if string.equals(string.substring(p, 2, 3), "/") == 0 { return p }
    drive = string.to_upper(string.substring(p, 1, 2))
    rest = string.substring(p, 3, n)
    out = string.concat(drive, ":\\")
    i = 0
    m = string.length(rest)
    while i < m {
        c = string.substring(rest, i, i + 1)
        if string.equals(c, "/") == 1 { out = string.concat(out, "\\") }
        else { out = string.concat(out, c) }
        i = i + 1
    }
    return out
}

execute_trash(s: *AppState) {
    e = s.selected
    // Platform trash: `gio trash` on Linux/macOS; on Windows the REAL
    // Recycle Bin via the VB FileSystem shim (SHFileOperation underneath) —
    // cmd `del` would be a permanent delete, which is not what Delete means.
    // Detect Windows from the BACKEND, not $OS. cmd.exe sets OS=Windows_NT
    // but MSYS/MinGW bash does NOT export it, so under the spec harness this
    // read empty and every Delete fell into the UNIX branch -- running
    // `uname`, which died with "error while loading shared libraries" in the
    // app's environment, and reported "Trash FAILED" while the file stayed
    // on disk. That is the gp_fileops red, and it was never in the
    // PowerShell call: that code was simply never reached.
    win = ""
    if string.equals(backend_name(), "win32") == 1 { win = "Windows_NT" }
    av = list.new()
    tstatus = 0
    terr = ""
    if string.equals(win, "Windows_NT") == 1 {
        // DOUBLE quotes, not single. The single-quoted form reached
        // PowerShell with the quotes STRIPPED -- it parsed
        // DeleteFile(C:/path/mid.bin,OnlyErrorDialogs,...) and died with
        // "Missing ')' in method call", so every Delete on Windows reported
        // "Trash FAILED" and left the file on disk. Measured on winbaz: the
        // identical command trashes the file with \" and fails with '.
        q = "\""
        cmdline = string.concat("Add-Type -AssemblyName Microsoft.VisualBasic; [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile(", q)
        cmdline = string.concat(cmdline, _win_native_path(e.path))
        cmdline = string.concat(cmdline, q)
        cmdline = string.concat(cmdline, string.concat(",", q))
        cmdline = string.concat(cmdline, "OnlyErrorDialogs")
        cmdline = string.concat(cmdline, string.concat(q, string.concat(",", q)))
        cmdline = string.concat(cmdline, "SendToRecycleBin")
        cmdline = string.concat(cmdline, string.concat(q, ")"))
        _ = list.add(av, "-NoProfile")
        _ = list.add(av, "-Command")
        _ = list.add(av, cmdline)
        _wout, wstatus, werr = run_capture("powershell", av, null)
        tstatus = wstatus
        terr = werr
    } else {
        // Which unix? `gio trash` is GLib's tool — Linux/BSD desktops have
        // it; macOS does NOT (the old comment claimed otherwise, and every
        // Delete on a real-session Mac reported "Trash FAILED"). On Darwin
        // the prompt-free native equivalent is a move into ~/.Trash —
        // Finder-visible, reversible by hand, no automation-permission
        // dialog (osascript's Finder route triggers one on modern macOS).
        _uout, _ustatus, _uerr = run_capture("uname", av, null)
        if string.contains(_uout, "Darwin") == 1 {
            tav = list.new()
            _ = list.add(tav, e.path)
            _ = list.add(tav, string.concat(os_getenv("HOME"), "/.Trash/"))
            _mout, mstatus, merr = run_capture("mv", tav, null)
            list.free(tav)
            tstatus = mstatus
            terr = merr
        } else {
            gav = list.new()
            _ = list.add(gav, "trash")
            _ = list.add(gav, e.path)
            _gout, gstatus, gerr = run_capture("gio", gav, null)
            list.free(gav)
            tstatus = gstatus
            terr = gerr
        }
    }
    list.free(av)
    disarm_delete(s)
    ok = 1
    if string.length(terr) > 0 { ok = 0 }
    if tstatus != 0 { ok = 0 }
    if ok == 0 {
        if s.status != 0 { aether_ui_text_set_string(s.status, string.concat("Trash FAILED: ", e.path)) }
        return
    }
    // Retract the subtree from the model: bytes + file counts up the
    // ancestor chain, then unlink the node from its parent.
    fdel = e.file_count
    if e.is_dir == 0 { fdel = 1 }
    long ebytes = e.total_size
    bump_ancestors(e, 0 - ebytes, 0 - fdel)
    if e.parent != null {
        pc = e.parent.children
        n = list.size(pc)
        i = 0
        while i < n {
            it, _ = list.get(pc, i)
            if it as *FileEntry == e { list.remove(pc, i); i = n }
            i = i + 1
        }
    }
    s.freed = s.freed + ebytes
    s.total = s.root.total_size
    clear_selection(s)
    rebuild_type_stats(s)
    relayout(s)
    if s.status != 0 {
        fmsg = fmt_size(ebytes)
        aether_ui_text_set_string(s.status,
            string.concat("Moved to trash: ", string.concat(e.path, string.concat("   (freed ", string.concat(fmsg, ")")))))
    }
}
