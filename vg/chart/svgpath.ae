// svg/types.ts (the command parameters). Only the DOM-facing Svg class is
// not ported: vg/chart builds a declarative node tree instead.

exports (
    CtSvgPath, CtPathEl,
    path_new, path_new_with, path_pos, path_set_pos, path_remove,
    path_move, path_line, path_curve, path_arc,
    path_move_d, path_line_d, path_curve_d,
    path_parse, path_error, path_stringify, path_scale, path_translate,
    path_transform, path_clone, path_split_by_command, path_join,
    path_len, path_el, path_command, el_param, el_set_param, el_data,
    el_params_lit, param_names
)

import std.string
import std.list
import vg.chart.value as jv
import vg.chart.core

struct CtPathEl {
    command: string     // M L C A (lower case when relative), or H V S Q T Z from parse
    x: float
    y: float
    x1: float
    y1: float
    x2: float
    y2: float
    rx: float
    ry: float
    xar: float
    laf: float
    sf: float
    data: *core.CtSegData // the chart point the command draws to, or null
}

struct CtSvgPath {
    elements: ptr       // std.list of *CtPathEl
    pos: int
    close: int
    accuracy: int       // decimals stringify rounds to; -1 = no rounding (false)
    error: string       // a parse error ("" when none): JS throws there
}

path_new(close: int) -> *CtSvgPath {
    return path_new_with(close, 3)
}

path_new_with(close: int, accuracy: int) -> *CtSvgPath {
    p = heap.new(CtSvgPath)
    p.elements = list.new()
    p.pos = 0
    p.close = close
    p.accuracy = accuracy
    p.error = ""
    return p
}

// The parameters of each command, in the order `d` lists them.
param_names(cmd: string) -> string {
    c = string.to_lower(cmd)
    if string.equals(c, "m") == 1 || string.equals(c, "l") == 1 || string.equals(c, "t") == 1 { return "x y" }
    if string.equals(c, "h") == 1 { return "x" }
    if string.equals(c, "v") == 1 { return "y" }
    if string.equals(c, "c") == 1 { return "x1 y1 x2 y2 x y" }
    if string.equals(c, "s") == 1 { return "x2 y2 x y" }
    if string.equals(c, "q") == 1 { return "x1 y1 x y" }
    if string.equals(c, "a") == 1 { return "rx ry xAr lAf sf x y" }
    return ""
}

param_count(cmd: string) -> int {
    names = param_names(cmd)
    if string.length(names) == 0 { return 0 }
    arr = string.split(names, " ")
    n = string.array_size(arr)
    string.array_free(arr)
    return n
}

param_at(cmd: string, i: int) -> string {
    arr = string.split(param_names(cmd), " ")
    s = string.copy(string.array_get(arr, i))
    string.array_free(arr)
    return s
}

el_param(e: *CtPathEl, name: string) -> float {
    match (name) {
        "x" -> { return e.x }
        "y" -> { return e.y }
        "x1" -> { return e.x1 }
        "y1" -> { return e.y1 }
        "x2" -> { return e.x2 }
        "y2" -> { return e.y2 }
        "rx" -> { return e.rx }
        "ry" -> { return e.ry }
        "xAr" -> { return e.xar }
        "lAf" -> { return e.laf }
        "sf" -> { return e.sf }
        _ -> { return 0.0 }
    }
}

el_set_param(e: *CtPathEl, name: string, v: float) {
    match (name) {
        "x" -> { e.x = v }
        "y" -> { e.y = v }
        "x1" -> { e.x1 = v }
        "y1" -> { e.y1 = v }
        "x2" -> { e.x2 = v }
        "y2" -> { e.y2 = v }
        "rx" -> { e.rx = v }
        "ry" -> { e.ry = v }
        "xAr" -> { e.xar = v }
        "lAf" -> { e.laf = v }
        "sf" -> { e.sf = v }
        _ -> { }
    }
}

el_data(e: *CtPathEl) -> *core.CtSegData { return e.data }

new_el(cmd: string) -> *CtPathEl {
    e = heap.new(CtPathEl)
    e.command = cmd
    e.x = 0.0
    e.y = 0.0
    e.x1 = 0.0
    e.y1 = 0.0
    e.x2 = 0.0
    e.y2 = 0.0
    e.rx = 0.0
    e.ry = 0.0
    e.xar = 0.0
    e.laf = 0.0
    e.sf = 0.0
    e.data = null
    return e
}

copy_el(s: *CtPathEl) -> *CtPathEl {
    e = new_el(s.command)
    e.x = s.x
    e.y = s.y
    e.x1 = s.x1
    e.y1 = s.y1
    e.x2 = s.x2
    e.y2 = s.y2
    e.rx = s.rx
    e.ry = s.ry
    e.xar = s.xar
    e.laf = s.laf
    e.sf = s.sf
    e.data = s.data
    return e
}

path_len(p: *CtSvgPath) -> int { return list.size(p.elements) }

path_el(p: *CtSvgPath, i: int) -> *CtPathEl {
    item, _e = list.get(p.elements, i)
    return item as *CtPathEl
}

path_command(p: *CtSvgPath, i: int) -> string { return path_el(p, i).command }

path_pos(p: *CtSvgPath) -> int { return p.pos }

// position(pos): the cursor, clamped to 0 .. the number of commands.
path_set_pos(p: *CtSvgPath, pos: int) -> *CtSvgPath {
    n = path_len(p)
    q = pos
    if q > n { q = n }
    if q < 0 { q = 0 }
    p.pos = q
    return p
}

// remove(count): drop commands from the cursor on.
path_remove(p: *CtSvgPath, count: int) -> *CtSvgPath {
    i = 0
    while i < count && p.pos < path_len(p) {
        list.remove(p.elements, p.pos)
        i = i + 1
    }
    return p
}

// Insert at the cursor (list has no insert: rebuild the tail).
insert_el(p: *CtSvgPath, e: *CtPathEl) {
    n = path_len(p)
    if p.pos >= n {
        _a = list.add(p.elements, e)
    } else {
        tail = list.new()
        while path_len(p) > p.pos {
            it, _e = list.get(p.elements, p.pos)
            _b = list.add(tail, it)
            list.remove(p.elements, p.pos)
        }
        _c = list.add(p.elements, e)
        k = 0
        while k < list.size(tail) {
            it2, _e2 = list.get(tail, k)
            _d = list.add(p.elements, it2)
            k = k + 1
        }
        list.free(tail)
    }
    p.pos = p.pos + 1
}

cmd_case(c: string, relative: int) -> string {
    if relative == 1 { return string.to_lower(c) }
    return c
}

path_move(p: *CtSvgPath, x: float, y: float, relative: int) -> *CtSvgPath {
    return path_move_d(p, x, y, relative, null)
}

path_move_d(p: *CtSvgPath, x: float, y: float, relative: int, data: *core.CtSegData) -> *CtSvgPath {
    e = new_el(cmd_case("M", relative))
    e.x = x
    e.y = y
    e.data = data
    insert_el(p, e)
    return p
}

path_line(p: *CtSvgPath, x: float, y: float, relative: int) -> *CtSvgPath {
    return path_line_d(p, x, y, relative, null)
}

path_line_d(p: *CtSvgPath, x: float, y: float, relative: int, data: *core.CtSegData) -> *CtSvgPath {
    e = new_el(cmd_case("L", relative))
    e.x = x
    e.y = y
    e.data = data
    insert_el(p, e)
    return p
}

path_curve(p: *CtSvgPath, x1: float, y1: float, x2: float, y2: float, x: float, y: float, relative: int) -> *CtSvgPath {
    return path_curve_d(p, x1, y1, x2, y2, x, y, relative, null)
}

path_curve_d(p: *CtSvgPath, x1: float, y1: float, x2: float, y2: float, x: float, y: float, relative: int, data: *core.CtSegData) -> *CtSvgPath {
    e = new_el(cmd_case("C", relative))
    e.x1 = x1
    e.y1 = y1
    e.x2 = x2
    e.y2 = y2
    e.x = x
    e.y = y
    e.data = data
    insert_el(p, e)
    return p
}

path_arc(p: *CtSvgPath, rx: float, ry: float, xar: float, laf: float, sf: float, x: float, y: float, relative: int) -> *CtSvgPath {
    e = new_el(cmd_case("A", relative))
    e.rx = rx
    e.ry = ry
    e.xar = xar
    e.laf = laf
    e.sf = sf
    e.x = x
    e.y = y
    insert_el(p, e)
    return p
}

// ─── parse ───────────────────────────────────────────────────────

struct CtScan {
    s: string
    i: int
    n: int
    err: string
}

is_cmd_char(c: int) -> int {
    // MmZzLlHhVvCcSsQqTtAa
    if c == 77 || c == 109 || c == 90 || c == 122 || c == 76 || c == 108 { return 1 }
    if c == 72 || c == 104 || c == 86 || c == 118 || c == 67 || c == 99 { return 1 }
    if c == 83 || c == 115 || c == 81 || c == 113 || c == 84 || c == 116 { return 1 }
    if c == 65 || c == 97 { return 1 }
    return 0
}

skip_sep(sc: *CtScan) {
    while sc.i < sc.n {
        c = string.char_at(sc.s, sc.i)
        if c == 44 || jv.is_space(c) == 1 { sc.i = sc.i + 1 } else { return }
    }
}

is_digit(c: int) -> int {
    if c >= 48 && c <= 57 { return 1 }
    return 0
}

// The length of a number at j: [-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?, 0 if none.
number_len(s: string, j0: int, n: int) -> int {
    j = j0
    if j < n {
        c = string.char_at(s, j)
        if c == 43 || c == 45 { j = j + 1 }
    }
    digits = 0
    while j < n && is_digit(string.char_at(s, j)) == 1 { j = j + 1; digits = digits + 1 }
    if digits > 0 {
        if j < n && string.char_at(s, j) == 46 {
            j = j + 1
            while j < n && is_digit(string.char_at(s, j)) == 1 { j = j + 1 }
        }
    } else {
        if j < n && string.char_at(s, j) == 46 {
            k = j + 1
            fd = 0
            while k < n && is_digit(string.char_at(s, k)) == 1 { k = k + 1; fd = fd + 1 }
            if fd == 0 { return 0 }
            j = k
        } else {
            return 0
        }
    }
    if j < n {
        e = string.char_at(s, j)
        if e == 101 || e == 69 {
            k = j + 1
            if k < n {
                sg = string.char_at(s, k)
                if sg == 43 || sg == 45 { k = k + 1 }
            }
            ed = 0
            while k < n && is_digit(string.char_at(s, k)) == 1 { k = k + 1; ed = ed + 1 }
            if ed > 0 { j = k }
        }
    }
    return j - j0
}

scan_fail(sc: *CtScan) {
    if string.length(sc.err) > 0 { return }
    end = sc.i + 20
    if end > sc.n { end = sc.n }
    sc.err = "Invalid SVG path at position ${sc.i}: \"${string.substring(sc.s, sc.i, end)}\""
}

// The next command letter, or "" (no letter there; the cursor stays).
read_cmd(sc: *CtScan) -> string {
    save = sc.i
    skip_sep(sc)
    if sc.i < sc.n && is_cmd_char(string.char_at(sc.s, sc.i)) == 1 {
        c = string.substring(sc.s, sc.i, sc.i + 1)
        sc.i = sc.i + 1
        return c
    }
    sc.i = save
    return ""
}

read_param(sc: *CtScan, flag: int) -> float {
    skip_sep(sc)
    if flag == 1 {
        if sc.i < sc.n {
            c = string.char_at(sc.s, sc.i)
            if c == 48 || c == 49 {
                sc.i = sc.i + 1
                return (c - 48) / 1.0
            }
        }
        scan_fail(sc)
        return 0.0
    }
    l = number_len(sc.s, sc.i, sc.n)
    if l == 0 {
        scan_fail(sc)
        return 0.0
    }
    v, _e = string.to_double(string.substring(sc.s, sc.i, sc.i + l))
    sc.i = sc.i + l
    return v
}

// parse(d): insert the commands of any SVG path at the cursor. A closing Z
// at the end is dropped (the path's own `close` decides that); bad syntax
// leaves the path as it was and sets path_error (JS throws).
path_parse(p: *CtSvgPath, d: string) -> *CtSvgPath {
    sc = heap.new(CtScan)
    sc.s = d
    sc.i = 0
    sc.n = string.length(d)
    sc.err = ""
    els = list.new()
    cmd = read_cmd(sc)
    if string.length(cmd) == 0 {
        if string.length(string.trim(d)) > 0 { scan_fail(sc) }
    }
    while string.length(cmd) > 0 && string.length(sc.err) == 0 {
        e = new_el(cmd)
        k = param_count(cmd)
        j = 0
        while j < k && string.length(sc.err) == 0 {
            name = param_at(cmd, j)
            fl = 0
            if string.equals(name, "lAf") == 1 || string.equals(name, "sf") == 1 { fl = 1 }
            el_set_param(e, name, read_param(sc, fl))
            j = j + 1
        }
        if string.length(sc.err) == 0 { _a = list.add(els, e) }
        if string.length(sc.err) == 0 {
            nxt = read_cmd(sc)
            if string.length(nxt) > 0 { cmd = nxt } else {
                skip_sep(sc)
                if sc.i >= sc.n { cmd = "" } else {
                    if k == 0 { scan_fail(sc) } else {
                        if number_len(sc.s, sc.i, sc.n) == 0 { scan_fail(sc) } else {
                            if string.equals(cmd, "M") == 1 { cmd = "L" } else {
                                if string.equals(cmd, "m") == 1 { cmd = "l" }
                            }
                        }
                    }
                }
            }
        }
    }
    if string.length(sc.err) > 0 {
        p.error = sc.err
        return p
    }
    ne = list.size(els)
    if ne > 0 {
        last, _e = list.get(els, ne - 1)
        lc = last as *CtPathEl
        if string.equals(string.to_upper(lc.command), "Z") == 1 { list.remove(els, ne - 1) }
    }
    i = 0
    while i < list.size(els) {
        it, _e2 = list.get(els, i)
        insert_el(p, it as *CtPathEl)
        i = i + 1
    }
    return p
}

path_error(p: *CtSvgPath) -> string { return p.error }

// ─── output and transforms ───────────────────────────────────────

path_stringify(p: *CtSvgPath) -> string {
    out = ""
    n = path_len(p)
    i = 0
    while i < n {
        e = path_el(p, i)
        out = string.concat(out, e.command)
        k = param_count(e.command)
        j = 0
        while j < k {
            v = el_param(e, param_at(e.command, j))
            if p.accuracy >= 0 { v = core.round_to(v, p.accuracy) }
            if j > 0 { out = string.concat(out, ",") }
            out = string.concat(out, jv.js_number(v))
            j = j + 1
        }
        i = i + 1
    }
    if p.close == 1 { out = string.concat(out, "Z") }
    return out
}

// The parameters of command i as a JS literal ({command: 'M', x: 1, y: 2}),
// for comparing paths element by element.
el_params_lit(e: *CtPathEl) -> *jv.JsValue {
    o = jv.obj()
    jv.put(o, "command", jv.str(e.command))
    k = param_count(e.command)
    j = 0
    while j < k {
        name = param_at(e.command, j)
        jv.put(o, name, jv.num(el_param(e, name)))
        j = j + 1
    }
    return o
}

scale_axis(name: string) -> int {
    // 1 = x, 2 = y, 0 = not a coordinate (an arc's rotation and flags)
    if string.equals(name, "x") == 1 || string.equals(name, "x1") == 1 || string.equals(name, "x2") == 1 || string.equals(name, "rx") == 1 { return 1 }
    if string.equals(name, "y") == 1 || string.equals(name, "y1") == 1 || string.equals(name, "y2") == 1 || string.equals(name, "ry") == 1 { return 2 }
    return 0
}

path_scale(p: *CtSvgPath, sx: float, sy: float) -> *CtSvgPath {
    n = path_len(p)
    i = 0
    while i < n {
        e = path_el(p, i)
        k = param_count(e.command)
        j = 0
        while j < k {
            name = param_at(e.command, j)
            ax = scale_axis(name)
            if ax == 1 { el_set_param(e, name, el_param(e, name) * sx) }
            if ax == 2 { el_set_param(e, name, el_param(e, name) * sy) }
            j = j + 1
        }
        i = i + 1
    }
    return p
}

path_translate(p: *CtSvgPath, tx: float, ty: float) -> *CtSvgPath {
    n = path_len(p)
    i = 0
    while i < n {
        e = path_el(p, i)
        k = param_count(e.command)
        j = 0
        while j < k {
            name = param_at(e.command, j)
            ax = scale_axis(name)
            // Radii are not translated.
            if string.equals(name, "rx") == 1 || string.equals(name, "ry") == 1 { ax = 0 }
            if ax == 1 { el_set_param(e, name, el_param(e, name) + tx) }
            if ax == 2 { el_set_param(e, name, el_param(e, name) + ty) }
            j = j + 1
        }
        i = i + 1
    }
    return p
}

// transform(fn): fn(element, paramName, elementIndex, paramIndex) -> float
// for every parameter; a result other than NaN replaces the value (JS: a
// result other than undefined).
path_transform(p: *CtSvgPath, f: fn) -> *CtSvgPath {
    n = path_len(p)
    i = 0
    while i < n {
        e = path_el(p, i)
        k = param_count(e.command)
        j = 0
        while j < k {
            name = param_at(e.command, j)
            float r = call(f, e, name, i, j)
            if jv.is_nan(r) == 0 { el_set_param(e, name, r) }
            j = j + 1
        }
        i = i + 1
    }
    return p
}

// clone(close): a deep copy; `close` 1 closes the copy, else it keeps the
// original's close.
path_clone(p: *CtSvgPath, close: int) -> *CtSvgPath {
    c = close
    if p.close == 1 { c = 1 }
    q = path_new_with(c, p.accuracy)
    n = path_len(p)
    i = 0
    while i < n {
        _a = list.add(q.elements, copy_el(path_el(p, i)))
        i = i + 1
    }
    q.pos = p.pos
    return q
}

// splitByCommand(letter): the pieces starting at each such command (either
// case), with copies of the commands and the path's options; only the last
// piece is closed if the path is.
path_split_by_command(p: *CtSvgPath, command: string) -> ptr {
    letter = string.to_upper(command)
    pieces = list.new()
    cur = list.new()
    _f = list.add(pieces, cur)
    n = path_len(p)
    i = 0
    while i < n {
        e = path_el(p, i)
        if string.equals(string.to_upper(e.command), letter) == 1 && list.size(cur) != 0 {
            cur = list.new()
            _g = list.add(pieces, cur)
        }
        _h = list.add(cur, copy_el(e))
        i = i + 1
    }
    out = list.new()
    np = list.size(pieces)
    j = 0
    while j < np {
        lp, _e = list.get(pieces, j)
        close = 0
        if p.close == 1 && j == np - 1 { close = 1 }
        piece = path_new_with(close, p.accuracy)
        list.free(piece.elements)
        piece.elements = lp
        piece.pos = list.size(lp)
        _k = list.add(out, piece)
        j = j + 1
    }
    return out
}

// SvgPath.join(paths, close): one path with copies of all the commands, its
// cursor at the end.
path_join(paths: ptr, close: int) -> *CtSvgPath {
    q = path_new(close)
    n = list.size(paths)
    i = 0
    while i < n {
        pp, _e = list.get(paths, i)
        p = pp as *CtSvgPath
        m = path_len(p)
        j = 0
        while j < m {
            _a = list.add(q.elements, copy_el(path_el(p, j)))
            j = j + 1
        }
        i = i + 1
    }
    q.pos = path_len(q)
    return q
}
