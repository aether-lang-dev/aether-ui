// (quantity, alphaNumerate), core/constants.ts (precision, escapingMap),
// core/data/data.ts (getMetaData, isDataHoleValue, isArrayOfSeries,
// isMultiValue, getMultiValue), core/data/normalize.ts (normalizeData),
