// vg/test/test_font.ae — unit test for vg/font.ae (pure-Aether TrueType
// outline extraction), against the vendored fonts/DejaVuSans-Bold.ttf.
//
// Headless, pure Aether. Run from the repo root (the font path is relative):
//   aetherc --lib . vg/test/test_font.ae /tmp/t.c && gcc /tmp/t.c \
//     vg/test/text_metrics_stub.c $(ae cflags) -o /tmp/t && /tmp/t

import vg.font
import std.math
import std.string
import std.fs

extern exit(code: int)

assert_eq(label: string, got: int, want: int) {
    if got == want {
        println("  PASS: ${label} (${got})")
    } else {
        println("  FAIL: ${label}: got ${got} want ${want}")
        exit(1)
    }
}
assert_gt(label: string, got: int, floor: int) {
    if got > floor {
        println("  PASS: ${label} (${got})")
    } else {
        println("  FAIL: ${label}: got ${got}, want > ${floor}")
        exit(1)
    }
}
assert_near(label: string, got: float, want: float, eps: float) {
    if math.abs_float(got - want) < eps {
        println("  PASS: ${label} (${got})")
    } else {
        println("  FAIL: ${label}: got ${got} want ${want}")
        exit(1)
    }
}

main() {
    println("test_font: load")
    f = font.font_load("fonts/DejaVuSans-Bold.ttf")
    assert_eq("font loads", font.font_ok(f), 1)
    assert_eq("units per em", font.font_upem(f), 2048)
    assert_gt("has glyphs", font.font_nglyphs(f), 1000)

    println("test_font: cmap")
    gid_a = font.font_glyph_index(f, 65)      // 'A'
    gid_e = font.font_glyph_index(f, 101)     // 'e'
    assert_gt("glyph id for A", gid_a, 0)
    assert_gt("glyph id for e", gid_e, 0)
    if gid_a == gid_e {
        println("  FAIL: A and e map to the same glyph")
        exit(1)
    }
    println("  PASS: A and e distinct")
    assert_eq("unmapped codepoint -> 0 (.notdef)", font.font_glyph_index(f, 64976), 0)

    println("test_font: metrics")
    assert_gt("advance of A", font.font_glyph_advance(f, gid_a), 500)

    println("test_font: simple glyph outlines")
    oa = font.font_glyph_outlines(f, gid_a, 4)
    assert_eq("outline ok", font.outl_ok(oa), 1)
    assert_eq("A has 2 contours (outer + counter)", font.outl_nctrs(oa), 2)
    assert_gt("A flattened points", font.outl_npts(oa), 10)
    font.outl_free(oa)

    // Space: an advance but no outline.
    gid_sp = font.font_glyph_index(f, 32)
    osp = font.font_glyph_outlines(f, gid_sp, 4)
    assert_eq("space has no contours", font.outl_nctrs(osp), 0)
    assert_gt("space still advances", font.font_glyph_advance(f, gid_sp), 0)
    font.outl_free(osp)

    println("test_font: composite glyph (é = e + acute)")
    gid_ea = font.font_glyph_index(f, 233)    // U+00E9
    assert_gt("glyph id for e-acute", gid_ea, 0)
    oea = font.font_glyph_outlines(f, gid_ea, 4)
    assert_eq("e-acute contours (2 of e + 1 accent)", font.outl_nctrs(oea), 3)
    font.outl_free(oea)

    println("test_font: text run, normalized")
    ow = font.font_text_outlines_norm(f, "AeVG", 4, 1.76)
    assert_eq("word ok", font.outl_ok(ow), 1)
    // A: outer+counter, e: bowl+counter, V: 1, G: 1.
    assert_eq("AeVG contour count", font.outl_nctrs(ow), 6)
    assert_gt("AeVG flattened points", font.outl_npts(ow), 100)
    // Normalized: bbox exactly target_w wide, centred on the origin.
    n = font.outl_npts(ow)
    minx = font.outl_px(ow, 0)
    maxx = minx
    miny = font.outl_py(ow, 0)
    maxy = miny
    i = 1
    while i < n {
        x = font.outl_px(ow, i)
        y = font.outl_py(ow, i)
        if x < minx { minx = x }
        if x > maxx { maxx = x }
        if y < miny { miny = y }
        if y > maxy { maxy = y }
        i = i + 1
    }
    assert_near("normalized width", maxx - minx, 1.76, 0.001)
    assert_near("centred x", minx + maxx, 0.0, 0.001)
    assert_near("centred y", miny + maxy, 0.0, 0.001)
    // Contour ends are strictly increasing and the last covers all points.
    ok_ends = 1
    prev = 0 - 1
    ci = 0
    while ci < font.outl_nctrs(ow) {
        e = font.outl_ctr_end(ow, ci)
        if e <= prev { ok_ends = 0 }
        prev = e
        ci = ci + 1
    }
    assert_eq("contour ends strictly increasing", ok_ends, 1)
    assert_eq("last contour end is last point", prev, n - 1)
    font.outl_free(ow)

    println("test_font: name table")
    // nameID 4, English record. A font carrying the same name in several
    // languages must NOT yield the non-English one (which, after non-Latin
    // codepoints are skipped, would come back as a truncated fragment).
    nm = font.font_name(f)
    if string.equals(nm, "DejaVu Sans Bold") == 1 {
        println("  PASS: font_name reads the English full name ('${nm}')")
    } else {
        println("  FAIL: font_name: got '${nm}' want 'DejaVu Sans Bold'")
        exit(1)
    }

    println("test_font: cmap format 12 (beyond the BMP)")
    // DejaVu Sans Bold carries U+1F600 (grinning face) only in its format-12
    // subtable; a format-4-only reader maps it to .notdef.
    assert_gt("U+1F600 maps via cmap 12", font.font_glyph_index(f, 128512), 0)

    println("test_font: symbol-encoded cmap (3,0): chars at 0xF000 + code")
    // Wingdings (macOS Supplemental) has a Microsoft Symbol (3,0) cmap with
    // its characters at U+F020-U+F0FF, plus a Mac cmap; skipped where absent.
    sym = font.font_load("/System/Library/Fonts/Supplemental/Wingdings.ttf")
    if font.font_ok(sym) == 1 {
        assert_gt("Wingdings: 'A' (0x41) maps", font.font_glyph_index(sym, 65), 0)
        assert_gt("Wingdings: 'a' maps", font.font_glyph_index(sym, 97), 0)
        assert_gt("Wingdings: '1' maps", font.font_glyph_index(sym, 49), 0)
        assert_eq("Wingdings: U+F041 directly agrees", font.font_glyph_index(sym, 61505), font.font_glyph_index(sym, 65))
        assert_eq("Wingdings: covers the Latin sample", font.font_covered(sym, "Handgloves"), 10)
        // Negative control: outside both the code range and the 0xF000 block.
        assert_eq("Wingdings: U+4E00 still missing", font.font_glyph_index(sym, 19968), 0)
    } else {
        println("  SKIP: Wingdings.ttf not present")
    }
    // Symbol.ttf is NOT a (3,0) font here: Unicode cmap with Greek, no Latin.
    // Its preview needs the font's own sample, not a Latin one.
    gs = font.font_load("/System/Library/Fonts/Symbol.ttf")
    if font.font_ok(gs) == 1 {
        assert_eq("Symbol: no Latin letters mapped", font.font_covered(gs, "Handgloves"), 0)
        own = font.font_own_sample(gs, 8)
        assert_gt("Symbol: own sample non-empty", string.length(own), 0)
        assert_gt("Symbol: own sample is mapped", font.font_covered(gs, own), 0)
    }
    // Negative control: a Unicode font's missing codes stay missing.
    assert_eq("DejaVu: U+4E00 stays missing", font.font_glyph_index(f, 19968), 0)
    assert_eq("covered counts mapped letters", font.font_covered(f, "Handgloves"), 10)

    println("test_font: missing file")
    fbad = font.font_load("fonts/no-such-font.ttf")
    assert_eq("missing font -> not ok", font.font_ok(fbad), 0)
    assert_gt("missing font says why", string.length(font.font_last_error()), 0)
    // A not-ok handle answers every accessor with zeros instead of crashing.
    assert_eq("not-ok upem", font.font_upem(fbad), 0)
    assert_eq("not-ok glyph index", font.font_glyph_index(fbad, 65), 0)
    onone = font.font_text_outlines(fbad, "A", 4)
    assert_eq("not-ok outlines not ok", font.outl_ok(onone), 0)
    font.outl_free(onone)

    println("test_font: truncated / corrupt font fails cleanly")
    data, len, rerr = fs.read_binary("fonts/DejaVuSans-Bold.ttf")
    assert_eq("read the font bytes", string.length(rerr), 0)
    tdir, terr = fs.make_temp_dir("", "aeui_font_")
    assert_eq("temp dir", string.length(terr), 0)
    tpath = "${tdir}/trunc.ttf"
    // Negative control: the full copy written through the same path loads.
    assert_eq("full copy written", string.length(fs.write_binary(tpath, string.bytes(data)[0..len])), 0)
    ffull = font.font_load(tpath)
    assert_eq("full copy loads (control)", font.font_ok(ffull), 1)
    assert_eq("full copy glyph count", font.font_nglyphs(ffull), font.font_nglyphs(f))
    cuts = 12
    nfail = 0
    ncut = 0
    while cuts < len {
        if string.length(fs.write_binary(tpath, string.bytes(data)[0..cuts])) > 0 {
            println("  FAIL: could not write the cut copy")
            exit(1)
        }
        ft = font.font_load(tpath)
        ncut = ncut + 1
        if font.font_ok(ft) == 0 {
            nfail = nfail + 1
            if string.length(font.font_last_error()) == 0 {
                println("  FAIL: cut at ${cuts} failed without an error")
                exit(1)
            }
        } else {
            // Loaded: every glyph must still read without running past the end.
            g = 0
            while g < font.font_nglyphs(ft) {
                ot = font.font_glyph_outlines(ft, g, 2)
                font.outl_free(ot)
                font.font_glyph_advance(ft, g)
                g = g + 97
            }
        }
        // Dense near the start (table directory), then coarser.
        if cuts < 400 { cuts = cuts + 37 } else { cuts = cuts + 20011 }
    }
    println("  cuts tried: ${ncut}, rejected at load: ${nfail}")
    assert_gt("truncations are rejected at load", nfail, 5)
    // Garbage that only looks like a font: a valid-looking header, no tables.
    fs.write_binary(tpath, string.bytes("\x00\x01\x00\x00\x00\x20\x00\x00\x00\x00\x00\x00zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")[0..44])
    fg = font.font_load(tpath)
    assert_eq("garbage -> not ok", font.font_ok(fg), 0)
    assert_gt("garbage says why", string.length(font.font_last_error()), 0)
    fs.remove_tree(tdir)

    println("ALL PASS")
}
