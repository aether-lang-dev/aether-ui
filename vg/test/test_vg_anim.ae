// aevg/test_vg_anim.ae — continuous animation via vg.animate + scene_tick.
//
// Registers an opacity fade on a circle, drives the scene clock with
// scene_tick at t=0 / mid / end, and asserts the element's opacity follows the
// raw t the tick closure receives, the animation reports animating until it
// completes, then drops out. This is the headless half of the timer-driven
// loop (vg_live runs scene_tick from a 16ms timer on a live window).

import vg
import vg.backend.record
import vg.grammar.context
import vg.grammar.element
import vg.geom.transform
import std.string

same_str(a: string, b: string) -> int {
    if a == b { return 1 }
    return 0
}

extern exit(code: int)
extern malloc(size: int) -> ptr

assert_near(label: string, got: float, want: float) {
    d = got - want
    if d < 0.0 { d = 0.0 - d }
    if d < 0.01 { println("  PASS: ${label} (${got})") }
    else { println("  FAIL: ${label}: got ${got} want ${want}"); exit(1) }
}

assert_eq_int(label: string, got: int, want: int) {
    if got == want { println("  PASS: ${label} (${got})") }
    else { println("  FAIL: ${label}: got ${got} want ${want}"); exit(1) }
}

mk_ctx() -> ptr {
    id = transform.affine_identity()
    m = context.mapping_new(0.0, 0.0, 100.0, 100.0, 100.0, 100.0, 1.0, 0.0, 0.0, id)
    return context.new_context(m)
}

main() {
    println("=== test_vg_anim ===")

    ctx = mk_ctx()
    bk = record.backend_new()
    scene = vg.scene_new(ctx, bk)
    vg.scene_set_deferred(scene, 1)
    root = vg.vg_root(scene)

    cnode = vg.circle(root, 50.0, 50.0, 20.0)
    cel = vg.node_element(cnode)
    vg.fill(cnode, "#ff0000")
    vg.vg_flush(scene)

    // A 1000ms opacity fade 0→1, linear (t passed straight to opacity). The
    // tick uses the `el` it is handed: animate types the tick as
    // fn(@keep ptr, float), so element_set_opacity (a keeper) accepts it.
    vg.animate(cnode, 1000, 0, 0) callback |el, t| {
        vg.element_set_opacity(el, t)
    }

    assert_eq_int("animating after register", vg.scene_is_animating(scene), 1)

    // t=0 → opacity 0.
    n0 = vg.scene_tick(scene, 0)
    assert_eq_int("tick @0: 1 anim ran", n0, 1)
    assert_near("opacity @0", element.element_last_opacity(cel), 0.0)

    // t=500ms (halfway) → opacity 0.5.
    _ = vg.scene_tick(scene, 500)
    assert_near("opacity @500", element.element_last_opacity(cel), 0.5)

    // t=1000ms (end) → opacity 1.0; animation completes + drops out.
    _ = vg.scene_tick(scene, 1000)
    assert_near("opacity @1000", element.element_last_opacity(cel), 1.0)
    assert_eq_int("not animating after complete", vg.scene_is_animating(scene), 0)

    // A further tick is a harmless no-op (nothing left to run).
    nn = vg.scene_tick(scene, 1500)
    assert_eq_int("tick after complete: 0 ran", nn, 0)

    // The same pattern with element_set_fill, on a second node, using `el`
    // inside the tick: the fill follows t (red at t=0, blue at t=1).
    rnode = vg.rect(root, 10.0, 10.0, 30.0, 30.0)
    rel = vg.node_element(rnode)
    vg.fill(rnode, "#ff0000")
    vg.vg_flush(scene)
    vg.animate(rnode, 1000, 0, 0) callback |el, t| {
        if t < 0.5 { vg.element_set_fill(el, "#00ff00") }
        else { vg.element_set_fill(el, "#0000ff") }
        vg.element_set_opacity(el, 1.0 - t)
    }
    _ = vg.scene_tick(scene, 250)
    assert_near("rect opacity @250 (el used in tick)", element.element_last_opacity(rel), 0.75)
    assert_eq_int("rect fill @250 is green", same_str(element.element_last_fill(rel), "#00ff00"), 1)
    _ = vg.scene_tick(scene, 750)
    assert_near("rect opacity @750", element.element_last_opacity(rel), 0.25)
    assert_eq_int("rect fill @750 is blue", same_str(element.element_last_fill(rel), "#0000ff"), 1)

    println("=== test_vg_anim passed ===")
}
