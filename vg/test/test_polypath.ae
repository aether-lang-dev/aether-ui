// vg/test/test_polypath.ae — the flattened-path toolkit: build / accessors /
// clone / transform (affine + projective) / bounds / simplify / smooth /
// to_path / stroke (joins, caps incl. arrow, miter limit, closed annulus),
// plus the text bridge (text_polypath serialises byte-identically
// to text_paths).
//
// Headless (no backend at all — polypath is pure geometry; the text bridge
// uses the recording-free text_paths path). Run from the repo root:
//   aetherc --lib . vg/test/test_polypath.ae /tmp/t.c && gcc /tmp/t.c \
//     vg/test/text_metrics_stub.c $(ae cflags) -o /tmp/t && /tmp/t

import std.string
import std.floatarr
import vg
import vg.geom.polypath
import vg.geom.transform

extern exit(code: int)
extern string_substring(s: string, start: int, end: int) -> string

assert_true(label: string, got: int) {
    if got == 1 { println("  PASS: ${label}") }
    else { println("  FAIL: ${label}"); exit(1) }
}
assert_eq_int(label: string, got: int, want: int) {
    if got == want { println("  PASS: ${label} (${got})") }
    else { println("  FAIL: ${label}: got ${got} want ${want}"); exit(1) }
}
assert_eq_str(label: string, got: string, want: string) {
    if string.equals(got, want) == 1 { println("  PASS: ${label} ('${got}')") }
    else { println("  FAIL: ${label}: got '${got}' want '${want}'"); exit(1) }
}
assert_near(label: string, got: float, want: float, eps: float) {
    d = got - want
    if d < 0.0 { d = 0.0 - d }
    if d < eps { println("  PASS: ${label} (${got})") }
    else { println("  FAIL: ${label}: got ${got} want ${want}"); exit(1) }
}

// A unit square as a closed contour.
mk_square() -> ptr {
    pp = polypath.pp_new()
    polypath.pp_begin(pp, 1)
    polypath.pp_push(pp, 0.0, 0.0)
    polypath.pp_push(pp, 10.0, 0.0)
    polypath.pp_push(pp, 10.0, 10.0)
    polypath.pp_push(pp, 0.0, 10.0)
    return pp
}

main() {
    println("=== test_polypath ===")

    println("-- build + accessors")
    sq = mk_square()
    assert_eq_int("npts", polypath.pp_npts(sq), 4)
    assert_eq_int("nctrs", polypath.pp_nctrs(sq), 1)
    assert_eq_int("ctr_end", polypath.pp_ctr_end(sq, 0), 3)
    assert_eq_int("ctr_closed", polypath.pp_ctr_closed(sq, 0), 1)
    assert_near("x(2)", polypath.pp_x(sq, 2), 10.0, 0.001)
    assert_near("y(2)", polypath.pp_y(sq, 2), 10.0, 0.001)

    println("-- growth past initial capacity")
    big = polypath.pp_new()
    polypath.pp_begin(big, 0)
    i = 0
    while i < 100 {
        polypath.pp_push(big, i * 1.0, i * 2.0)
        i = i + 1
    }
    assert_eq_int("100 points survive doubling", polypath.pp_npts(big), 100)
    assert_near("point 99 intact after growth", polypath.pp_y(big, 99), 198.0, 0.001)

    println("-- to_path")
    assert_eq_str("square serialises",
        polypath.pp_to_path(sq),
        "M 0.0 0.0 L 10.0 0.0 L 10.0 10.0 L 0.0 10.0 Z ")
    open_pp = polypath.pp_new()
    polypath.pp_begin(open_pp, 0)
    polypath.pp_push(open_pp, 1.0, 2.0)
    polypath.pp_push(open_pp, 3.0, 4.0)
    assert_eq_str("open contour has no Z",
        polypath.pp_to_path(open_pp), "M 1.0 2.0 L 3.0 4.0")

    println("-- clone independence")
    cp = polypath.pp_clone(sq)
    polypath.pp_set(cp, 0, 99.0, 99.0)
    assert_near("original untouched by clone edit", polypath.pp_x(sq, 0), 0.0, 0.001)
    assert_near("clone edited", polypath.pp_x(cp, 0), 99.0, 0.001)

    println("-- transform (affine)")
    moved = polypath.pp_clone(sq)
    m = transform.affine_translate(5.0, 7.0)
    polypath.pp_transform(moved, m as ptr)
    assert_near("translate x", polypath.pp_x(moved, 0), 5.0, 0.001)
    assert_near("translate y", polypath.pp_y(moved, 0), 7.0, 0.001)
    r = polypath.pp_clone(sq)
    polypath.pp_transform(r, transform.affine_rotate(90.0) as ptr)
    // (10,0) rotates to (0,10)
    assert_near("rotate90 x", polypath.pp_x(r, 1), 0.0, 0.01)
    assert_near("rotate90 y", polypath.pp_y(r, 1), 10.0, 0.01)

    println("-- transform (projective)")
    pj = polypath.pp_clone(sq)
    pm = transform.proj_identity()
    polypath.pp_transform_proj(pj, pm as ptr)
    assert_near("proj identity keeps x", polypath.pp_x(pj, 2), 10.0, 0.001)
    assert_near("proj identity keeps y", polypath.pp_y(pj, 2), 10.0, 0.001)

    println("-- bounds")
    b4 = floatarr_new_raw(4)
    assert_eq_int("bounds ok", polypath.pp_bounds(sq, b4), 1)
    assert_near("minx", floatarr_get_raw(b4, 0), 0.0, 0.001)
    assert_near("maxy", floatarr_get_raw(b4, 3), 10.0, 0.001)
    empty = polypath.pp_new()
    assert_eq_int("empty path has no bounds", polypath.pp_bounds(empty, b4), 0)

    println("-- simplify")
    // A square drawn with redundant edge midpoints: 8 points → 4 corners.
    mid = polypath.pp_new()
    polypath.pp_begin(mid, 1)
    polypath.pp_push(mid, 0.0, 0.0)
    polypath.pp_push(mid, 5.0, 0.0)
    polypath.pp_push(mid, 10.0, 0.0)
    polypath.pp_push(mid, 10.0, 5.0)
    polypath.pp_push(mid, 10.0, 10.0)
    polypath.pp_push(mid, 5.0, 10.0)
    polypath.pp_push(mid, 0.0, 10.0)
    polypath.pp_push(mid, 0.0, 5.0)
    simp = polypath.pp_simplify(mid, 0.5)
    assert_eq_int("collinear midpoints dropped", polypath.pp_npts(simp), 4)
    assert_eq_int("still closed", polypath.pp_ctr_closed(simp, 0), 1)
    // Exactly-collinear points are redundant at ANY tolerance — RDP drops
    // them even at 0.0; genuine geometry survives 0.0 (see zigzag below).
    keep = polypath.pp_simplify(mid, 0.0)
    assert_eq_int("collinear redundant even at tol 0", polypath.pp_npts(keep), 4)

    // An open zigzag whose middle point genuinely deviates survives.
    zig = polypath.pp_new()
    polypath.pp_begin(zig, 0)
    polypath.pp_push(zig, 0.0, 0.0)
    polypath.pp_push(zig, 5.0, 4.0)
    polypath.pp_push(zig, 10.0, 0.0)
    zs = polypath.pp_simplify(zig, 1.0)
    assert_eq_int("real deviation survives", polypath.pp_npts(zs), 3)

    println("-- smooth (corner cutting)")
    sm = polypath.pp_smooth(sq, 1)
    assert_eq_int("closed: one pass doubles points", polypath.pp_npts(sm), 8)
    assert_eq_int("smooth keeps closure", polypath.pp_ctr_closed(sm, 0), 1)
    // Corner cutting replaces each corner with two points at 1/4 and 3/4
    // along its segments: the first output point of the square is the Q of
    // edge (0,0)->(10,0), i.e. (2.5, 0) — the sharp (0,0) corner is gone.
    // Edge INTERIORS stay on the original edges, so bounds are unchanged.
    assert_near("first cut point x", polypath.pp_x(sm, 0), 2.5, 0.001)
    assert_near("first cut point y", polypath.pp_y(sm, 0), 0.0, 0.001)
    sb = floatarr_new_raw(4)
    _ = polypath.pp_bounds(sm, sb)
    assert_near("edges (not corners) still touch bounds", floatarr_get_raw(sb, 0), 0.0, 0.001)
    osm = polypath.pp_smooth(zig, 1)
    assert_near("open: first endpoint preserved", polypath.pp_x(osm, 0), 0.0, 0.001)
    lastp = polypath.pp_npts(osm) - 1
    assert_near("open: last endpoint preserved",
        polypath.pp_x(osm, lastp), 10.0, 0.001)

    println("-- text bridge")
    assert_true("use_font(vendored) loads", vg.use_font("fonts/DejaVuSans-Bold.ttf"))
    tp = vg.text_polypath("Hi", 10.0, 60.0, 40.0)
    assert_true("glyph contours arrive", polypath.pp_nctrs(tp) >= 2)
    assert_true("glyph points arrive", polypath.pp_npts(tp) >= 16)
    // The keystone: serialising the polypath IS text_paths' output —
    // one geometry pipeline, byte-identical.
    ppd = polypath.pp_to_path(tp)
    tpd = vg.text_paths("Hi", 10.0, 60.0, 40.0)
    assert_eq_str("serialisation prefix matches",
        string_substring(ppd, 0, 40), string_substring(tpd, 0, 40))
    assert_true("FULL d-string byte-identical", string.equals(ppd, tpd))


    println("-- stroke: single segment, caps")
    seg = polypath.pp_new()
    polypath.pp_begin(seg, 0)
    polypath.pp_push(seg, 0.0, 0.0)
    polypath.pp_push(seg, 10.0, 0.0)
    butt = polypath.pp_stroke(seg, 4.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_BUTT, 4.0)
    assert_eq_int("butt: one closed ring", polypath.pp_nctrs(butt), 1)
    assert_eq_int("butt ring is closed", polypath.pp_ctr_closed(butt, 0), 1)
    assert_eq_int("butt: 4 outline points", polypath.pp_npts(butt), 4)
    bb = floatarr_new_raw(4)
    _ = polypath.pp_bounds(butt, bb)
    assert_near("butt minx flush with end", floatarr_get_raw(bb, 0), 0.0, 0.001)
    assert_near("butt maxx flush with end", floatarr_get_raw(bb, 2), 10.0, 0.001)
    assert_near("butt half-width below", floatarr_get_raw(bb, 1), 0.0 - 2.0, 0.001)
    assert_near("butt half-width above", floatarr_get_raw(bb, 3), 2.0, 0.001)
    sqc = polypath.pp_stroke(seg, 4.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_SQUARE, 4.0)
    assert_eq_int("square: +2 points per cap", polypath.pp_npts(sqc), 8)
    _ = polypath.pp_bounds(sqc, bb)
    assert_near("square cap extends by h", floatarr_get_raw(bb, 2), 12.0, 0.001)
    assert_near("square cap extends start too", floatarr_get_raw(bb, 0), 0.0 - 2.0, 0.001)
    arr = polypath.pp_stroke(seg, 4.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_ARROW, 4.0)
    assert_eq_int("arrow: +3 points per cap", polypath.pp_npts(arr), 10)
    _ = polypath.pp_bounds(arr, bb)
    assert_near("arrow tip protrudes 2x width", floatarr_get_raw(bb, 2), 18.0, 0.001)
    assert_near("arrow barbs 3x half-width", floatarr_get_raw(bb, 3), 6.0, 0.001)
    rnd = polypath.pp_stroke(seg, 4.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_ROUND, 4.0)
    assert_true("round cap adds arc points", polypath.pp_npts(rnd) > 8)
    _ = polypath.pp_bounds(rnd, bb)
    assert_true("round cap stays within h of the end", floatarr_get_raw(bb, 2) <= 12.001)

    println("-- stroke: joins on an L")
    ell = polypath.pp_new()
    polypath.pp_begin(ell, 0)
    polypath.pp_push(ell, 0.0, 0.0)
    polypath.pp_push(ell, 10.0, 0.0)
    polypath.pp_push(ell, 10.0, 10.0)
    bev = polypath.pp_stroke(ell, 2.0, polypath.PP_JOIN_BEVEL, polypath.PP_CAP_BUTT, 4.0)
    mit = polypath.pp_stroke(ell, 2.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_BUTT, 4.0)
    rj  = polypath.pp_stroke(ell, 2.0, polypath.PP_JOIN_ROUND, polypath.PP_CAP_BUTT, 4.0)
    assert_eq_int("bevel outline points", polypath.pp_npts(bev), 8)
    assert_eq_int("miter adds exactly the tip", polypath.pp_npts(mit), 9)
    assert_true("round join adds arc points", polypath.pp_npts(rj) > polypath.pp_npts(mit))
    _ = polypath.pp_bounds(mit, bb)
    assert_near("miter tip reaches the outer corner x", floatarr_get_raw(bb, 2), 11.0, 0.001)
    assert_near("miter tip reaches the outer corner y", floatarr_get_raw(bb, 1), 0.0 - 1.0, 0.001)

    println("-- stroke: miter limit falls back to bevel")
    vee = polypath.pp_new()
    polypath.pp_begin(vee, 0)
    polypath.pp_push(vee, 0.0, 0.0)
    polypath.pp_push(vee, 10.0, 1.0)
    polypath.pp_push(vee, 0.0, 2.0)
    sharp = polypath.pp_stroke(vee, 2.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_BUTT, 4.0)
    blunt = polypath.pp_stroke(vee, 2.0, polypath.PP_JOIN_BEVEL, polypath.PP_CAP_BUTT, 4.0)
    assert_eq_int("near-180 turn: miter clamped to bevel",
        polypath.pp_npts(sharp), polypath.pp_npts(blunt))

    println("-- stroke: closed contour is an annulus")
    ring = polypath.pp_stroke(sq, 2.0, polypath.PP_JOIN_MITER, polypath.PP_CAP_BUTT, 4.0)
    assert_eq_int("two rings", polypath.pp_nctrs(ring), 2)
    assert_eq_int("outer ring closed", polypath.pp_ctr_closed(ring, 0), 1)
    assert_eq_int("inner ring closed", polypath.pp_ctr_closed(ring, 1), 1)
    _ = polypath.pp_bounds(ring, bb)
    assert_near("outline grows by h (minx)", floatarr_get_raw(bb, 0), 0.0 - 1.0, 0.001)
    assert_near("outline grows by h (maxx)", floatarr_get_raw(bb, 2), 11.0, 0.001)


    println("-- contains (nonzero winding)")
    assert_eq_int("centre inside square", polypath.pp_contains(sq, 5.0, 5.0), 1)
    assert_eq_int("outside square", polypath.pp_contains(sq, 15.0, 5.0), 0)
    assert_eq_int("above square", polypath.pp_contains(sq, 5.0, 0.0 - 3.0), 0)
    // The stroked square is an annulus: ON the band = inside; in the HOLE
    // the outer ring counts +1 and the reversed inner ring -1 -> outside.
    // This doubles as proof the stroker's two rings wind oppositely.
    assert_eq_int("on the stroke band", polypath.pp_contains(ring, 5.0, 0.0), 1)
    assert_eq_int("in the annulus hole", polypath.pp_contains(ring, 5.0, 5.0), 0)
    assert_eq_int("outside the annulus", polypath.pp_contains(ring, 15.0, 15.0), 0)

    println("ALL PASS")
}
