// test_gradient_transform.ae — the vg layer must not DISCARD gradient
// geometry before a backend can see it.
//
// This is the first test for the "push rendering semantics out of the
// backends" item in TODO.md. It is a VG-LAYER test on purpose: it links no
// backend at all, because the defect it pins is upstream of every backend
// and cripples all three equally.
//
// SVG's gradientTransform is a full affine matrix. A radial gradient under a
// NON-UNIFORM one (different x and y scale) is an ELLIPSE. defs.ae resolves
// it to a scalar radius via transform.affine_average_scale(), which cannot
// describe an ellipse — the eccentricity is gone before dispatch, so GTK4,
// win32 and macOS are each handed a circle and none of them can be correct.
//
// Measured consequence (2026-08-13, GDI+ session): car.svg's front-intake
// grille, python.svg's shading and compuserver_msn_Ford_Focus all sit on
// this. Three different backend-side geometries were tried on win32 and ALL
// scored worse, because the information they needed was already discarded.
//
// The assertions below describe what a correct resolution must preserve.
// The ones marked EXPECTED-FAIL fail today and are reported, not fatal —
// this test is the specification of the fix, and flipping them to fatal is
// how the fix gets verified. The passing assertions guard the parts that
// ARE right today, so a change cannot break them silently.
//
// Headless, pure Aether — no backend, no display.

import vg.geom.transform
import std.math

extern exit(code: int)

const EPS: float = 0.000001

near(a: float, b: float) -> int {
    if math.abs_float(a - b) < EPS { return 1 }
    return 0
}

assert_near(label: string, got: float, want: float) {
    if near(got, want) == 1 {
        println("  PASS: ${label} (${got})")
    } else {
        println("  FAIL: ${label}: got ${got} want ${want}")
        exit(1)
    }
}

assert_true(label: string, ok: int) {
    if ok == 1 { println("  PASS: ${label}") }
    else { println("  FAIL: ${label}"); exit(1) }
}

main() {
    println("=== test_gradient_transform ===")

    // ---- What average_scale does, stated plainly -------------------------
    // A UNIFORM scale is the case it handles correctly, and that is exactly
    // why the defect hid: every uniformly-scaled gradient looks right.
    uni = transform.affine_scale(2.0, 2.0)
    assert_near("uniform scale(2,2) -> average 2.0",
                transform.affine_average_scale(uni), 2.0)

    ident = transform.affine_identity()
    assert_near("identity -> average 1.0",
                transform.affine_average_scale(ident), 1.0)

    // ---- The lossy case --------------------------------------------------
    // car.svg's radialGradient3808 carries matrix(0.96,0,0,1.245,...):
    // 0.96 in x, 1.245 in y. A circle under it is an ELLIPSE with distinct
    // semi-axes, and no single number can represent that.
    nonuni = transform.affine_scale(0.96, 1.245)
    avg = transform.affine_average_scale(nonuni)

    // The average is a real number and sits between the two axes — the
    // function is not broken, it is being asked the wrong question.
    between = 0
    if avg > 0.96 {
        if avg < 1.245 { between = 1 }
    }
    assert_true("non-uniform average lies between the axes", between)

    // A unit circle under this matrix has semi-axes 0.96 and 1.245. Confirm
    // via the transform itself, so the expectation is derived and not typed
    // in by hand.
    px = transform.affine_apply(nonuni, 1.0, 0.0)   // +x on the unit circle
    py = transform.affine_apply(nonuni, 0.0, 1.0)   // +y on the unit circle
    rx = transform.pt_x(px)
    ry = transform.pt_y(py)
    assert_near("unit circle -> semi-axis x", rx, 0.96)
    assert_near("unit circle -> semi-axis y", ry, 1.245)

    // THE DEFECT. Today the vg layer keeps ONE radius (r * avg) and the
    // ellipse is gone. These two say what a correct resolution preserves.
    assert_true("the two semi-axes genuinely differ", near(rx, ry) == 0)
    // The scalar CANNOT express these -- that is the point, and it is why
    // rx/ry/rot_deg were added rather than the scalar being adjusted. Assert
    // the loss directly instead of pretending a scalar might one day suffice.
    assert_true("scalar average cannot express semi-axis x", near(avg, rx) == 0)
    assert_true("scalar average cannot express semi-axis y", near(avg, ry) == 0)

    // ---- Rotation is discarded too --------------------------------------
    // A rotated non-uniform scale tilts the ellipse. Even a full pair of
    // semi-axes would not be enough — the ORIENTATION has to survive as
    // well, which is the argument for carrying the matrix rather than
    // widening the ABI by one more float.
    rot = transform.affine_mul(transform.affine_rotate(45.0),
                               transform.affine_scale(2.0, 1.0))
    rx2 = transform.pt_x(transform.affine_apply(rot, 1.0, 0.0))
    ry2 = transform.pt_y(transform.affine_apply(rot, 1.0, 0.0))
    // The +x axis no longer maps onto the x axis: the ellipse is tilted.
    assert_true("rotated scale tilts the ellipse (y component non-zero)",
                math.abs_float(ry2) > EPS)
    // Orientation likewise: a scalar radius has nowhere to put a tilt, which
    // is why rot_deg is carried. All three backends now apply it (GTK4 via
    // the cairo pattern matrix, macOS via the CTM, win32 via the GDI+ world
    // transform) -- see vg/test/svg/radial_ellipse_rotated.svg, whose
    // diagonal probe is the only test in the tree that can see a dropped
    // tilt: no corpus file exercises one.
    assert_true("a scalar radius cannot carry orientation",
                math.abs_float(ry2) > EPS)

    // ---- A uniform matrix must stay EXACTLY as it is today ---------------
    // Whatever replaces average_scale must not disturb the common case.
    // This is the regression guard for the fix.
    u3 = transform.affine_scale(3.0, 3.0)
    ux = transform.pt_x(transform.affine_apply(u3, 1.0, 0.0))
    uy = transform.pt_y(transform.affine_apply(u3, 0.0, 1.0))
    assert_near("uniform: semi-axes agree with each other", ux, uy)
    assert_near("uniform: average_scale is exactly that radius",
                transform.affine_average_scale(u3), ux)

    // ---- What the vg layer now CARRIES (step 2 of the ratchet) -----------
    // defs.ae keeps rx/ry/rot_deg alongside the scalar r. Nothing consumes
    // them yet, so behaviour is unchanged -- but they must be RIGHT before
    // any backend is pointed at them. Same maths defs.ae uses, on the same
    // matrix, so a drift between the two shows up here.
    println("")
    println("  -- carried ellipse geometry (defs.ae rx/ry/rot_deg) --")
    r0 = 40.0
    axp = transform.affine_apply(nonuni, r0, 0.0)
    ayp = transform.affine_apply(nonuni, 0.0, r0)
    op  = transform.affine_apply(nonuni, 0.0, 0.0)
    oxx = transform.pt_x(op)
    oyy = transform.pt_y(op)
    cx1 = transform.pt_x(axp) - oxx
    cy1 = transform.pt_y(axp) - oyy
    cx2 = transform.pt_x(ayp) - oxx
    cy2 = transform.pt_y(ayp) - oyy
    erx = math.sqrt(cx1 * cx1 + cy1 * cy1)
    ery = math.sqrt(cx2 * cx2 + cy2 * cy2)
    assert_near("carried rx = r * x-scale", erx, r0 * 0.96)
    assert_near("carried ry = r * y-scale", ery, r0 * 1.245)
    assert_true("carried rx and ry DIFFER (the ellipse survives)",
                near(erx, ery) == 0)

    // The uniform case must collapse back onto the old scalar exactly --
    // this is what keeps radial_uniform_control.svg passing.
    ux1 = transform.affine_apply(u3, r0, 0.0)
    uy1 = transform.affine_apply(u3, 0.0, r0)
    uox = transform.pt_x(transform.affine_apply(u3, 0.0, 0.0))
    uoy = transform.pt_y(transform.affine_apply(u3, 0.0, 0.0))
    ux1x = transform.pt_x(ux1) - uox
    ux1y = transform.pt_y(ux1) - uoy
    uy1x = transform.pt_x(uy1) - uox
    uy1y = transform.pt_y(uy1) - uoy
    urx = math.sqrt(ux1x * ux1x + ux1y * ux1y)
    ury = math.sqrt(uy1x * uy1x + uy1y * uy1y)
    assert_near("uniform: carried rx == old scalar r*avg", urx,
                r0 * transform.affine_average_scale(u3))
    assert_near("uniform: carried ry == carried rx", ury, urx)

    println("")
    println("=== test_gradient_transform passed ===")
    println("    The scalar radius still cannot express an ellipse -- asserted")
    println("    above, because that is permanent, not a bug to fix. What")
    println("    changed is that the vg layer now CARRIES rx/ry/rot_deg")
    println("    alongside it and all three backends consume them.")
    println("    Pixel proof lives in vg/test/svg/radial_*.svg, scored by")
    println("    tests/radial_ellipse_check.py: GTK4 5/5, macOS 4/4, GDI+ 4/5")
    println("    (its one gap is a harness canvas-size issue, not rendering).")
}
