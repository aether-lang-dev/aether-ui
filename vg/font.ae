// vg/font.ae — glyph OUTLINES and text metrics for vector text.
//
// Reads a .ttf (or .ttc) through Aether's std.truetype and turns text into
// flattened vector contours — no FreeType, no platform text API, no offline
// generator: the same bytes parse identically on every backend. This is the
// "text is just paths" primitive: once a word is an Outl, it can be
// transformed, projected onto a 3D face (apps/tumbling_cube), stroked,
// morphed — anything a path can do.
//
// std.truetype owns the file format: every read is bounds-checked (a
// truncated or malformed font fails to load, with font_last_error() saying
// why), cmap formats 4 and 12 (so codepoints beyond the BMP map), `hmtx`
// advances, `kern` format 0 pair kerning, the face's own name / fixed-pitch /
// serif declarations, simple and compound glyph points, `.ttc` collections
// (first font). It does NOT read CFF/OTF outlines or GPOS kerning.
//
// What stays here is what aether-ui draws on top of it:
//   * UTF-8 text runs (font_text_outlines decodes multi-byte sequences),
//     laid out with pair kerning (font_text_outlines / font_text_width).
//   * Flattening: the font's quadratic contours follow the TrueType
//     on/off-curve convention — runs of off-curve control points imply
//     on-curve midpoints between them; a contour with NO on-curve point
//     starts at the midpoint of its first two controls. Curves are flattened
//     to `steps` line segments each — at UI sizes the polyline is
//     indistinguishable from the true curve.
//   * The Outl: contours-as-flat-buffers, interleaved x,y points plus
//     contour end indices (both floatarr), counters kept as separate
//     contours whose winding the renderer's nonzero fill rule resolves
//     (that's how the holes in A/e survive).

exports (
    font_load, font_ok, font_last_error, font_upem, font_nglyphs, font_ascender, font_descender, font_name,
    font_is_monospace, font_is_serif,
    font_glyph_index, font_glyph_advance, font_kern, font_text_width,
    font_glyph_outlines, font_text_outlines, font_text_outlines_norm,
    outl_ok, outl_npts, outl_nctrs, outl_px, outl_py, outl_ctr_end,
    outl_adv, outl_free
)

import std.truetype
import std.string
import std.floatarr
import std.math

extern malloc(size: int) -> ptr
extern free(p: ptr)
extern string_char_at_n(s: string, known_length: int, index: int) -> int
extern lrint(x: float) -> long

// ─── The font: a std.truetype Typeface behind an opaque handle ───────────────
// font_load returns null when the file cannot be read as a TrueType font
// (font_last_error() says why). Every accessor tolerates a null handle, so a
// caller may go straight from font_load to font_ok.
face_of(fp: @into ptr) -> *truetype.Typeface { return fp as *truetype.Typeface }

font_load(path: string) -> ptr {
    return truetype.load(path) as ptr
}

font_ok(fp: ptr) -> int {
    if fp == null { return 0 }
    return 1
}

// What the last failed font_load found wrong.
font_last_error() -> string { return truetype.last_error() }

// Is this a MONOSPACED face? From `post`.isFixedPitch — the font's own
// declaration, so it works for Consolas and Courier New alike, where
// guessing from the NAME does not.
font_is_monospace(fp: ptr) -> int {
    if fp == null { return 0 }
    if truetype.is_monospace(face_of(fp)) { return 1 }
    return 0
}

// Is this a SERIF face? From OS/2 PANOSE, again the font's own declaration,
// so "Times New Roman" and "Georgia" classify correctly without name guessing.
font_is_serif(fp: ptr) -> int {
    if fp == null { return 0 }
    if truetype.is_serif(face_of(fp)) { return 1 }
    return 0
}

// The face's FULL NAME ("DejaVu Sans Bold") from the `name` table: Mac
// English, else Windows English, else any. "" if absent.
font_name(fp: ptr) -> string {
    if fp == null { return "" }
    return truetype.full_name(face_of(fp))
}

font_upem(fp: ptr) -> int {
    if fp == null { return 0 }
    f = face_of(fp)
    return f.units_per_em
}
// The face's own line metrics, from `hhea`, in font units: how far its
// letters rise above the baseline, and how far they fall below it (a
// positive depth, though the table holds it negative). A toolkit sizes a
// line of text by their sum.
font_ascender(fp: ptr) -> int {
    if fp == null { return 0 }
    f = face_of(fp)
    return f.ascender
}
font_descender(fp: ptr) -> int {
    if fp == null { return 0 }
    f = face_of(fp)
    return 0 - f.descender
}
font_nglyphs(fp: ptr) -> int {
    if fp == null { return 0 }
    f = face_of(fp)
    return f.glyph_count
}

// Codepoint → glyph id (0 = missing glyph).
font_glyph_index(fp: ptr, cp: int) -> int {
    if fp == null { return 0 }
    return truetype.glyph_index(face_of(fp), cp)
}

// hmtx advance width (font units).
font_glyph_advance(fp: ptr, gid: int) -> int {
    if fp == null { return 0 }
    return truetype.advance(face_of(fp), gid)
}

// Pair kern (font units, usually negative) between two GLYPH IDs.
font_kern(fp: ptr, gl: int, gr: int) -> int {
    if fp == null { return 0 }
    return truetype.kerning(face_of(fp), gl, gr)
}

// ─── UTF-8: decode the codepoint at byte i; returns (cp, next_i) ─────────────
// Malformed sequences yield U+FFFD and advance one byte (never stalls).
utf8_at(text: string, n: int, i: int) -> (int, int) {
    b0 = string_char_at_n(text, n, i)
    if b0 < 0 { b0 = b0 + 256 }
    if b0 < 128 { return b0, i + 1 }
    if b0 >= 192 && b0 < 224 && i + 1 < n {
        b1 = cont(text, n, i + 1)
        if b1 >= 0 { return (b0 - 192) * 64 + b1, i + 2 }
    }
    if b0 >= 224 && b0 < 240 && i + 2 < n {
        b1 = cont(text, n, i + 1)
        b2 = cont(text, n, i + 2)
        if b1 >= 0 && b2 >= 0 { return ((b0 - 224) * 64 + b1) * 64 + b2, i + 3 }
    }
    if b0 >= 240 && i + 3 < n {
        b1 = cont(text, n, i + 1)
        b2 = cont(text, n, i + 2)
        b3 = cont(text, n, i + 3)
        if b1 >= 0 && b2 >= 0 && b3 >= 0 {
            return (((b0 - 240) * 64 + b1) * 64 + b2) * 64 + b3, i + 4
        }
    }
    return 65533, i + 1
}
// Continuation byte value (0..63), or -1 if not a continuation byte.
cont(text: string, n: int, i: int) -> int {
    b = string_char_at_n(text, n, i)
    if b < 0 { b = b + 256 }
    if b >= 128 && b < 192 { return b - 128 }
    return -1
}
// Advance width of a UTF-8 run in FONT UNITS, kerning applied.
font_text_width(fp: ptr, text: string) -> float {
    if fp == null { return 0.0 }
    n = string.length(text)
    penx = 0.0
    prev = -1
    i = 0
    while i < n {
        cp, ni = utf8_at(text, n, i)
        i = ni
        gid = font_glyph_index(fp, cp)
        if prev >= 0 { penx = penx + font_kern(fp, prev, gid) * 1.0 }
        penx = penx + font_glyph_advance(fp, gid) * 1.0
        prev = gid
    }
    return penx
}

// ─── Outl: flattened contours as flat buffers ────────────────────────────────
struct Outl {
    pts: ptr          // floatarr, interleaved x,y
    npts: int
    cends: ptr        // floatarr, end POINT INDEX of each contour
    nctrs: int
    adv: float        // total advance of the run (font units, pre-normalize)
    cap: int          // pts capacity (floats)
    ecap: int
    ok: int
}
mk_outl() -> *Outl {
    o = malloc(sizeof(Outl)) as *Outl
    o.cap = 65536
    o.ecap = 1024
    pts, _pe = floatarr.new(o.cap)
    cends, _ce = floatarr.new(o.ecap)
    o.pts = pts
    o.cends = cends
    o.npts = 0; o.nctrs = 0; o.adv = 0.0; o.ok = 1
    return o
}
outl_ok(op: ptr) -> int { o = op as *Outl; return o.ok }
outl_npts(op: ptr) -> int { o = op as *Outl; return o.npts }
outl_nctrs(op: ptr) -> int { o = op as *Outl; return o.nctrs }
outl_px(op: ptr, i: int) -> float {
    o = op as *Outl
    return floatarr.get_unchecked(o.pts, i * 2)
}
outl_py(op: ptr, i: int) -> float {
    o = op as *Outl
    return floatarr.get_unchecked(o.pts, i * 2 + 1)
}
outl_ctr_end(op: ptr, c: int) -> int {
    o = op as *Outl
    return lrint(floatarr.get_unchecked(o.cends, c)) as int
}
outl_adv(op: ptr) -> float { o = op as *Outl; return o.adv }
outl_free(op: ptr) {
    o = op as *Outl
    floatarr.free(o.pts)
    floatarr.free(o.cends)
    free(op)
}
// Append a point, shifted along x by the pen position `tx`.
opush(o: *Outl, tx: float, x: float, y: float) {
    if o.npts * 2 + 1 >= o.cap { o.ok = 0; return }
    floatarr.set_unchecked(o.pts, o.npts * 2, x + tx)
    floatarr.set_unchecked(o.pts, o.npts * 2 + 1, y)
    o.npts = o.npts + 1
}
oclose(o: *Outl) {
    if o.npts == 0 { return }
    if o.nctrs >= o.ecap { o.ok = 0; return }
    floatarr.set_unchecked(o.cends, o.nctrs, (o.npts - 1) * 1.0)
    o.nctrs = o.nctrs + 1
}

// Flatten one quadratic (P0 → ctrl → P1) as `steps` line points.
oquad(o: *Outl, tx: float, x0: float, y0: float, cx: float, cy: float, x1: float, y1: float, steps: int) {
    i = 1
    while i <= steps {
        t = i * 1.0 / (steps * 1.0)
        mt = 1.0 - t
        qx = mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1
        qy = mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1
        opush(o, tx, qx, qy)
        i = i + 1
    }
}

// Point `k` (wrapping) of the contour that starts at point `s` and has `n` points.
cpx(p: *truetype.GlyphPoints, s: int, n: int, k: int) -> float {
    return truetype.point_x(p, s + (k % n))
}
cpy(p: *truetype.GlyphPoints, s: int, n: int, k: int) -> float {
    return truetype.point_y(p, s + (k % n))
}

// Walk contour points s..e as a closed quadratic spline: off-curve runs imply
// on-curve midpoints; a contour with no on-curve point starts at the midpoint
// of its first two controls.
emit_contour(p: *truetype.GlyphPoints, s: int, e: int, tx: float, steps: int, o: *Outl) {
    n = e - s + 1
    if n < 2 { return }
    fo = -1
    i = 0
    while i < n {
        if truetype.point_on(p, s + i) { fo = i; break }
        i = i + 1
    }
    // Start point.
    sx = 0.0
    sy = 0.0
    if fo >= 0 {
        sx = cpx(p, s, n, fo)
        sy = cpy(p, s, n, fo)
    } else {
        // All off-curve: start at the implied midpoint of controls 0 and 1.
        sx = (cpx(p, s, n, 0) + cpx(p, s, n, 1)) / 2.0
        sy = (cpy(p, s, n, 0) + cpy(p, s, n, 1)) / 2.0
        fo = 0
    }
    opush(o, tx, sx, sy)
    curx = sx
    cury = sy
    ctlx = 0.0
    ctly = 0.0
    pending = 0
    k = 1
    while k <= n {
        idx = fo + k
        px = cpx(p, s, n, idx)
        py = cpy(p, s, n, idx)
        on = truetype.point_on(p, s + (idx % n))
        if on {
            if pending == 1 {
                oquad(o, tx, curx, cury, ctlx, ctly, px, py, steps)
                pending = 0
            } else {
                // k == n is the start point again — Z closes, skip the dup.
                if k < n { opush(o, tx, px, py) }
            }
            curx = px
            cury = py
        } else {
            if pending == 1 {
                mx = (ctlx + px) / 2.0
                my = (ctly + py) / 2.0
                oquad(o, tx, curx, cury, ctlx, ctly, mx, my, steps)
                curx = mx
                cury = my
            }
            ctlx = px
            ctly = py
            pending = 1
        }
        k = k + 1
    }
    // Close back to the start point.
    if pending == 1 {
        oquad(o, tx, curx, cury, ctlx, ctly, sx, sy, steps)
    }
    oclose(o)
}

// One glyph's contours (compound glyphs arrive placed by std.truetype),
// flattened and appended with the pen at `tx`. A glyph the font cannot give
// contributes nothing.
glyph_outline(fp: ptr, gid: int, tx: float, steps: int, o: *Outl) {
    p = truetype.glyph_points(face_of(fp), gid)
    if p == null { return }
    s = 0
    ci = 0
    while ci < p.contours {
        e = truetype.contour_end(p, ci)
        emit_contour(p, s, e, tx, steps, o)
        s = e + 1
        ci = ci + 1
    }
    truetype.points_free(p)
}

// ─── Public outline builders ─────────────────────────────────────────────────
// One glyph (by id), untransformed font units, y-up.
font_glyph_outlines(fp: ptr, gid: int, steps: int) -> ptr {
    o = mk_outl()
    if fp == null { o.ok = 0; return o as ptr }
    glyph_outline(fp, gid, 0.0, steps, o)
    o.adv = font_glyph_advance(fp, gid) * 1.0
    return o as ptr
}

// A UTF-8 text run, glyphs advanced along x with pair kerning. Font units,
// y-up, pen origin at (0,0).
font_text_outlines(fp: ptr, text: string, steps: int) -> ptr {
    o = mk_outl()
    if fp == null { o.ok = 0; return o as ptr }
    penx = 0.0
    prev = -1
    n = string.length(text)
    i = 0
    while i < n {
        cp, ni = utf8_at(text, n, i)
        i = ni
        gid = font_glyph_index(fp, cp)
        if prev >= 0 { penx = penx + font_kern(fp, prev, gid) * 1.0 }
        glyph_outline(fp, gid, penx, steps, o)
        penx = penx + font_glyph_advance(fp, gid) * 1.0
        prev = gid
    }
    o.adv = penx
    return o as ptr
}

// Text run normalized for surface placement: bbox-centred on the origin,
// scaled to `target_w` wide, y FLIPPED to y-down (screen/face convention).
font_text_outlines_norm(fp: ptr, text: string, steps: int, target_w: float) -> ptr {
    op = font_text_outlines(fp, text, steps)
    o = op as *Outl
    if o.npts == 0 { return op }
    minx = outl_px(op, 0); maxx = minx
    miny = outl_py(op, 0); maxy = miny
    i = 1
    while i < o.npts {
        x = outl_px(op, i)
        y = outl_py(op, i)
        if x < minx { minx = x }
        if x > maxx { maxx = x }
        if y < miny { miny = y }
        if y > maxy { maxy = y }
        i = i + 1
    }
    w = maxx - minx
    if w <= 0.0 { return op }
    sc = target_w / w
    cx = (minx + maxx) / 2.0
    cy = (miny + maxy) / 2.0
    i = 0
    while i < o.npts {
        floatarr.set_unchecked(o.pts, i * 2, (outl_px(op, i) - cx) * sc)
        floatarr.set_unchecked(o.pts, i * 2 + 1, 0.0 - (outl_py(op, i) - cy) * sc)
        i = i + 1
    }
    return op
}

